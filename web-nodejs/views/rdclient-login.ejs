<%
    var themeMode = (branding && branding.themeMode) || 'system';
    var dataTheme = themeMode === 'light' || themeMode === 'system' ? 'light' : 'dark';
%>
<!DOCTYPE html>
<html lang="<%= lang || 'en' %>" dir="<%= typeof isRtl !== 'undefined' && isRtl ? 'rtl' : 'ltr' %>" data-theme="<%= dataTheme %>" data-theme-mode="<%= themeMode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= _('rdclient_login.title') %> - <%= appName %></title>

    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">
    <%- include('partials/theme-head') %>
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleNext-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/branding.css?v=<%= typeof brandingRevision !== 'undefined' ? brandingRevision : cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/tokens.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/base.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/components.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/rdclient-login.css?v=<%= cacheVersion %>">
</head>
<body class="rdclient-login-page">
    <main class="rdclient-login-main">
        <div class="rdclient-login-box" id="rdclient-login-card">
            <div class="rdclient-login-brand" id="rdclient-login-brand">
                <% if (branding.logoType === 'text' && branding.logoText) { %>
                <span class="brand-text-logo"><%= branding.logoText %><% if (branding.logoTextAccent) { %><span class="brand-text-accent"><%= branding.logoTextAccent %></span><% } %></span>
                <% } else if (branding.logoType === 'svg' && branding.logoSvg) { %>
                <span class="rdclient-logo-svg"><%- branding.logoSvg %></span>
                <span><%= appName %></span>
                <% } else if (branding.logoType === 'image' && branding.logoUrl) { %>
                <img src="<%= branding.logoUrl %>" alt="" class="rdclient-logo-img">
                <span><%= appName %></span>
                <% } else { %>
                <span><%= appName %></span>
                <% } %>
            </div>

            <h1 class="rdclient-login-title"><%= _('rdclient_login.title') %></h1>
            <p class="rdclient-login-subtitle"><%= _('rdclient_login.subtitle') %></p>

            <form class="rdclient-form" id="rdclient-login-form" novalidate>
                <div class="notice error hidden" id="rdclient-error" role="alert">
                    <span id="rdclient-error-text"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rdclient-username"><%= _('rdclient_login.username_placeholder') %></label>
                    <input type="text" id="rdclient-username" class="form-input"
                        autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rdclient-password"><%= _('rdclient_login.password_placeholder') %></label>
                    <div class="password-wrapper">
                        <input type="password" id="rdclient-password" class="form-input"
                            autocomplete="current-password" required>
                        <button type="button" class="password-toggle" id="rdclient-password-toggle"
                            aria-label="<%= _('auth.show_password') %>" title="<%= _('auth.show_password') %>" aria-pressed="false">
                            <span class="material-icons" aria-hidden="true">visibility</span>
                        </button>
                    </div>
                </div>

                <label class="checkbox-row rdclient-remember" for="rdclient-remember">
                    <input type="checkbox" id="rdclient-remember" checked>
                    <span><%= _('rdclient_login.remember_me') %></span>
                </label>

                <button type="submit" class="btn btn-primary btn-block rdclient-submit" id="rdclient-submit-btn"><%= _('rdclient_login.sign_in') %></button>
            </form>

            <!-- Two-factor step (shown when the password is accepted and the account uses an authenticator app) -->
            <form class="rdclient-form hidden" id="rdclient-totp-form" novalidate>
                <div class="rdclient-totp-head">
                    <h2><%= _('rdclient_login.totp_title') %></h2>
                    <p class="rdclient-login-subtitle"><%= _('rdclient_login.totp_subtitle') %></p>
                </div>

                <div class="notice error hidden" id="rdclient-totp-error" role="alert">
                    <span id="rdclient-totp-error-text"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rdclient-totp-code"><%= _('auth.totp_code') %></label>
                    <input type="text" id="rdclient-totp-code" class="form-input mono rdclient-totp-input"
                        autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required>
                </div>

                <button type="submit" class="btn btn-primary btn-block rdclient-submit" id="rdclient-totp-submit"><%= _('rdclient_login.verify') %></button>

                <p class="rdclient-totp-links">
                    <a href="#" id="rdclient-totp-back-link"><%= _('rdclient_login.back_to_login') %></a>
                </p>
            </form>

            <div class="rdclient-login-footer">
                <a href="/login" class="rdclient-login-console-link"><%= _('rdclient_login.open_console_login') %></a>
                <label class="rdclient-language-picker" for="rdclient-language-select">
                    <span><%= _('settings.language') %></span>
                    <select id="rdclient-language-select" class="form-select" data-language-select>
                        <% (availableLanguageList || []).forEach(function(language) { %>
                            <option value="<%= language.code %>" <%= lang === language.code ? 'selected' : '' %> lang="<%= language.code %>"><%= language.native || language.name || language.code %></option>
                        <% }); %>
                    </select>
                </label>
                <p class="rdclient-login-version"><%= appName %> <%= appVersion %></p>
            </div>
        </div>
    </main>

    <script nonce="<%= cspNonce %>">
        window.BetterDesk = {
            csrfToken: '<%= csrfToken || "" %>',
            lang: '<%= lang || "en" %>',
            translations: <%- JSON.stringify(translations || {}) %>,
            branding: <%- JSON.stringify(branding || {}) %>,
            returnUrl: <%- JSON.stringify(typeof returnUrl !== 'undefined' ? returnUrl : '/remote') %>,
            sessionExpired: <%= sessionExpired ? 'true' : 'false' %>,
            availableLanguages: <%- JSON.stringify(availableLanguageList || []) %>
        };
    </script>
    <script src="/js/i18n-client.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclientSecureStore.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient-login.js?v=<%= cacheVersion %>"></script>
</body>
</html>
