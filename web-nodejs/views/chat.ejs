<%- include('layouts/main', {
    title: typeof title !== 'undefined' ? title : _('nav.chat'),
    uiReworked: true,
    pageStyles: ['ui/chat'],
    pageScripts: typeof pageScripts !== 'undefined' ? pageScripts : ['chatCrypto', 'chat'],
    currentPage: typeof currentPage !== 'undefined' ? currentPage : 'chat',
    breadcrumb: typeof breadcrumb !== 'undefined' ? breadcrumb : [{ label: _('nav.chat') }],
    body: `
    <div class="page page-wide chat-page" id="chat-page">
        <div class="page-head">
            <h1>${_('nav.chat')}</h1>
            <p class="page-description">${_('chat.page_description')}</p>
            <div class="page-actions">
                <button type="button" class="btn" id="chat-search-toggle" aria-expanded="false" aria-controls="chat-search-bar">${_('chat.search_messages')}</button>
                <button type="button" class="btn" id="chat-new-group-btn">${_('chat.new_group')}</button>
            </div>
        </div>

        <p class="notice warning chat-connection" id="chat-connection" role="status" hidden>${_('chat.not_connected')}</p>

        <!-- Message search (opened with the Search messages button) -->
        <div class="chat-search" id="chat-search-bar" style="display:none">
            <div class="chat-search-bar">
                <div class="toolbar-search search-wrapper">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input type="search" class="form-input chat-search-input" id="chat-search-input"
                        aria-label="${_('chat.search_messages')}" placeholder="${_('chat.search_messages')}">
                </div>
                <button type="button" class="btn-icon chat-search-close" id="chat-search-close" aria-label="${_('chat.close_search')}">
                    <span class="material-icons" aria-hidden="true">close</span>
                </button>
            </div>
            <p class="form-hint">${_('chat.search_hint')}</p>
            <div class="chat-search-results" id="chat-search-results" style="display:none" aria-live="polite"></div>
        </div>

        <div class="split chat-split" id="chat-split">
            <!-- Conversations: people, devices and groups -->
            <div class="split-list chat-sidebar" id="chat-sidebar">
                <div class="tabs chat-tabs" role="tablist" aria-label="${_('nav.chat')}">
                    <button type="button" class="tab chat-tab active" role="tab" aria-selected="true" aria-controls="chat-contacts-panel" id="chat-tab-contacts" data-tab="contacts">${_('chat.contacts')}</button>
                    <button type="button" class="tab chat-tab" role="tab" aria-selected="false" aria-controls="chat-groups-panel" id="chat-tab-groups" data-tab="groups" tabindex="-1">${_('chat.groups')}</button>
                </div>

                <div class="chat-list-wrap">
                    <div id="chat-contacts-panel" role="tabpanel" aria-labelledby="chat-tab-contacts" data-tab-content="contacts">
                        <ul class="list chat-list" id="chat-contacts-list">
                            <li class="list-row is-empty chat-list-empty">${_('chat.loading_contacts')}</li>
                        </ul>
                    </div>
                    <div id="chat-groups-panel" role="tabpanel" aria-labelledby="chat-tab-groups" data-tab-content="groups" style="display:none">
                        <ul class="list chat-list" id="chat-groups-list">
                            <li class="list-row is-empty chat-list-empty">${_('chat.no_groups_hint')}</li>
                        </ul>
                    </div>
                </div>

                <!-- Own presence -->
                <div class="chat-presence-bar" id="chat-presence-bar">
                    <label class="chat-presence-label" for="chat-presence-select">${_('chat.my_presence')}</label>
                    <span class="chat-presence-dot" id="chat-my-presence-dot" aria-hidden="true"></span>
                    <select class="form-select chat-presence-select" id="chat-presence-select">
                        <option value="online">${_('chat.presence_online')}</option>
                        <option value="away">${_('chat.presence_away')}</option>
                        <option value="busy">${_('chat.presence_busy')}</option>
                    </select>
                    <span class="chat-username">${typeof user !== 'undefined' && user ? user.username : 'Operator'}</span>
                </div>
            </div>

            <!-- The open conversation -->
            <section class="split-detail chat-main" id="chat-main" aria-label="${_('chat.conversation')}">
                <p class="state chat-empty-state" id="chat-empty-state">${_('chat.pick_conversation')}</p>

                <div class="chat-conversation" id="chat-conversation" style="display:none">
                    <div class="chat-conv-header" id="chat-conv-header">
                        <button type="button" class="btn btn-sm chat-back-btn" id="chat-back-btn">${_('chat.all_conversations')}</button>
                        <div class="chat-conv-info">
                            <span class="chat-conv-avatar" id="chat-conv-avatar" hidden></span>
                            <h2 class="chat-conv-name" id="chat-conv-name"></h2>
                            <span class="chat-conv-status" id="chat-conv-status"></span>
                        </div>
                    </div>

                    <p class="notice chat-e2e-banner" id="chat-e2e-banner" style="display:none" role="status">
                        <span id="chat-e2e-text">${_('chat.e2e_establishing')}</span>
                    </p>

                    <div class="chat-messages" id="chat-messages" tabindex="0" aria-label="${_('chat.messages')}">
                        <div class="chat-messages-inner" id="chat-messages-inner" role="log" aria-live="polite"></div>
                    </div>

                    <p class="chat-typing" id="chat-typing" style="display:none" aria-live="polite">
                        <span class="chat-typing-text" id="chat-typing-text">${_('chat.typing_indicator')}</span>
                    </p>

                    <div class="chat-input-area" id="chat-input-area">
                        <div class="chat-file-preview" id="chat-file-preview" style="display:none">
                            <span class="chat-file-name" id="chat-file-name"></span>
                            <span class="chat-file-size" id="chat-file-size"></span>
                            <button type="button" class="btn-icon chat-file-remove" id="chat-file-remove" aria-label="${_('chat.remove_file')}">
                                <span class="material-icons" aria-hidden="true">close</span>
                            </button>
                        </div>
                        <label class="sr-only" for="chat-input">${_('chat.message_label')}</label>
                        <textarea class="form-input chat-input" id="chat-input" rows="2" maxlength="4096"
                            placeholder="${_('chat.message_placeholder')}"></textarea>
                        <div class="chat-input-row">
                            <button type="button" class="btn btn-sm" id="chat-attach-btn">${_('chat.attach_file')}</button>
                            <button type="button" class="btn btn-sm" id="chat-emoji-btn" aria-haspopup="true" aria-expanded="false">${_('chat.emoji')}</button>
                            <span class="form-status chat-send-status" id="chat-send-status" aria-live="polite"></span>
                            <button type="button" class="btn btn-primary chat-send-btn" id="chat-send-btn">${_('chat.send')}</button>
                        </div>
                        <input type="file" id="chat-file-input" class="sr-only" tabindex="-1" aria-hidden="true">
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- Emoji picker (for the message field and for reactions) -->
    <div class="menu chat-emoji-picker" id="chat-emoji-picker" style="display:none" role="menu" aria-label="${_('chat.emoji')}"></div>
` }) %>
