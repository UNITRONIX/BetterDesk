<%
// One tool: a disclosure with its title and one sentence, a one-column form and a result area.
const tool = (o) => `
            <details class="disclosure tool" id="tool-${o.id}"${o.requires ? ` data-requires="${o.requires}"` : ''}>
                <summary><span class="tool-summary"><h2 class="tool-title">${o.title}</h2><span class="tool-desc">${o.desc}</span></span></summary>
                <div class="tool-body">
                    <form class="tool-form" id="${o.id}-form" novalidate>
                        ${o.fields || ''}
                        <div class="tool-actions">
                            ${o.actions}
                            <span class="form-status" id="${o.id}-status" aria-live="polite"></span>
                        </div>
                    </form>
                    <div class="tool-result" id="${o.result}" aria-live="polite"></div>
                </div>
            </details>`;
const field = (id, label, input, hint) => `
                        <div class="form-group">
                            <label class="form-label" for="${id}">${label}</label>
                            ${input}
                            ${hint ? `<p class="form-hint">${hint}</p>` : ''}
                        </div>`;
const text = (id, attrs) => `<input type="text" id="${id}" class="form-input is-medium" autocapitalize="off" autocomplete="off" spellcheck="false" ${attrs || ''}>`;
const port = (id, value) => `<input type="number" id="${id}" class="form-input is-short" min="1" max="65535" inputmode="numeric" ${value ? `value="${value}"` : ''}>`;
const area = (id) => `<textarea id="${id}" class="form-input" rows="3" spellcheck="false"></textarea>`;
const run = (id, label) => `<button type="submit" class="btn" id="${id}">${label}</button>`;
%><%- include('layouts/main', {
    title: _('nav.toolkit'),
    uiReworked: true,
    pageStyles: ['ui/toolkit'],
    pageScripts: ['toolkit'],
    currentPage: 'toolkit',
    breadcrumb: [{ label: _('nav.toolkit') }],
    body: `
    <div class="page toolkit-page">
        <div class="page-head">
            <h1>${_('nav.toolkit')}</h1>
            <p class="page-description">${_('toolkit.page_description')}</p>
        </div>

        <div class="toolkit-groups">
            <div class="tabs" role="tablist" aria-label="${_('toolkit.groups_label')}">
                <button type="button" class="tab tab-btn active" role="tab" id="tab-btn-network" data-tab="network" aria-selected="true" aria-controls="tab-network">${_('toolkit.cat_network')}</button>
                <button type="button" class="tab tab-btn" role="tab" id="tab-btn-crypto" data-tab="crypto" aria-selected="false" aria-controls="tab-crypto" tabindex="-1">${_('toolkit.cat_crypto')}</button>
                <button type="button" class="tab tab-btn" role="tab" id="tab-btn-encoding" data-tab="encoding" aria-selected="false" aria-controls="tab-encoding" tabindex="-1">${_('toolkit.cat_encoding')}</button>
                <button type="button" class="tab tab-btn" role="tab" id="tab-btn-system" data-tab="system" aria-selected="false" aria-controls="tab-system" tabindex="-1">${_('toolkit.cat_system')}</button>
            </div>

            <div class="tab-panel tool-list" role="tabpanel" id="tab-network" aria-labelledby="tab-btn-network">
                ${tool({ id: 'ping', result: 'ping-result', requires: 'device.connect', title: _('toolkit.ping_title'), desc: _('toolkit.ping_desc'),
                    fields: field('ping-host', _('toolkit.host'), text('ping-host', 'placeholder="example.com"'), _('toolkit.host_hint')),
                    actions: run('ping-run', _('toolkit.ping_run')) })}
                ${tool({ id: 'tcp', result: 'tcp-result', requires: 'device.connect', title: _('toolkit.tcp_title'), desc: _('toolkit.tcp_desc'),
                    fields: field('tcp-host', _('toolkit.host'), text('tcp-host', 'placeholder="example.com"'), _('toolkit.host_hint'))
                        + field('tcp-port', _('toolkit.port'), port('tcp-port', '443')),
                    actions: run('tcp-run', _('toolkit.tcp_run')) })}
                ${tool({ id: 'ssl', result: 'ssl-result', title: _('toolkit.ssl_title'), desc: _('toolkit.ssl_desc'),
                    fields: field('ssl-host', _('toolkit.host'), text('ssl-host', 'placeholder="example.com"'))
                        + field('ssl-port', _('toolkit.port'), port('ssl-port', '443')),
                    actions: run('ssl-run', _('toolkit.ssl_run')) })}
                ${tool({ id: 'http', result: 'http-result', requires: 'device.connect', title: _('toolkit.http_title'), desc: _('toolkit.http_desc'),
                    fields: field('http-url', _('toolkit.url'), text('http-url', 'placeholder="https://example.com" inputmode="url"'), _('toolkit.url_hint')),
                    actions: run('http-run', _('toolkit.http_run')) })}
                ${tool({ id: 'dns', result: 'dns-result', requires: 'device.connect', title: _('toolkit.dns_title'), desc: _('toolkit.dns_desc'),
                    fields: field('dns-domain', _('toolkit.domain'), text('dns-domain', 'placeholder="example.com"')),
                    actions: run('dns-run', _('toolkit.dns_run')) })}
                ${tool({ id: 'whois', result: 'whois-result', title: _('toolkit.whois_title'), desc: _('toolkit.whois_desc'),
                    fields: field('whois-domain', _('toolkit.domain'), text('whois-domain', 'placeholder="example.com"')),
                    actions: run('whois-run', _('toolkit.whois_run')) })}
                ${tool({ id: 'speed', result: 'speed-result', requires: 'metrics.view', title: _('toolkit.speed_title'), desc: _('toolkit.speed_desc'),
                    actions: run('speed-run', _('toolkit.run_speed_test')) })}
                ${tool({ id: 'wol', result: 'wol-result', requires: 'device.connect', title: _('toolkit.wol_title'), desc: _('toolkit.wol_desc'),
                    fields: field('wol-mac', _('toolkit.mac_address'), text('wol-mac', 'placeholder="AA:BB:CC:DD:EE:FF"'))
                        + field('wol-broadcast', _('toolkit.broadcast'), text('wol-broadcast', 'placeholder="255.255.255.255"'), _('toolkit.broadcast_hint')),
                    actions: run('wol-run', _('toolkit.wol_run')) })}
            </div>

            <div class="tab-panel tool-list" role="tabpanel" id="tab-crypto" aria-labelledby="tab-btn-crypto" hidden>
                ${tool({ id: 'hash', result: 'hash-result', title: _('toolkit.hash_title'), desc: _('toolkit.hash_desc'),
                    fields: field('hash-algo', _('toolkit.algorithm'), `<select id="hash-algo" class="form-select is-medium">
                                <option value="md5">MD5</option>
                                <option value="sha1">SHA-1</option>
                                <option value="sha256" selected>SHA-256</option>
                                <option value="sha512">SHA-512</option>
                            </select>`)
                        + field('hash-input', _('toolkit.input_text'), area('hash-input')),
                    actions: run('hash-run', _('toolkit.hash_run')) })}
                ${tool({ id: 'password', result: 'pwd-result', title: _('toolkit.password_title'), desc: _('toolkit.password_desc'),
                    fields: field('pwd-length', _('toolkit.length'), '<input type="number" id="pwd-length" class="form-input is-short" value="20" min="4" max="128" inputmode="numeric">', _('toolkit.length_hint'))
                        + `<fieldset class="tool-checks">
                            <legend class="form-label">${_('toolkit.characters')}</legend>
                            <label class="checkbox-row"><input type="checkbox" id="pwd-upper" checked> ${_('toolkit.chars_upper')}</label>
                            <label class="checkbox-row"><input type="checkbox" id="pwd-lower" checked> ${_('toolkit.chars_lower')}</label>
                            <label class="checkbox-row"><input type="checkbox" id="pwd-digits" checked> ${_('toolkit.chars_digits')}</label>
                            <label class="checkbox-row"><input type="checkbox" id="pwd-symbols"> ${_('toolkit.chars_symbols')}</label>
                        </fieldset>`,
                    actions: run('pwd-run', _('toolkit.password_run')) })}
                ${tool({ id: 'jwt', result: 'jwt-result', title: _('toolkit.jwt_title'), desc: _('toolkit.jwt_desc'),
                    fields: field('jwt-input', _('toolkit.jwt_token'), area('jwt-input'), _('toolkit.jwt_hint')),
                    actions: run('jwt-run', _('toolkit.decode')) })}
            </div>

            <div class="tab-panel tool-list" role="tabpanel" id="tab-encoding" aria-labelledby="tab-btn-encoding" hidden>
                ${tool({ id: 'base64', result: 'b64-result', title: _('toolkit.base64_title'), desc: _('toolkit.base64_desc'),
                    fields: field('b64-input', _('toolkit.input_text'), area('b64-input')),
                    actions: `<button type="button" class="btn" id="b64-encode">${_('toolkit.encode')}</button>
                            <button type="button" class="btn" id="b64-decode">${_('toolkit.decode')}</button>` })}
                ${tool({ id: 'urlencode', result: 'url-result', title: _('toolkit.url_title'), desc: _('toolkit.url_desc'),
                    fields: field('url-input', _('toolkit.input_text'), area('url-input')),
                    actions: `<button type="button" class="btn" id="url-encode">${_('toolkit.encode')}</button>
                            <button type="button" class="btn" id="url-decode">${_('toolkit.decode')}</button>` })}
            </div>

            <div class="tab-panel tool-list" role="tabpanel" id="tab-system" aria-labelledby="tab-btn-system" hidden>
                ${tool({ id: 'processes', result: 'proc-result', requires: 'metrics.view', title: _('toolkit.processes_title'), desc: _('toolkit.processes_desc'),
                    actions: run('proc-run', _('toolkit.show_processes')) })}
                ${tool({ id: 'disk', result: 'disk-result', requires: 'metrics.view', title: _('toolkit.disk_title'), desc: _('toolkit.disk_desc'),
                    actions: run('disk-run', _('toolkit.show_disks')) })}
                ${tool({ id: 'db', result: 'db-result', requires: 'metrics.view', title: _('toolkit.db_title'), desc: _('toolkit.db_desc'),
                    actions: run('db-run', _('toolkit.show_db')) })}
                ${tool({ id: 'docker', result: 'docker-result', requires: 'metrics.view', title: _('toolkit.docker_title'), desc: _('toolkit.docker_desc'),
                    actions: run('docker-run', _('toolkit.show_containers')) })}
                ${tool({ id: 'logs', result: 'log-result', requires: 'metrics.view', title: _('toolkit.logs_title'), desc: _('toolkit.logs_desc'),
                    fields: field('log-source', _('toolkit.source'), `<select id="log-source" class="form-select is-medium">
                                <option value="console">${_('toolkit.log_console')}</option>
                                <option value="go">${_('toolkit.log_go')}</option>
                            </select>`)
                        + field('log-lines', _('toolkit.lines'), '<input type="number" id="log-lines" class="form-input is-short" value="50" min="10" max="200" inputmode="numeric">', _('toolkit.lines_hint')),
                    actions: run('log-run', _('toolkit.show_logs')) })}
            </div>

            <p class="state" id="toolkit-none" hidden>${_('toolkit.none_allowed')}</p>
        </div>
    </div>
` }) %>
