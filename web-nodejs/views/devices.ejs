<%
    const can = (p) => typeof hasPermission !== 'function' || hasPermission(p);
    const canEditDevices = can('device.edit');
%><%- include('layouts/main', {
    title: _('nav.devices'),
    pageStyles: ['ui/chart', 'ui/devices', 'ui/device-detail'],
    pageScripts: ['ui-chart', 'devices', 'deviceDetail', 'rdclient/mesh-terminal', 'rdclient/mesh-port-forward'],
    currentPage: 'devices',
    breadcrumb: [{ label: _('folders.all_devices') }],
    body: `
        <div class="page page-wide devices-page">
            <div class="page-head">
                <h1>${_('devices.title')}</h1>
                <p class="page-meta" id="devices-summary" aria-live="polite"><span id="devices-count" hidden>0</span></p>
                <div class="page-actions">
                    <button type="button" class="btn btn-secondary" id="sync-btn"><span class="material-icons" aria-hidden="true">refresh</span>${_('devices.sync_status')}</button>
                    ${can('remote_target.edit') ? `<button type="button" class="btn btn-primary" id="add-remote-target-btn"><span class="material-icons" aria-hidden="true">add</span>${_('devices.add_remote_target')}</button>` : ''}
                </div>
            </div>

            <div class="devices-layout">
                <!-- Folders and groups filter the list -->
                <aside class="devices-filters" aria-label="${_('folders.title')}">
                    <div class="filter-block folders-bar" id="folders-bar">
                        <div class="filter-head">
                            <h2>${_('folders.title')}</h2>
                            ${canEditDevices ? `<button type="button" class="btn btn-sm btn-ghost filter-add" id="add-folder-btn"><span class="material-icons" aria-hidden="true">add</span>${_('folders.create')}</button>` : ''}
                        </div>
                        <ul class="filter-list folders-chips" id="folders-chips">
                            <li class="filter-item">
                                <span class="folder-chip filter-option active" data-folder="all" role="button" tabindex="0">
                                    <span class="chip-label">${_('folders.all_devices')}</span>
                                    <span class="chip-count" id="folder-count-all">0</span>
                                </span>
                            </li>
                            <li class="filter-item">
                                <span class="folder-chip filter-option" data-folder="unassigned" role="button" tabindex="0">
                                    <span class="chip-label">${_('folders.unassigned')}</span>
                                    <span class="chip-count" id="folder-count-unassigned">0</span>
                                </span>
                            </li>
                        </ul>
                        <ul class="filter-list" id="custom-folders"></ul>
                    </div>

                    <div class="filter-block groups-bar" id="groups-bar">
                        <div class="filter-head">
                            <h2>${_('device_detail.device_groups')}</h2>
                            ${canEditDevices ? `<button type="button" class="btn btn-sm btn-ghost filter-add" id="add-device-group-btn"><span class="material-icons" aria-hidden="true">add</span>${_('devices.create_group')}</button>` : ''}
                        </div>
                        <ul class="filter-list groups-chips" id="groups-chips">
                            <li class="filter-item filter-item-all-groups">
                                <span class="group-chip filter-option active" data-group="all" role="button" tabindex="0">
                                    <span class="chip-label">${_('devices.all_groups')}</span>
                                    <span class="chip-count" id="group-count-all">0</span>
                                </span>
                            </li>
                        </ul>
                        <ul class="filter-list" id="custom-device-groups"></ul>
                    </div>
                </aside>

                <div class="devices-main">
                    <div class="devices-toolbar">
                        <div class="toolbar-search search-wrapper">
                            <span class="material-icons" aria-hidden="true">search</span>
                            <input type="search" class="form-input" id="search-input"
                                aria-label="${_('devices.search_placeholder')}"
                                placeholder="${_('devices.search_placeholder')}">
                        </div>
                        <div class="toolbar-filters" role="group" aria-label="${_('devices.status')}">
                            <button type="button" class="filter-btn active" aria-pressed="true" data-filter="all">${_('devices.filter_all')}</button>
                            <button type="button" class="filter-btn" aria-pressed="false" data-filter="online">${_('devices.filter_online')}</button>
                            <button type="button" class="filter-btn" aria-pressed="false" data-filter="offline">${_('devices.filter_offline')}</button>
                            <button type="button" class="filter-btn" aria-pressed="false" data-filter="mesh_agent">${_('mesh.filter_mesh')}</button>
                            <button type="button" class="filter-btn" aria-pressed="false" data-filter="banned">${_('devices.filter_banned')}</button>
                        </div>
                        <div class="toolbar-end">
                            <label class="checkbox-row show-deleted-toggle" for="show-deleted-input">
                                <input type="checkbox" id="show-deleted-input">
                                <span>${_('devices.show_deleted')}</span>
                            </label>
                            <div class="tag-filter-dropdown">
                                <button type="button" class="btn toolbar-menu-btn" id="tags-filter-btn" aria-haspopup="true" aria-expanded="false" aria-controls="tags-filter-menu">
                                    <span class="toolbar-menu-label">${_('devices.tags')}</span><span class="tag-filter-summary" id="tags-filter-summary"></span>
                                    <span class="material-icons" aria-hidden="true">expand_more</span>
                                </button>
                                <div class="tag-filter-menu menu" id="tags-filter-menu">
                                    <p class="tag-filter-note">${_('devices.tag_filter_note')}</p>
                                    <div class="tag-filter-options" id="tags-filter-options">
                                        <div class="tag-filter-empty">${_('devices.no_tags')}</div>
                                    </div>
                                    ${canEditDevices ? `<div class="menu-divider"></div>
                                    <button type="button" class="menu-item" id="manage-tags-btn"><span class="material-icons" aria-hidden="true">sell</span>${_('devices.manage_tags')}</button>` : ''}
                                </div>
                            </div>
                            <div class="column-visibility-dropdown">
                                <button type="button" class="btn toolbar-menu-btn" id="columns-btn" aria-haspopup="true" aria-expanded="false" aria-controls="columns-menu">
                                    <span class="toolbar-menu-label">${_('devices.columns')}</span>
                                    <span class="material-icons" aria-hidden="true">expand_more</span>
                                </button>
                                <div class="column-visibility-menu menu" id="columns-menu">
                                    <label class="column-toggle checkbox-row">
                                        <input type="checkbox" data-column="device_type" checked>
                                        <span>${_('devices.device_type')}</span>
                                    </label>
                                    <label class="column-toggle checkbox-row">
                                        <input type="checkbox" data-column="platform" checked>
                                        <span>${_('devices.platform')}</span>
                                    </label>
                                    <label class="column-toggle checkbox-row">
                                        <input type="checkbox" data-column="last_online" checked>
                                        <span>${_('devices.last_seen')}</span>
                                    </label>
                                    <label class="column-toggle checkbox-row">
                                        <input type="checkbox" data-column="status" checked>
                                        <span>${_('devices.status')}</span>
                                    </label>
                                    <label class="column-toggle checkbox-row">
                                        <input type="checkbox" data-column="tags" checked>
                                        <span>${_('devices.tags')}</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="devices-table-container">
                        <div class="devices-table-scroll table-scroll" id="devices-table-scroll">
                            <table class="data-table devices-table" id="devices-table">
                                <thead>
                                    <tr>
                                        <th class="sortable" data-sort="id" data-column="id" aria-sort="none"><button type="button" class="sort-btn">${_('devices.id')}</button></th>
                                        <th class="sortable" data-sort="hostname" data-column="hostname" aria-sort="none"><button type="button" class="sort-btn">${_('devices.hostname')}</button></th>
                                        <th class="sortable" data-sort="device_type" data-column="device_type" aria-sort="none"><button type="button" class="sort-btn">${_('devices.device_type')}</button></th>
                                        <th class="sortable" data-sort="platform" data-column="platform" aria-sort="none"><button type="button" class="sort-btn">${_('devices.platform')}</button></th>
                                        <th class="sortable" data-sort="last_online" data-column="last_online" aria-sort="none"><button type="button" class="sort-btn">${_('devices.last_seen')}</button></th>
                                        <th data-column="status">${_('devices.status')}</th>
                                        <th data-column="tags">${_('devices.tags')}</th>
                                        <th class="col-actions" data-column="actions"><span class="sr-only">${_('devices.actions')}</span></th>
                                    </tr>
                                </thead>
                                <tbody id="devices-tbody">
                                    <tr class="loading-row">
                                        <td colspan="8">${_('common.loading')}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="devices-pagination" id="pagination">
                            <span class="pagination-info" id="pagination-info">${_('devices.showing')} 0-0 ${_('devices.of')} 0</span>
                            <label class="pagination-per-page" for="per-page-select">
                                <span>${_('devices.per_page')}</span>
                                <select id="per-page-select" class="form-select is-small pagination-per-page-select">
                                    <option value="10">10</option>
                                    <option value="20" selected>20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </label>
                            <div class="pagination pagination-controls" id="pagination-controls"></div>
                        </div>
                    </div>

                    <div class="devices-empty empty-state hidden" id="devices-empty">
                        <h3 class="devices-empty-title">${_('devices.empty_title')}</h3>
                        <p class="devices-empty-text">${_('devices.empty_text')}</p>
                    </div>
                </div>
            </div>

            <!-- Access rules (RustDesk client settings per user and device group): set up rarely, folded under the list -->
            <details class="section disclosure devices-strategies" id="devices-strategies-card">
                <summary><h2>${_('devices.strategies_title')}</h2><span class="summary-meta" id="devices-strategies-count"></span></summary>
                <div class="section-head devices-strategies-head">
                    <p class="section-note">${_('devices.strategies_hint')}</p>
                    ${canEditDevices ? `<button type="button" class="btn btn-sm" id="add-strategy-btn"><span class="material-icons" aria-hidden="true">add</span>${_('devices.create_strategy')}</button>` : ''}
                </div>
                <div class="devices-strategies-list" id="devices-strategies-list">
                    <p class="state">${_('devices.loading_strategies')}</p>
                </div>
            </details>

            <!-- Shared context menu (devices, folders, groups) -->
            <div class="devices-context-menu menu" id="devices-context-menu" role="menu" hidden></div>

            <!-- Floating horizontal scrollbar (fixed to visible content area) -->
            <div class="devices-hscroll-float" id="devices-hscroll-float" aria-hidden="true">
                <div class="devices-hscroll-spacer" id="devices-hscroll-spacer"></div>
            </div>

            <!-- Kebab overlay for mobile bottom sheet -->
            <div class="kebab-overlay" id="kebab-overlay"></div>
        </div>

        <!-- Folder Form Template -->
        <template id="folder-form-template">
            <form id="folder-form" class="folder-form">
                <div class="form-group">
                    <label for="folder-name">${_('folders.name')}</label>
                    <input type="text" id="folder-name" name="name" class="form-input"
                        maxlength="50" required>
                </div>
                <div class="form-group">
                    <span class="form-label" id="folder-color-label">${_('folders.color')}</span>
                    <div class="color-picker" id="folder-color-picker" role="radiogroup" aria-labelledby="folder-color-label">
                        <button type="button" class="color-option active" data-color="#6366f1" style="background:#6366f1" aria-label="#6366f1"></button>
                        <button type="button" class="color-option" data-color="#22c55e" style="background:#22c55e" aria-label="#22c55e"></button>
                        <button type="button" class="color-option" data-color="#f59e0b" style="background:#f59e0b" aria-label="#f59e0b"></button>
                        <button type="button" class="color-option" data-color="#ef4444" style="background:#ef4444" aria-label="#ef4444"></button>
                        <button type="button" class="color-option" data-color="#8b5cf6" style="background:#8b5cf6" aria-label="#8b5cf6"></button>
                        <button type="button" class="color-option" data-color="#06b6d4" style="background:#06b6d4" aria-label="#06b6d4"></button>
                        <button type="button" class="color-option" data-color="#ec4899" style="background:#ec4899" aria-label="#ec4899"></button>
                        <button type="button" class="color-option" data-color="#64748b" style="background:#64748b" aria-label="#64748b"></button>
                    </div>
                    <input type="hidden" id="folder-color" name="color" value="#6366f1">
                </div>
                <div class="form-group">
                    <label for="folder-allowed-users">${_('devices.group_allowed_users')}</label>
                    <input type="text" id="folder-allowed-users" name="allowed_users" class="form-input"
                        placeholder="operator1, operator2">
                    <p class="form-hint">${_('devices.group_allowed_users_hint')}</p>
                </div>
                <div class="form-group">
                    <span class="form-label">${_('devices.group_allowed_user_groups')}</span>
                    <div class="group-membership-list compact" id="folder-user-groups-list"></div>
                    <p class="form-hint">${_('devices.group_allowed_user_groups_hint')}</p>
                </div>
            </form>
        </template>
    `
}) %>
