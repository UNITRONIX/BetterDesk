<%- include('layouts/remote-desk', {
    title: _('nav.remote'),
    pageStyles: ['ui/remote'],
    pageScripts: ['remote-dashboard'],
    body: `
<div class="rd-desk-app remote-dashboard-layout" id="rd-desk-app">
    <header class="rd-desk-header">
        <a class="rd-desk-brand" href="/devices">
            ${typeof branding !== 'undefined' && branding && branding.logoType === 'default'
                ? include('partials/brand-logo', { bdLogoName: appName, bdLogoHeight: 20, bdLogoNameClass: 'rd-desk-brand-name' })
                : `<span class="rd-desk-logo" id="rd-desk-logo" aria-hidden="true"></span>
            <span class="rd-desk-brand-name">${String(appName).replace(/&/g, "&amp;").replace(/</g, "&lt;")}</span>`}
        </a>
        <div class="rd-desk-header-actions">
            <span class="rd-desk-user" id="rd-desk-user"></span>
            <label class="rd-desk-lang">
                <span class="sr-only">${_('settings.language')}</span>
                <select id="rd-desk-lang" class="form-select" data-language-select></select>
            </label>
            <button type="button" class="btn" id="rd-desk-settings" hidden>${_('remote_dashboard.open_settings')}</button>
            <a href="/devices" class="rd-desk-console-link" target="_blank" rel="noopener noreferrer">${_('remote_dashboard.open_panel')}</a>
        </div>
    </header>

    <main class="page page-wide rd-desk-page" id="rd-desk-main">
        <!-- Title and quick connect share one line on wide screens -->
        <div class="rd-desk-top">
        <div class="page-head">
            <h1 class="rd-desk-title">${_('nav.remote')}</h1>
            <p class="page-description rd-desk-subtitle">${_('remote_dashboard.page_description')}</p>
        </div>

        <section class="rd-desk-quick-connect" aria-labelledby="rd-desk-quick-title">
            <h2 class="sr-only" id="rd-desk-quick-title">${_('remote_dashboard.quick_connect_title')}</h2>
            <label class="form-label" for="rd-desk-quick-id">${_('remote_dashboard.col_id')}</label>
            <div class="rd-desk-quick-row">
                <input type="text" id="rd-desk-quick-id" class="form-input mono rd-desk-quick-input"
                    autocomplete="off" spellcheck="false" autocapitalize="none" enterkeyhint="go"
                    aria-describedby="rd-desk-quick-status">
                <button type="button" class="btn btn-primary" id="rd-desk-quick-btn">${_('remote_dashboard.connect')}</button>
                <button type="button" class="btn" id="rd-desk-quick-app">${_('remote_viewer.open_in_app')}</button>
            </div>
            <p class="form-hint rd-desk-quick-status" id="rd-desk-quick-status" aria-live="polite">${_('remote_dashboard.quick_connect_hint')}</p>
        </section>
        </div>

        <p class="notice warning rd-desk-phone-note" id="rd-phone-gate" hidden>${_('remote_dashboard.phone_note')}</p>

        <div class="rd-desk-workspace">
            <aside class="rd-desk-sidebar" id="rd-desk-sidebar" aria-label="${_('remote_dashboard.filters_label')}">
                <div class="filter-block" data-filter-block="folders">
                    <div class="filter-head"><h2>${_('remote_dashboard.nav_folders')}</h2></div>
                    <ul class="filter-list" id="rd-desk-folders">
                        <li class="filter-item" data-static="1"><button type="button" class="rd-desk-nav-item filter-option active" aria-pressed="true" data-nav="folder" data-id="all">
                            <span class="rd-desk-nav-label chip-label">${_('remote_dashboard.all_devices')}</span>
                            <span class="rd-desk-nav-count chip-count" id="rd-count-all">0</span>
                        </button></li>
                        <li class="filter-item" data-static="1"><button type="button" class="rd-desk-nav-item filter-option" aria-pressed="false" data-nav="folder" data-id="unassigned">
                            <span class="rd-desk-nav-label chip-label">${_('remote_dashboard.unassigned')}</span>
                            <span class="rd-desk-nav-count chip-count" id="rd-count-unassigned">0</span>
                        </button></li>
                    </ul>
                    <ul class="filter-list" id="rd-desk-folders-custom"></ul>
                </div>

                <div class="filter-block" data-filter-block="groups">
                    <div class="filter-head"><h2>${_('remote_dashboard.nav_groups')}</h2></div>
                    <ul class="filter-list" id="rd-desk-groups">
                        <li class="filter-empty hidden" id="rd-desk-groups-empty" data-static="1">${_('remote_dashboard.no_groups')}</li>
                    </ul>
                </div>

                <div class="filter-block" data-filter-block="tags">
                    <div class="filter-head"><h2>${_('remote_dashboard.nav_tags')}</h2></div>
                    <ul class="filter-list" id="rd-desk-tags">
                        <li class="filter-empty hidden" id="rd-desk-tags-empty" data-static="1">${_('remote_dashboard.no_tags')}</li>
                    </ul>
                </div>
            </aside>

            <section class="rd-desk-content" aria-labelledby="rd-desk-section-title">
                <h2 class="rd-desk-section-title" id="rd-desk-section-title">${_('remote_dashboard.all_devices')}</h2>
                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" id="rd-desk-search" class="form-input" autocomplete="off"
                            aria-label="${_('remote_dashboard.search_placeholder')}"
                            placeholder="${_('remote_dashboard.search_placeholder')}">
                    </div>
                    <div class="toolbar-filters" role="group" aria-label="${_('remote_dashboard.col_status')}">
                        <button type="button" class="rd-desk-filter filter-btn active" aria-pressed="true" data-filter="all">${_('remote_dashboard.filter_all')}</button>
                        <button type="button" class="rd-desk-filter filter-btn" aria-pressed="false" data-filter="online">${_('remote_dashboard.filter_online')}</button>
                        <button type="button" class="rd-desk-filter filter-btn" aria-pressed="false" data-filter="offline">${_('remote_dashboard.filter_offline')}</button>
                    </div>
                    <div class="toolbar-end">
                        <div class="view-switch" role="group" aria-label="${_('remote_dashboard.view_label')}">
                            <button type="button" id="rd-view-list" aria-pressed="true" class="active">${_('remote_dashboard.view_list')}</button>
                            <button type="button" id="rd-view-grid" aria-pressed="false">${_('remote_dashboard.view_grid')}</button>
                        </div>
                        <button type="button" class="btn" id="rd-desk-refresh"><span class="material-icons" aria-hidden="true">refresh</span>${_('remote_dashboard.sync_now')}</button>
                    </div>
                </div>
                <p class="count-line" aria-live="polite">
                    <span id="rd-desk-count"></span>
                    <span class="rd-desk-sync" id="rd-desk-status-text"></span>
                </p>

                <div class="rd-desk-devices" id="rd-desk-devices-panel">
                    <p class="state" id="rd-desk-loading">${_('remote_dashboard.loading')}</p>
                    <p class="state is-error hidden" id="rd-desk-error">
                        <span id="rd-desk-error-text">${_('remote_dashboard.error_load')}</span>
                        <button type="button" class="btn btn-sm" id="rd-desk-retry">${_('remote_dashboard.retry')}</button>
                    </p>
                    <p class="state hidden" id="rd-desk-empty">${_('remote_dashboard.empty')}</p>
                    <div class="table-scroll hidden" id="rd-desk-table-wrap">
                        <table class="data-table rd-desk-table">
                            <thead>
                                <tr>
                                    <th scope="col">${_('remote_dashboard.col_name')}</th>
                                    <th scope="col">${_('remote_dashboard.col_id')}</th>
                                    <th scope="col">${_('remote_dashboard.col_status')}</th>
                                    <th scope="col" class="rd-desk-col-platform">${_('remote_dashboard.col_platform')}</th>
                                    <th scope="col" class="rd-desk-col-last">${_('remote_dashboard.col_last_seen')}</th>
                                    <th scope="col" class="actions"><span class="sr-only">${_('remote.actions')}</span></th>
                                </tr>
                            </thead>
                            <tbody id="rd-desk-tbody"></tbody>
                        </table>
                    </div>
                    <div class="rd-desk-grid hidden" id="rd-desk-grid"></div>
                </div>
            </section>
        </div>
    </main>
</div>
`
}) %>
