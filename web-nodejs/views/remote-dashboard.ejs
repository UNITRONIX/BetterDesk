<%
  var _langs = availableLanguageList || [];
  var _langOpts = _langs.map(function (language) {
    var active = lang === language.code ? ' active' : '';
    var check = lang === language.code
      ? '<span class="material-icons lang-check" aria-hidden="true">check</span>'
      : '';
    var label = language.native || language.name || language.code;
    return '<div class="lang-option menu-item' + active + '" data-lang="' + language.code +
      '" role="button" tabindex="0">' +
      '<span class="lang-flag" aria-hidden="true">' + (language.flag || '🌐') + '</span>' +
      '<span class="lang-label">' + label + '</span>' +
      check + '</div>';
  }).join('');
%>
<%- include('layouts/remote-desk', {
    title: typeof title !== 'undefined' ? title : _('remote_dashboard.title'),
    pageStyles: ['remote-dashboard'],
    pageScripts: ['remote-dashboard'],
    body: `
<div class="rd-phone-gate" id="rd-phone-gate" hidden>
    <div class="rd-phone-gate-card">
        <div class="rd-phone-gate-icon"><span class="material-icons">tablet_mac</span></div>
        <h1 class="rd-phone-gate-title">${_('remote.phone_unsupported_title')}</h1>
        <p class="rd-phone-gate-body">${_('remote.phone_unsupported_body')}</p>
        <div class="rd-phone-gate-actions">
            <a href="/devices" class="btn btn-primary">${_('remote.phone_unsupported_back_devices')}</a>
            <a href="/" class="btn">${_('mobile_nav.home')}</a>
        </div>
    </div>
</div>
<div class="rd-desk-app remote-dashboard-layout" id="rd-desk-app">
    <header class="rd-desk-header">
        <div class="rd-desk-brand">
            <div class="rd-desk-logo" id="rd-desk-logo" aria-hidden="true"></div>
            <div class="rd-desk-brand-text">
                <h1 class="rd-desk-title" id="rd-desk-brand-name">${appName}</h1>
                <p class="rd-desk-subtitle">${_('remote_dashboard.title')}</p>
            </div>
        </div>
        <div class="rd-desk-header-actions">
            <div class="rd-desk-lang lang-selector">
                <button type="button" class="icon-btn" id="rd-desk-lang-btn"
                        title="${_('settings.language')}"
                        aria-label="${_('settings.language')}"
                        aria-haspopup="true" aria-expanded="false"
                        aria-controls="rd-desk-lang-dropdown">
                    <span class="material-icons" aria-hidden="true">language</span>
                </button>
                <div class="lang-dropdown menu" id="rd-desk-lang-dropdown" hidden>
                    ${_langOpts}
                </div>
            </div>
            <button type="button" class="icon-btn" id="rd-desk-settings" title="${_('rdclient_settings.open') || 'Settings'}" hidden>
                <span class="material-icons" aria-hidden="true">settings</span>
            </button>
            <span class="rd-desk-user" id="rd-desk-user"></span>
            <button type="button" class="icon-btn" id="rd-desk-refresh" title="${_('remote_dashboard.sync_now')}">
                <span class="material-icons" aria-hidden="true">sync</span>
            </button>
            <a href="/devices" class="btn btn-primary rd-desk-open-console" target="_blank" rel="noopener noreferrer">
                <span class="material-icons" aria-hidden="true">dashboard</span>
                ${_('remote_dashboard.open_panel')}
            </a>
        </div>
    </header>

    <section class="rd-desk-quick-connect">
        <div class="rd-desk-quick-connect-inner">
            <span class="material-icons rd-desk-quick-icon" aria-hidden="true">connected_tv</span>
            <label class="rd-desk-quick-label" for="rd-desk-quick-id">${_('remote_dashboard.quick_connect')}</label>
            <input type="text" id="rd-desk-quick-id" class="form-input rd-desk-quick-input"
                placeholder="${_('remote_dashboard.quick_connect_placeholder')}" autocomplete="off" spellcheck="false">
            <button type="button" class="btn btn-primary" id="rd-desk-quick-btn">
                <span class="material-icons" aria-hidden="true">play_arrow</span>
                ${_('remote_dashboard.connect')}
            </button>
        </div>
    </section>

    <div class="rd-desk-workspace">
        <aside class="rd-desk-sidebar" id="rd-desk-sidebar">
            <div class="rd-desk-sidebar-scroll" id="rd-desk-sidebar-scroll">
            <nav class="rd-desk-nav-section" data-collapsible="folders">
                <button type="button" class="rd-desk-nav-heading rd-desk-nav-heading-btn" id="rd-desk-nav-folders-toggle" aria-expanded="true">
                    <span>${_('remote_dashboard.nav_folders')}</span>
                    <span class="material-icons rd-desk-nav-chevron" aria-hidden="true">expand_more</span>
                </button>
                <div class="rd-desk-nav-body" id="rd-desk-nav-folders-body">
                <ul class="rd-desk-nav-list" id="rd-desk-folders">
                    <li><button type="button" class="rd-desk-nav-item active" data-nav="folder" data-id="all">
                        <span class="material-icons" aria-hidden="true">devices</span>
                        <span class="rd-desk-nav-label">${_('remote_dashboard.filter_all')}</span>
                        <span class="rd-desk-nav-count" id="rd-count-all">0</span>
                    </button></li>
                    <li><button type="button" class="rd-desk-nav-item" data-nav="folder" data-id="unassigned">
                        <span class="material-icons" aria-hidden="true">folder_off</span>
                        <span class="rd-desk-nav-label">${_('remote_dashboard.unassigned')}</span>
                        <span class="rd-desk-nav-count" id="rd-count-unassigned">0</span>
                    </button></li>
                </ul>
                <ul class="rd-desk-nav-list rd-desk-nav-custom" id="rd-desk-folders-custom"></ul>
                </div>
            </nav>

            <nav class="rd-desk-nav-section" data-collapsible="groups">
                <button type="button" class="rd-desk-nav-heading rd-desk-nav-heading-btn" id="rd-desk-nav-groups-toggle" aria-expanded="true">
                    <span>${_('remote_dashboard.nav_groups')}</span>
                    <span class="material-icons rd-desk-nav-chevron" aria-hidden="true">expand_more</span>
                </button>
                <div class="rd-desk-nav-body" id="rd-desk-nav-groups-body">
                <ul class="rd-desk-nav-list" id="rd-desk-groups">
                    <li class="rd-desk-nav-empty hidden" id="rd-desk-groups-empty" data-static="1">${_('remote_dashboard.no_groups')}</li>
                </ul>
                </div>
            </nav>

            <nav class="rd-desk-nav-section" data-collapsible="tags">
                <button type="button" class="rd-desk-nav-heading rd-desk-nav-heading-btn" id="rd-desk-nav-tags-toggle" aria-expanded="true">
                    <span>${_('remote_dashboard.nav_tags')}</span>
                    <span class="material-icons rd-desk-nav-chevron" aria-hidden="true">expand_more</span>
                </button>
                <div class="rd-desk-nav-body" id="rd-desk-nav-tags-body">
                <ul class="rd-desk-nav-list rd-desk-nav-tags" id="rd-desk-tags">
                    <li class="rd-desk-nav-empty hidden" id="rd-desk-tags-empty" data-static="1">${_('remote_dashboard.no_tags')}</li>
                </ul>
                </div>
            </nav>
            </div>
        </aside>

        <div class="rd-desk-content">
            <div class="rd-desk-toolbar toolbar">
                <div class="rd-desk-toolbar-left">
                    <button type="button" class="icon-btn rd-desk-panel-toggle" id="rd-desk-devices-toggle"
                        title="${_('remote_dashboard.collapse_devices')}" aria-expanded="true" aria-controls="rd-desk-devices-scroll">
                        <span class="material-icons" id="rd-desk-devices-toggle-icon" aria-hidden="true">expand_more</span>
                    </button>
                    <span class="rd-desk-section-title" id="rd-desk-section-title">${_('remote_dashboard.nav_address_book')}</span>
                </div>
                <div class="rd-desk-search-wrap toolbar-search search-wrapper">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input type="search" id="rd-desk-search" class="form-input rd-desk-search"
                        placeholder="${_('remote_dashboard.search_placeholder')}" autocomplete="off">
                </div>
                <div class="rd-desk-filters toolbar-filters" role="tablist">
                    <button type="button" class="rd-desk-filter filter-btn active" data-filter="all" aria-pressed="true">${_('remote_dashboard.filter_all')}</button>
                    <button type="button" class="rd-desk-filter filter-btn" data-filter="online" aria-pressed="false">${_('remote_dashboard.filter_online')}</button>
                    <button type="button" class="rd-desk-filter filter-btn" data-filter="offline" aria-pressed="false">${_('remote_dashboard.filter_offline')}</button>
                </div>
                <div class="rd-desk-view-toggle view-switch" role="group" aria-label="${_('remote_dashboard.view_grid')}">
                    <button type="button" class="active" id="rd-view-grid" title="${_('remote_dashboard.view_grid')}" aria-pressed="true" aria-label="${_('remote_dashboard.view_grid')}">
                        <span class="material-icons" aria-hidden="true">grid_view</span>
                    </button>
                    <button type="button" id="rd-view-list" title="${_('remote_dashboard.view_list')}" aria-pressed="false" aria-label="${_('remote_dashboard.view_list')}">
                        <span class="material-icons" aria-hidden="true">view_list</span>
                    </button>
                </div>
                <div class="toolbar-end">
                    <span class="rd-desk-count" id="rd-desk-count"></span>
                </div>
            </div>

            <main class="rd-desk-main">
                <div class="rd-desk-devices-panel" id="rd-desk-devices-panel">
                <div class="rd-desk-devices-scroll" id="rd-desk-devices-scroll">
                <div class="rd-desk-loading" id="rd-desk-loading">
                    <span class="material-icons rd-desk-spin" aria-hidden="true">sync</span>
                    <span>${_('remote_dashboard.loading')}</span>
                </div>
                <div class="rd-desk-error hidden" id="rd-desk-error">
                    <span class="material-icons" aria-hidden="true">error_outline</span>
                    <span id="rd-desk-error-text">${_('remote_dashboard.error_load')}</span>
                    <button type="button" class="btn btn-primary" id="rd-desk-retry">${_('remote_dashboard.retry')}</button>
                </div>
                <div class="rd-desk-empty hidden" id="rd-desk-empty">
                    <span class="material-icons" aria-hidden="true">devices_other</span>
                    <p>${_('remote_dashboard.empty')}</p>
                </div>
                <div class="rd-desk-grid hidden" id="rd-desk-grid"></div>
                <div class="rd-desk-table-wrap hidden" id="rd-desk-table-wrap">
                    <table class="rd-desk-table">
                        <thead>
                            <tr>
                                <th>${_('remote_dashboard.col_status')}</th>
                                <th>${_('remote_dashboard.col_id')}</th>
                                <th>${_('remote_dashboard.col_hostname')}</th>
                                <th>${_('remote_dashboard.col_platform')}</th>
                                <th>${_('remote_dashboard.col_last_seen')}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="rd-desk-tbody"></tbody>
                    </table>
                </div>
                </div>
                </div>
            </main>
        </div>
    </div>

    <footer class="rd-desk-footer">
        <span class="rd-desk-status-dot online" id="rd-desk-status-dot"></span>
        <span id="rd-desk-status-text">${_('remote_dashboard.status_ready')}</span>
        <span class="rd-desk-sync-time" id="rd-desk-sync-time"></span>
    </footer>
</div>
`
}) %>
