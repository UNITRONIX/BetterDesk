<%
    const themeMode = (branding && branding.themeMode) || 'system';
    const dataTheme = themeMode === 'light' || themeMode === 'system' ? 'light' : 'dark';
    const textDir = typeof isRtl !== 'undefined' && isRtl ? 'rtl' : 'ltr';
%>
<!DOCTYPE html>
<html lang="<%= lang || 'en' %>" dir="<%= textDir %>" data-theme="<%= dataTheme %>" data-theme-mode="<%= themeMode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="<%= appName %> - Remote Desktop Viewer">
    <meta name="robots" content="noindex, nofollow">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= appName %></title>

    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">
    <%- include('../partials/theme-head') %>
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleNext-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/branding.css?v=<%= typeof brandingRevision !== 'undefined' ? brandingRevision : cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/tokens.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/base.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/components.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/remote-viewer.css?v=<%= cacheVersion %>">
</head>
<body class="viewer-body ui-page">
    <!-- Scripts -->
    <script nonce="<%= cspNonce %>">
        // Global config for viewer
        window.BetterDesk = {
            lang: '<%= lang || "en" %>',
            translations: <%- JSON.stringify(translations || {}) %>,
            cacheVersion: '<%= cacheVersion %>',
            csrfToken: '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>',
            user: <%- JSON.stringify(user || null) %>,
            serverPubKey: '<%= typeof serverPubKey !== 'undefined' ? serverPubKey : '' %>',
            connection: <%- JSON.stringify(typeof connection !== 'undefined' && connection ? connection : {}) %>,
            branding: <%- JSON.stringify(branding || {}) %>,
            availableLanguages: <%- JSON.stringify(availableLanguageList || []) %>
        };
    </script>

    <%- body %>
    
    <!-- Translation helper -->
    <script src="/js/i18n-client.js?v=<%= cacheVersion %>"></script>
    <script src="/js/device-capabilities.js?v=<%= cacheVersion %>"></script>
    <script src="/js/utils.js?v=<%= cacheVersion %>"></script>
    <script src="/js/remote-address-book.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclientSecureStore.js?v=<%= cacheVersion %>"></script>
    
    <!-- Vendor libraries for remote client -->
    <script src="/js/vendor/protobuf.min.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/generated/protos-static.js?v=<%= cacheVersion %>"></script>
    <script src="/js/vendor/nacl.min.js?v=<%= cacheVersion %>"></script>
    <script src="/js/vendor/nacl-util.min.js?v=<%= cacheVersion %>"></script>
    <script src="/js/vendor/jmuxer.min.js?v=<%= cacheVersion %>"></script>
    
    <!-- RDClient modules (order matters) -->
    <script src="/js/rdclient/connection.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/connection-params.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/punchhole-response.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/crypto.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/protocol.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/video.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/audio.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/renderer.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/keyboard-scancode.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/keyboard-encoder.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/input.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/touch.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/file-connection.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/local-files.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/desktop-dnd.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/compress.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/clipboard.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/cliprdr.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/filetransfer.js?v=<%= cacheVersion %>"></script>
    <!-- file-modal after filetransfer/local-files so LocalFiles + RDFileTransfer exist at init -->
    <script src="/js/rdclient/file-modal.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/client.js?v=<%= cacheVersion %>"></script>
    <!-- CDAP transport adapter (RDClient-compatible surface for OS-agent devices) -->
    <script src="/js/cdap-audio.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/cdap-filetransfer.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/cdap-adapter.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/betterviewer.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/mesh-files.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/mesh-adapter.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient/remote-target.js?v=<%= cacheVersion %>"></script>
    <script src="/js/lib/sessionMediaSync.js?v=<%= cacheVersion %>"></script>
    <script src="/js/remoteViewerPrefs.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient-mobile-shell.js?v=<%= cacheVersion %>"></script>
    
    <!-- Page-specific scripts -->
    <% if (typeof pageScripts !== 'undefined' && pageScripts) { %>
        <% (Array.isArray(pageScripts) ? pageScripts : [pageScripts]).forEach(script => { %>
    <script src="/js/<%= script %>.js?v=<%= cacheVersion %>"></script>
        <% }); %>
    <% } %>
</body>
</html>
