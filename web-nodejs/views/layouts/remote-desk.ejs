<%# Audit M11 (2026-11-13): data embedded in inline script blocks must not be
    able to close the block. Uses the server helper when present, with an
    equivalent fallback for standalone template rendering (tests/previews). %>
<% var bdJson = (typeof safeJsonScript === 'function') ? safeJsonScript : function (v) {
    return JSON.stringify(v === undefined ? null : v)
        .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
}; %>
<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= appName %></title>

    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">
    <link rel="stylesheet" href="/css/material-icons-local.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/variables.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/theme.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/branding.css?v=<%= typeof brandingRevision !== 'undefined' ? brandingRevision : cacheVersion %>">
    <link rel="stylesheet" href="/css/mobile-shell.css?v=<%= cacheVersion %>">
    <% if (typeof pageStyles !== 'undefined' && pageStyles) { %>
        <% (Array.isArray(pageStyles) ? pageStyles : [pageStyles]).forEach(function(style) { %>
    <link rel="stylesheet" href="/css/<%= style %>.css?v=<%= cacheVersion %>">
        <% }); %>
    <% } %>
</head>
<body class="rd-desk-body">
    <%- body %>

    <script nonce="<%= cspNonce %>">
        window.BetterDesk = {
            lang: '<%= lang || "en" %>',
            translations: <%- bdJson(translations || {}) %>,
            cacheVersion: '<%= cacheVersion %>',
            csrfToken: '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>',
            user: <%- bdJson(user || null) %>,
            branding: <%- bdJson(branding || {}) %>,
            availableLanguages: <%- bdJson(availableLanguageList || []) %>
        };
    </script>
    <script src="/js/i18n-client.js?v=<%= cacheVersion %>"></script>
    <script src="/js/device-capabilities.js?v=<%= cacheVersion %>"></script>
    <script src="/js/rdclient-mobile-shell.js?v=<%= cacheVersion %>"></script>
    <script src="/js/utils.js?v=<%= cacheVersion %>"></script>
    <script src="/js/remote-address-book.js?v=<%= cacheVersion %>"></script>
    <% if (typeof pageScripts !== 'undefined' && pageScripts) { %>
        <% (Array.isArray(pageScripts) ? pageScripts : [pageScripts]).forEach(function(script) { %>
    <script src="/js/<%= script %>.js?v=<%= cacheVersion %>"></script>
        <% }); %>
    <% } %>
</body>
</html>
