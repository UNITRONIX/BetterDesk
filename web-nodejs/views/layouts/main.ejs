<%
    const shell = 'ux35';
    // Pages already moved to the new stylesheets (public/css/ui). A page
    // opts in with uiReworked: true; the rest still load the old CSS stack.
    const REWORKED_PAGES = ['devices', 'dashboard'];
    const reworked = (typeof uiReworked !== 'undefined' && uiReworked)
        || (typeof currentPage !== 'undefined' && REWORKED_PAGES.includes(currentPage));
    const themeMode = (branding && branding.themeMode) || 'system';
    const dataTheme = themeMode === 'light' || themeMode === 'system' ? 'light' : 'dark';
    const textDir = reworked && typeof isRtl !== 'undefined' && isRtl ? 'rtl' : 'ltr';
%>
<!DOCTYPE html>
<html lang="<%= lang || 'en' %>" dir="<%= textDir %>" data-theme="<%= dataTheme %>" data-theme-mode="<%= themeMode %>" data-ui-shell="<%= shell %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="<%= appName %> - <%= appDescription %>">
    <meta name="robots" content="noindex, nofollow">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= appName %></title>

    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">
    <%- include('../partials/theme-head') %>
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleNext-latin.woff2" as="font" type="font/woff2" crossorigin>

    <% if (!reworked) { %>
    <link rel="stylesheet" href="/css/main.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/theme.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui-polish.css?v=<%= cacheVersion %>">
    <% } %>
    <link rel="stylesheet" href="/css/branding.css?v=<%= typeof brandingRevision !== 'undefined' ? brandingRevision : cacheVersion %>">
    <% if (!reworked) { %>
    <link rel="stylesheet" href="/css/transitions.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/notif-center.css?v=<%= cacheVersion %>">
    <% } %>
    <link rel="stylesheet" href="/css/accessibility.css?v=<%= cacheVersion %>">
    <% if (!embed && !reworked) { %>
    <link rel="stylesheet" href="/css/mobile-shell.css?v=<%= cacheVersion %>">
    <% } %>
    <% if (!embed) { %>
    <link rel="stylesheet" href="/css/help-panel.css?v=<%= cacheVersion %>">
    <% } %>
    <link rel="stylesheet" href="/css/ui/tokens.css?v=<%= cacheVersion %>">
    <% if (reworked) { %>
    <link rel="stylesheet" href="/css/ui/base.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/components.css?v=<%= cacheVersion %>">
    <% } %>
    <% if (typeof pageStyles !== 'undefined' && pageStyles.length) { %>
        <% pageStyles.forEach(style => { %>
    <link rel="stylesheet" href="/css/<%= style %>.css?v=<%= cacheVersion %>">
        <% }); %>
    <% } %>
    <link rel="stylesheet" href="/css/ui/shell.css?v=<%= cacheVersion %>">
</head>
<body class="app-page ux35-page<%= reworked ? ' ui-page' : '' %><%= embed ? ' embed-mode' : '' %>">
    <div class="ux35-shell<%= embed ? ' embed-mode' : '' %>" id="app">
        <% if (!embed) { %>
        <%- include('../partials/ux35-topbar') %>
        <% } %>
        <div class="ux35-body">
            <% if (!embed) { %>
            <%- include('../partials/ux35-sidebar') %>
            <% } %>
            <div class="ux35-main">
                <main class="ux35-content main-content" id="ux35-content">
                    <%- body %>
                </main>
            </div>
            <% if (!embed) { %>
            <%- include('../partials/help-panel') %>
            <% } %>
        </div>
        <% if (!embed) { %>
        <%- include('../partials/mobile-bottom-nav') %>
        <% } %>
    </div>

    <div id="modal-container"></div>
    <div id="toast-container" class="toast-container" role="status" aria-live="polite"></div>

    <script nonce="<%= cspNonce %>">
        window.BetterDesk = {
            lang: '<%= lang || "en" %>',
            availableLanguages: <%- JSON.stringify(availableLanguageList || []) %>,
            translations: <%- JSON.stringify(translations || {}) %>,
            cacheVersion: '<%= cacheVersion %>',
            csrfToken: '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>',
            user: <%- JSON.stringify(user || null) %>,
            // What this user may do, so scripts can hide actions that would fail.
            // The server still checks every request.
            permissions: <%- JSON.stringify(typeof hasPermission === 'function' ? ['server.config','device.edit','device.view','device.connect','device.ban','device.delete','device.connection_mode','device.change_id','org.manage_devices','org.manage_users','org.create','org.edit','org.delete','branding.edit','enrollment.approve','enrollment.manage','billing.view','billing.manage','billing.reports','billing.export','audit.view','user.view','user.create','user.edit','user.delete','metrics.view','remote_target.view','remote_target.edit','remote_target.delete','remote_target.connect','remote_target.test','guest.create','chat.access','cdap.view','cdap.command','mesh.terminal','mesh.power','mesh.files'].filter(function (p) { return hasPermission(p); }) : []) %>,
            // Pages this user may open, for the global search (public/js/ui-search.js)
            searchPages: <%- (typeof consoleNav === 'function' ? JSON.stringify(consoleNav({}).sections.reduce(function (all, s) { return all.concat(s.pages.map(function (p) { return { text: p.text, href: p.href, section: s.text, group: p.groupText || '', keywords: p.keywords || '', external: !!p.external }; })); }, [])) : '[]').replace(/</g, '\\u003c') %>,
            sessionPolicy: <%- JSON.stringify(typeof sessionPolicy !== 'undefined' ? sessionPolicy : null) %>,
            branding: <%- JSON.stringify(branding || {}) %>,
            themePalettes: <%- JSON.stringify(typeof themePalettes !== 'undefined' ? themePalettes : {}) %>,
            embed: <%= embed ? 'true' : 'false' %>,
            uiShell: '<%= shell %>'
        };
    </script>
    <script defer src="/js/utils.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/session-guard.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/bd-actions.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/i18n-client.js?v=<%= cacheVersion %>"></script>
    <% if (!embed) { %>
    <script defer src="/js/device-capabilities.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/rdclient-mobile-shell.js?v=<%= cacheVersion %>"></script>
    <% } %>
    <script defer src="/js/notifications.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/notif-center.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/modal.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/restart-flow.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/accessibility.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/app.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/menu-button.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/ui-form.js?v=<%= cacheVersion %>"></script>
    <% if (!embed) { %><script defer src="/js/ui-search.js?v=<%= cacheVersion %>"></script><% } %>
    <script defer src="/js/ui-shell.js?v=<%= cacheVersion %>"></script>
    <% if (!embed) { %>
    <script defer src="/js/ux35-shell.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/mobile-nav.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/help-panel.js?v=<%= cacheVersion %>"></script>
    <% } %>
    <% if (typeof pageScripts !== 'undefined' && pageScripts.length) { %>
        <% pageScripts.forEach(script => { %>
    <script defer src="/js/<%= script %>.js?v=<%= cacheVersion %>"></script>
        <% }); %>
    <% } %>
</body>
</html>
