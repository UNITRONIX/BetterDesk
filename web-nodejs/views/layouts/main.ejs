<%
    // Shell contract: resolved once in server.js (lib/uiShell.js). UX 3.5 is the
    // default; UX 3.6 is the opt-in beta. Anything unknown falls back to UX 3.5.
    const shell = (typeof uiShell !== 'undefined' && uiShell === 'ux36') ? 'ux36' : 'ux35';
    const isBetaShell = shell === 'ux36';
%>
<!DOCTYPE html>
<html lang="<%= lang || 'en' %>" data-theme="<%= (branding && branding.themeMode === 'light') ? 'light' : 'dark' %>" data-theme-mode="<%= (branding && branding.themeMode) || 'dark' %>" data-ui-shell="<%= shell %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="<%= appName %> - <%= appDescription %>">
    <meta name="robots" content="noindex, nofollow">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= appName %></title>

    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">

    <link rel="stylesheet" href="/css/main.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/theme.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui-polish.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/branding.css?v=<%= typeof brandingRevision !== 'undefined' ? brandingRevision : cacheVersion %>">
    <link rel="stylesheet" href="/css/transitions.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/notif-center.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/accessibility.css?v=<%= cacheVersion %>">
    <%# UX 3.6 reuses the UX 3.5 token contract (branding, theming, wallpaper) and layers its own layout on top. %>
    <link rel="stylesheet" href="/css/ux35-tokens.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ux35.css?v=<%= cacheVersion %>">
    <% if (isBetaShell) { %>
    <link rel="stylesheet" href="/css/ux36.css?v=<%= cacheVersion %>">
    <% } %>
    <% if (!embed) { %>
    <link rel="stylesheet" href="/css/mobile-shell.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/help-panel.css?v=<%= cacheVersion %>">
    <% } %>
    <% if (typeof pageStyles !== 'undefined' && pageStyles.length) { %>
        <% pageStyles.forEach(style => { %>
    <link rel="stylesheet" href="/css/<%= style %>.css?v=<%= cacheVersion %>">
        <% }); %>
    <% } %>
</head>
<body class="app-page<%= shell === 'ux35' ? ' ux35-page' : '' %><%= isBetaShell ? ' ux35-page ux36-page' : '' %><%= embed ? ' embed-mode' : '' %>">
    <% if (shell === 'ux35' || isBetaShell) { %>
    <div class="ux35-shell<%= isBetaShell ? ' ux36-shell' : '' %><%= embed ? ' embed-mode' : '' %>" id="app">
        <% if (!embed) { %>
        <%- include('../partials/ux35-topbar') %>
        <% } %>
        <div class="ux35-body">
            <% if (!embed) { %>
            <%- include(isBetaShell ? '../partials/ux36-sidebar' : '../partials/ux35-sidebar') %>
            <% } %>
            <div class="ux35-main">
                <main class="ux35-content main-content" id="ux35-content">
                    <%- body %>
                </main>
            </div>
            <% if (!embed) { %>
            <%- include('../partials/help-panel') %>
            <% } %>
        </div>
        <% if (!embed) { %>
        <%- include('../partials/mobile-bottom-nav') %>
        <% } %>
    </div>
    <% } else { %>
    <div class="app-layout" id="app">
        <% if (!embed) { %>
        <%- include('../partials/sidebar') %>
        <div class="sidebar-overlay" id="sidebar-overlay"></div>
        <% } %>
        <div class="main-wrapper">
            <% if (!embed) { %>
            <%- include('../partials/navbar') %>
            <% } %>
            <main class="main-content">
                <%- body %>
            </main>
        </div>
        <% if (!embed) { %>
        <%- include('../partials/mobile-bottom-nav') %>
        <% } %>
    </div>
    <% if (!embed) { %>
    <%- include('../partials/help-panel') %>
    <% } %>
    <% } %>

    <div id="modal-container"></div>
    <div id="toast-container" class="toast-container"></div>

    <script nonce="<%= cspNonce %>">
        window.BetterDesk = {
            lang: '<%= lang || "en" %>',
            availableLanguages: <%- JSON.stringify(availableLanguageList || []) %>,
            translations: <%- JSON.stringify(translations || {}) %>,
            cacheVersion: '<%= cacheVersion %>',
            csrfToken: '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>',
            user: <%- JSON.stringify(user || null) %>,
            sessionPolicy: <%- JSON.stringify(typeof sessionPolicy !== 'undefined' ? sessionPolicy : null) %>,
            branding: <%- JSON.stringify(branding || {}) %>,
            themePalettes: <%- JSON.stringify(typeof themePalettes !== 'undefined' ? themePalettes : {}) %>,
            embed: <%= embed ? 'true' : 'false' %>,
            uiShell: '<%= shell %>'
        };
    </script>
    <script defer src="/js/utils.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/session-guard.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/bd-actions.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/i18n-client.js?v=<%= cacheVersion %>"></script>
    <% if (!embed) { %>
    <script defer src="/js/device-capabilities.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/rdclient-mobile-shell.js?v=<%= cacheVersion %>"></script>
    <% } %>
    <script defer src="/js/notifications.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/notif-center.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/modal.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/restart-flow.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/accessibility.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/app.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/ui-shell.js?v=<%= cacheVersion %>"></script>
    <% if (!embed) { %>
    <% if (shell === 'ux35' || isBetaShell) { %>
    <script defer src="/js/ux35-shell.js?v=<%= cacheVersion %>"></script>
    <% } %>
    <% if (isBetaShell) { %>
    <script defer src="/js/ux36-shell.js?v=<%= cacheVersion %>"></script>
    <% } %>
    <script defer src="/js/mobile-nav.js?v=<%= cacheVersion %>"></script>
    <script defer src="/js/help-panel.js?v=<%= cacheVersion %>"></script>
    <% } %>
    <% if (typeof pageScripts !== 'undefined' && pageScripts.length) { %>
        <% pageScripts.forEach(script => { %>
    <script defer src="/js/<%= script %>.js?v=<%= cacheVersion %>"></script>
        <% }); %>
    <% } %>
</body>
</html>
