<%
/*
 * Defensive locals: this template must render even when it is used from a
 * path that has no i18n/branding locals (see issue #513). Never assume a
 * local exists here - an unguarded reference would turn one error page into
 * a second, unrenderable one.
 */
var viewLang = (typeof lang !== 'undefined' && lang) ? lang : 'en';
var viewAppName = (typeof appName !== 'undefined' && appName) ? appName : 'BetterDesk';
var viewCacheVersion = (typeof cacheVersion !== 'undefined') ? cacheVersion : '';
var viewBrandingRevision = (typeof brandingRevision !== 'undefined')
    ? brandingRevision
    : viewCacheVersion;
var viewT = (typeof _ === 'function')
    ? _
    : function (key, fallback) { return fallback || key; };
%>
<!DOCTYPE html>
<html lang="<%= viewLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Not Found | <%= viewAppName %></title>
    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">
    <link rel="stylesheet" href="/css/main.css?v=<%= viewCacheVersion %>">
    <link rel="stylesheet" href="/css/theme.css?v=<%= viewCacheVersion %>">
    <link rel="stylesheet" href="/css/branding.css?v=<%= viewBrandingRevision %>">
    <style>
        .error-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: var(--space-lg);
        }
        .error-container {
            max-width: 400px;
        }
        .error-code {
            font-size: 120px;
            font-weight: 700;
            color: var(--accent-blue);
            line-height: 1;
            margin-bottom: var(--space-md);
        }
        .error-title {
            font-size: var(--font-size-2xl);
            font-weight: 600;
            margin-bottom: var(--space-sm);
        }
        .error-message {
            color: var(--text-secondary);
            margin-bottom: var(--space-xl);
        }
        .error-icon {
            font-size: 64px;
            color: var(--text-tertiary);
            margin-bottom: var(--space-md);
        }
    </style>
</head>
<body>
    <div class="error-page">
        <div class="error-container">
            <span class="material-icons error-icon">search_off</span>
            <div class="error-code">404</div>
            <h1 class="error-title"><%= viewT('errors.not_found_title', 'Not Found') %></h1>
            <p class="error-message"><%= viewT('errors.not_found_message', 'The page you are looking for does not exist.') %></p>
            <a href="/" class="btn btn-primary">
                <span class="material-icons">home</span>
                <%= viewT('errors.go_home', 'Go Home') %>
            </a>
        </div>
    </div>
</body>
</html>
