<%
    var saTier = (typeof lastResult !== 'undefined' && lastResult && lastResult.tier)
        ? String(lastResult.tier).toLowerCase() : '';
    var saBadge = (typeof badgePresentation !== 'undefined' && badgePresentation) ? badgePresentation : {};
    var saBadgeConfig = (typeof badgeConfig !== 'undefined' && badgeConfig) ? badgeConfig : {};
    var saTierLabels = saBadge.tierLabels || {};
    var saBrandName = saBadge.brand || (typeof branding !== 'undefined' && branding && branding.appName) || 'BetterDesk';
    var saBadgeTitle = saBadge.badgeTitle || _('server_attestation.badge_tooltip');
    var saTierLabel = saTier
        ? (saBadge.tierLabel || saTierLabels[saTier] || _('server_attestation.tier_' + saTier))
        : _('server_attestation.tier_none');
    var saHasResult = typeof lastResult !== 'undefined' && lastResult;
    var saMaxConn = saHasResult ? lastResult.maxConnections : null;
    var saFm = saHasResult && lastResult.finalMetrics ? lastResult.finalMetrics : null;
    var saEsc = function (value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    };
    var saTiers = ['bronze', 'iron', 'platinum', 'titanium', 'obsidian'];
    var saTierGuide = saTiers.map(function (tier) {
        var isCurrent = tier === saTier;
        return '<dt class="bd-attest-tier' + (isCurrent ? ' is-current' : '') + '" data-tier="' + tier + '">' + saEsc(saTierLabels[tier] || _('server_attestation.tier_' + tier)) + '</dt>'
            + '<dd><span>' + _('server_attestation.tier_' + tier + '_desc') + '</span>'
            + '<span class="sa-tier-current" data-tier-current="' + tier + '"' + (isCurrent ? '' : ' hidden') + '>' + _('server_attestation.tier_this_server') + '</span></dd>';
    }).join('');
    var saTierFields = saTiers.map(function (tier) {
        return '<div class="form-group">'
            + '<label class="form-label" for="sa-tier-' + tier + '">' + _('server_attestation.tier_name_' + tier) + '</label>'
            + '<input id="sa-tier-' + tier + '" class="form-input is-medium" type="text" maxlength="32"'
            + ' value="' + saEsc(saBadgeConfig.tierLabels && saBadgeConfig.tierLabels[tier] || '') + '"'
            + ' aria-describedby="sa-tier-hint">'
            + '</div>';
    }).join('');
%>
<%- include('layouts/main', {
    title: _('nav.server_attestation'),
    uiReworked: true,
    pageStyles: ['ui/server-attestation'],
    pageScripts: ['server-attestation'],
    currentPage: 'server-attestation',
    breadcrumb: [{ label: _('nav.server_attestation') }],
    body: `
<div class="page sa-page" id="sa-page">
    <div class="page-head">
        <h1>${_('nav.server_attestation')}</h1>
        <p class="page-description">${_('server_attestation.page_description')}</p>
    </div>

    <div class="page-cols">
    <div class="page-main">
        <section class="section" aria-labelledby="sa-result-title">
            <div class="section-head">
                <h2 id="sa-result-title">${_('server_attestation.result_title')}</h2>
                <button type="button" class="btn btn-sm" id="sa-download-btn" ${!saHasResult ? 'hidden' : ''}><span class="material-icons" aria-hidden="true">download</span>${_('server_attestation.download_report')}</button>
            </div>
            <p class="sa-result-sentence" id="sa-hero-meta">${saHasResult && lastResult.testedAt
                ? _('server_attestation.result_sentence', { date: saEsc(new Date(lastResult.testedAt).toLocaleString()), count: saMaxConn || 0, tier: saEsc(saTierLabel) })
                : _('server_attestation.no_test_yet')}</p>
            <p class="notice" id="sa-estimated-note" ${saHasResult && lastResult.mode === 'estimated' ? '' : 'hidden'}>${_('server_attestation.mode_estimated')}</p>
            <dl class="facts" id="sa-result-facts" ${saHasResult ? '' : 'hidden'}>
                <dt>${_('server_attestation.max_connections')}</dt>
                <dd><span class="num" id="sa-max-conn">${saMaxConn != null ? saMaxConn : '–'}</span><span class="sa-sub" id="sa-conn-detail"></span></dd>
                <dt>${_('server_attestation.tier_label')}</dt>
                <dd id="sa-tier-value">${saEsc(saTierLabel)}</dd>
                <dt>${_('server_attestation.cpu_at_end')}</dt>
                <dd id="sa-th-cpu">${saFm ? saFm.cpu + ' %' : '–'}</dd>
                <dt>${_('server_attestation.mem_at_end')}</dt>
                <dd id="sa-th-mem">${saFm ? saFm.mem + ' %' : '–'}</dd>
                <dt>${_('server_attestation.disk_at_end')}</dt>
                <dd id="sa-th-disk">${saFm ? saFm.disk + ' %' : '–'}</dd>
            </dl>
            <p class="section-note sa-docker-note">${_('server_attestation.docker_note')}</p>
        </section>

        <section class="section" aria-labelledby="sa-run-title">
            <div class="section-head"><h2 id="sa-run-title">${_('server_attestation.run_title')}</h2></div>
            <p class="notice warning">${_('server_attestation.warning_body')}</p>
            <div class="toolbar">
                <button type="button" class="btn btn-primary" id="sa-run-btn"><span class="material-icons" aria-hidden="true">play_arrow</span>${_('server_attestation.run_benchmark')}</button>
                <button type="button" class="btn hidden" id="sa-abort-btn">${_('server_attestation.abort')}</button>
            </div>
            <div class="sa-progress hidden" id="sa-progress">
                <div class="meter"><span class="meter-bar"><span class="meter-fill" id="sa-progress-fill"></span></span><span class="meter-value" id="sa-progress-pct"></span></div>
                <p class="sa-progress-text" id="sa-progress-text" role="status"></p>
            </div>
        </section>
    </div>

    <aside class="page-side" aria-labelledby="sa-tiers-title">
        <section class="section" aria-labelledby="sa-tiers-title">
            <div class="section-head"><h2 id="sa-tiers-title">${_('server_attestation.tier_guide_title')}</h2></div>
            <dl class="facts sa-tier-guide">${saTierGuide}</dl>
        </section>

        <details class="disclosure section" id="sa-badge-details">
            <summary><h2 id="sa-badge-title-h">${_('server_attestation.badge_settings_title')}</h2></summary>
        <form class="sa-badge-settings" id="sa-badge-form" data-save-form novalidate>
            <section class="section" aria-labelledby="sa-badge-title-h">
                <p class="section-note">${_('server_attestation.badge_settings_desc')}</p>
                <div class="sa-hero" aria-label="${_('server_attestation.badge_preview')}" role="group">
                    <p class="form-label">${_('server_attestation.badge_preview')}</p>
                    <div class="bd-attest-badge" title="${saEsc(saBadgeTitle)}">
                        <span class="bd-attest-brand">${saEsc(saBrandName)}</span>
                        <span class="bd-attest-tier">${saEsc(saTierLabel)}</span>
                        ${saMaxConn ? '<span class="bd-attest-conn">' + saMaxConn + ' ' + _('server_attestation.connections_short') + '</span>' : ''}
                    </div>
                    <p class="form-hint" id="sa-badge-hover">${_('server_attestation.badge_hover', { title: saEsc(saBadgeTitle) })}</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sa-badge-title">${_('server_attestation.badge_title')}</label>
                    <input id="sa-badge-title" class="form-input" type="text" maxlength="96"
                           value="${saEsc(saBadgeConfig.badgeTitle || '')}">
                    <p class="form-hint">${_('server_attestation.badge_title_hint')}</p>
                </div>
                <p class="form-hint" id="sa-tier-hint">${_('server_attestation.tier_names_hint')}</p>
                ${saTierFields}
                <p class="field-effect">${_('server_attestation.badge_effect')}</p>
            </section>
            <div class="save-bar">
                <span class="save-status" id="sa-badge-settings-status" data-save-status aria-live="polite"></span>
                <button type="submit" class="btn" id="sa-save-badge-btn" data-save-button>${_('server_attestation.save_badge_settings')}</button>
            </div>
        </form>
        </details>
    </aside>
    </div>
</div>
`
}) %>
