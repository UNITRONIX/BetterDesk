<%
    const canImport = typeof hasPermission === 'function' && hasPermission('enrollment.manage');
    const canActivate = typeof hasPermission === 'function' && hasPermission('enrollment.approve');
    const canBrand = typeof hasPermission === 'function' && hasPermission('branding.edit');
%>
<%- include('layouts/main', {
    title: _('nav.agents'),
    uiReworked: true,
    pageStyles: ['ui/agents'],
    pageScripts: ['agents'],
    currentPage: 'agents',
    breadcrumb: [{ label: _('nav.agents') }],
    body: `
        <div class="page agents-page">
            <div class="page-head">
                <h1>${_('nav.agents')}</h1>
                <p class="page-description">${_('agents.page_description')}</p>
            </div>

            <div class="page-cols">
            <div class="page-main">
            <!-- The installers this server hands out on its download page -->
            <section class="section" id="agents-sync-card" aria-labelledby="agents-sync-title">
                <div class="section-head"><h2 id="agents-sync-title">${_('agents.sync_title')}</h2></div>
                <p class="section-note">${_('agents.sync_hint')}</p>

                <dl class="facts agents-release" id="agents-release-list" aria-live="polite">
                    <dt>${_('agents.release_label')}</dt>
                    <dd><span class="text-muted">${_('common.loading')}</span></dd>
                </dl>

                <div class="form-actions agents-sync-actions">
                    ${canImport ? `<button type="button" class="btn btn-primary" id="agents-sync-release">${_('agents.sync_import')}</button>` : ''}
                    <span class="form-status" id="agents-release-status" role="status"></span>
                </div>
                ${canImport ? '' : `<p class="form-hint">${_('agents.sync_no_permission')}</p>`}
            </section>

            <section class="section" aria-labelledby="agents-steps-title">
                <div class="section-head"><h2 id="agents-steps-title">${_('agents.steps_title')}</h2></div>
                <ol class="steps">
                    <li>${_('agents.step1')}</li>
                    <li>${_('agents.step2')}</li>
                    <li>${_('agents.step3', { page: canActivate ? `<a href="/?activateAgent=1">${_('nav.activate_agent')}</a>` : _('nav.activate_agent') })}</li>
                    <li>${_('agents.step4', { page: typeof hasPermission === 'function' && hasPermission('enrollment.approve') ? `<a href="/registrations">${_('nav.registrations')}</a>` : _('nav.registrations') })}</li>
                </ol>
            </section>
            </div>

            <aside class="page-side" aria-label="${_('agents.side_label')}">
            <section class="section" aria-labelledby="agents-links-title">
                <div class="section-head"><h2 id="agents-links-title">${_('agents.get_title')}</h2></div>
                <!-- The address people need: copy it here instead of opening the page first -->
                <p class="section-note">${_('agents.portal_hint')}</p>
                <span class="value-field agents-portal-field"><code id="agents-portal-url">/portal</code><button type="button" data-copy-target="agents-portal-url" aria-label="${_('actions.copy')} ${_('agents.portal_address')}"><span class="material-icons" aria-hidden="true">content_copy</span><span class="btn-label">${_('actions.copy')}</span></button></span>
                <ul class="list agents-links">
                    <li><a href="/portal" class="list-row" target="_blank" rel="noopener noreferrer">
                        <span class="row-main"><span class="row-title">${_('agents.get_portal')}</span><span class="row-sub">${_('agents.portal_open_hint')}</span></span>
                        <span class="material-icons row-chevron" aria-hidden="true">open_in_new</span>
                    </a></li>
                    <li><a href="https://github.com/UNITRONIX/BetterDesk-Client/releases" class="list-row" target="_blank" rel="noopener noreferrer">
                        <span class="row-main"><span class="row-title">${_('agents.get_github')}</span><span class="row-sub">${_('agents.note_no_build')}</span></span>
                        <span class="material-icons row-chevron" aria-hidden="true">open_in_new</span>
                    </a></li>
                </ul>
            </section>

            <section class="section" aria-labelledby="agents-branding-title">
                <div class="section-head"><h2 id="agents-branding-title">${_('agents.branding_title')}</h2></div>
                <p class="section-note">${_('agents.branding_body')}</p>
                ${canBrand ? `<p><a href="/client-branding">${_('nav.client_branding')}</a></p>` : ''}
            </section>
            </aside>
            </div>
        </div>
    `
}); %>
