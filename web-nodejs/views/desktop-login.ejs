<%
    var themeMode = (branding && branding.themeMode) || 'system';
    var dataTheme = themeMode === 'light' || themeMode === 'system' ? 'light' : 'dark';
    var hasUsers = typeof loginUsers !== 'undefined' && Array.isArray(loginUsers) && loginUsers.length > 0;
%>
<!DOCTYPE html>
<html lang="<%= lang || 'en' %>" dir="<%= typeof isRtl !== 'undefined' && isRtl ? 'rtl' : 'ltr' %>" data-theme="<%= dataTheme %>" data-theme-mode="<%= themeMode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= appName %> - <%= _('auth.login_title') %>">
    <meta name="robots" content="noindex, nofollow">
    <title><%= _('auth.login_title') %> - <%= appName %></title>

    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">
    <%- include('partials/theme-head') %>
    <link rel="preload" href="/fonts/IBMPlexSans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/branding.css?v=<%= typeof brandingRevision !== 'undefined' ? brandingRevision : cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/tokens.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/base.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/components.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/login.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/ui/desktop-login.css?v=<%= cacheVersion %>">
    <link rel="stylesheet" href="/css/server-attestation.css?v=<%= cacheVersion %>">
</head>
<body class="login-page desktop-login">
    <main class="login-main">
        <div class="login-box">
            <div class="login-brand">
                <% if (branding.logoType === 'default') { %>
                <%- include('partials/brand-logo', { bdLogoName: appName, bdLogoHeight: 28, bdLogoMarkHeight: 28, bdLogoNameClass: 'login-logo-text' }) %>
                <% } else if (branding.logoType === 'text' && branding.logoText) { %>
                <span class="brand-text-logo"><%= branding.logoText %><% if (branding.logoTextAccent) { %><span class="brand-text-accent"><%= branding.logoTextAccent %></span><% } %></span>
                <% } else if (branding.logoType === 'svg' && branding.logoSvg) { %>
                <span class="login-logo-svg"><%- branding.logoSvg %></span>
                <span class="login-logo-text"><%= appName %></span>
                <% } else if (branding.logoType === 'image' && branding.logoUrl) { %>
                <img src="<%= branding.logoUrl %>" alt="" class="login-logo-img">
                <span class="login-logo-text"><%= appName %></span>
                <% } else { %>
                <span class="login-logo-text"><%= appName %></span>
                <% } %>
            </div>

            <h1 class="login-title"><%= _('auth.login_title') %></h1>

            <% if (hasUsers) { %>
            <!-- Accounts on this server: picking one fills in the username (desktop-login.js) -->
            <section class="dl-accounts" aria-labelledby="dl-users-title">
                <h2 class="dl-users-title" id="dl-users-title"><%= _('desktop_login.accounts_title') %></h2>
                <ul class="list dl-users" id="dl-users"></ul>
            </section>
            <% } %>

            <!-- Step 1: username and password -->
            <form class="login-form" id="dl-login-form" novalidate>
                <div class="form-group">
                    <label class="form-label" for="dl-username"><%= _('auth.username') %></label>
                    <input type="text" id="dl-username" class="form-input"
                           autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                </div>

                <div class="form-group">
                    <label class="form-label" for="dl-password"><%= _('auth.password') %></label>
                    <div class="password-wrapper">
                        <input type="password" id="dl-password" class="form-input"
                               autocomplete="current-password" required>
                        <button type="button" class="password-toggle" id="dl-password-toggle" aria-pressed="false"
                                aria-label="<%= _('auth.show_password') %>" title="<%= _('auth.show_password') %>">
                            <span class="material-icons" aria-hidden="true">visibility</span>
                        </button>
                    </div>
                </div>

                <div class="login-error notice error hidden" id="dl-error" role="alert">
                    <span id="dl-error-text"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block login-btn" id="dl-submit-btn"><%= _('auth.login') %></button>
            </form>

            <!-- Step 2: two-factor code (shown when the password is accepted) -->
            <form class="login-form hidden" id="dl-totp-form" novalidate>
                <div class="totp-header">
                    <h2 class="totp-title"><%= _('auth.totp_title') %></h2>
                    <p class="totp-subtitle"><%= _('auth.totp_subtitle') %></p>
                </div>

                <div class="form-group">
                    <label class="form-label" for="dl-totp-code"><%= _('auth.totp_code') %></label>
                    <input type="text" id="dl-totp-code" class="form-input totp-input"
                           autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required>
                </div>

                <div class="login-error notice error hidden" id="dl-totp-error" role="alert">
                    <span id="dl-totp-error-text"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block login-btn" id="dl-totp-submit"><%= _('auth.totp_verify') %></button>

                <p class="totp-links">
                    <a href="#" id="dl-totp-back-link"><%= _('auth.totp_back_to_login') %></a>
                </p>
            </form>

            <div class="login-footer">
                <label class="login-language-picker" for="desktop-language-select">
                    <span><%= _('settings.language') %></span>
                    <%- include('partials/lang-flag', { flagCode: lang }) %>
                    <select id="desktop-language-select" class="form-select" data-language-select>
                        <% (availableLanguageList || Object.values(availableLanguages || {})).forEach(function(language) { %>
                            <option value="<%= language.code %>" <%= lang === language.code ? 'selected' : '' %> lang="<%= language.code %>"><%= language.native || language.name || language.code %></option>
                        <% }); %>
                    </select>
                </label>
                <p class="login-version"><%= appName %> <%= appVersion %></p>
            </div>

            <% if (typeof attestationBadge !== 'undefined' && attestationBadge && attestationBadge.valid && attestationBadge.tier) { %>
            <div class="login-attestation-badge">
                <%- include('partials/server-attestation-badge', {
                    tier: attestationBadge.tier,
                    size: 'small',
                    showConnections: false,
                    maxConnections: attestationBadge.maxConnections,
                    brandName: attestationBadge.brand,
                    badgeTitle: attestationBadge.badgeTitle,
                    tierLabel: attestationBadge.tierLabel
                }) %>
            </div>
            <% } %>
        </div>
    </main>

    <div id="toast-container" class="toast-container" role="status" aria-live="polite"></div>

    <script nonce="<%= cspNonce %>">
        window.BetterDesk = {
            csrfToken: '<%= csrfToken || "" %>',
            lang: '<%= lang || "en" %>',
            availableLanguages: <%- JSON.stringify(availableLanguageList || []) %>,
            translations: <%- JSON.stringify(translations || {}) %>,
            branding: <%- JSON.stringify(branding || {}) %>,
            users: <%- JSON.stringify(typeof loginUsers !== 'undefined' && loginUsers ? loginUsers : []) %>
        };
    </script>
    <script src="/js/utils.js?v=<%= cacheVersion %>"></script>
    <script src="/js/notifications.js?v=<%= cacheVersion %>"></script>
    <script src="/js/i18n-client.js?v=<%= cacheVersion %>"></script>
    <script src="/js/desktop-login.js?v=<%= cacheVersion %>"></script>
</body>
</html>
