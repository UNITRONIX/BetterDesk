<%
    const tabMap = { audit: 'audit', events: 'events', overview: 'overview', hardening: 'hardening', vulnerabilities: 'hardening', sessions: 'sessions' };
    const tab = tabMap[typeof activeTab !== 'undefined' ? activeTab : ''] || 'audit';
    const tabs = [
        ['audit', _('security_audit.tab_audit_log')],
        ['events', _('security_audit.tab_server_events')],
        ['overview', _('security_audit.tab_checks')],
        ['hardening', _('security_audit.tab_hardening')],
        ['sessions', _('security_audit.tab_your_sessions')]
    ];
%>
<%- include('layouts/main', {
  title,
  uiReworked: true,
  pageStyles: ['ui/chart', 'ui/security-audit'],
  pageScripts: ['ui-chart', 'security-audit'],
  currentPage,
  breadcrumb,
  body: `
<div class="page page-wide secaudit-page">
  <div class="page-head">
    <h1>${_('nav.security_audit')}</h1>
    <p class="page-description">${_('security_audit.page_description')}</p>
  </div>

  <div class="secaudit-body">
  <div class="tabs secaudit-tabs" role="tablist" aria-label="${_('nav.security_audit')}">
    ${tabs.map(([id, label]) => `<button type="button" class="tab secaudit-tab ${tab === id ? 'active' : ''}" role="tab" id="tab-${id}" aria-controls="panel-${id}" aria-selected="${tab === id}" tabindex="${tab === id ? '0' : '-1'}" data-tab="${id}">${label}</button>`).join('')}
  </div>

  <!-- Console audit log: what people did in this console -->
  <section class="secaudit-panel section" id="panel-audit" role="tabpanel" aria-labelledby="tab-audit" ${tab === 'audit' ? '' : 'hidden'}>
    <p class="section-note secaudit-note">${_('security_audit.audit_log_note')}</p>
    <div class="toolbar">
      <div class="toolbar-search search-wrapper">
        <span class="material-icons" aria-hidden="true">search</span>
        <input type="search" class="form-input" id="audit-search" aria-label="${_('security_audit.audit_search')}" placeholder="${_('security_audit.audit_search')}">
      </div>
      <label class="secaudit-filter">
        <span class="secaudit-filter-label">${_('security_audit.show')}</span>
        <select class="form-select" id="audit-filter">
          <option value="">${_('security_audit.filter_all')}</option>
          <option value="bans">${_('security_audit.filter_bans')}</option>
          <option value="signins">${_('security_audit.filter_signins')}</option>
          <option value="failed">${_('security_audit.filter_failed')}</option>
          <option value="devices">${_('security_audit.filter_devices')}</option>
          <option value="people">${_('security_audit.filter_people')}</option>
          <option value="settings">${_('security_audit.filter_settings')}</option>
        </select>
      </label>
      <div class="toolbar-end"><button type="button" class="btn" id="audit-refresh"><span class="material-icons" aria-hidden="true">refresh</span>${_('security_audit.refresh')}</button></div>
    </div>
    <p class="count-line" id="audit-count" aria-live="polite"></p>
    <div class="table-scroll">
      <table class="data-table secaudit-table secaudit-stack">
        <thead>
          <tr>
            <th scope="col">${_('security_audit.col_time')}</th>
            <th scope="col">${_('security_audit.col_who')}</th>
            <th scope="col">${_('security_audit.col_action')}</th>
            <th scope="col">${_('security_audit.col_device')}</th>
            <th scope="col">${_('security_audit.col_details')}</th>
            <th scope="col">${_('security_audit.col_ip')}</th>
          </tr>
        </thead>
        <tbody id="audit-tbody"><tr><td colspan="6" class="state-cell">${_('security_audit.loading')}</td></tr></tbody>
      </table>
    </div>
    <nav class="pagination" id="audit-pagination" aria-label="${_('security_audit.pages')}"></nav>
  </section>

  <!-- Events the Go server records -->
  <section class="secaudit-panel section" id="panel-events" role="tabpanel" aria-labelledby="tab-events" ${tab === 'events' ? '' : 'hidden'}>
    <p class="section-note secaudit-note">${_('security_audit.server_events_note')}</p>
    <!-- Events per day (public/js/security-audit.js loadEventsChart): drawn only when the loaded events reach back 14 days -->
    <section class="section secaudit-events-chart" aria-labelledby="events-chart-title" id="events-chart-section" hidden>
      <h2 id="events-chart-title">${_('security_audit.events_chart_title')}</h2>
      <p class="section-note" id="events-range" aria-live="polite"></p>
      <div id="events-chart"></div>
    </section>
    <div class="toolbar">
      <label class="secaudit-filter">
        <span class="secaudit-filter-label">${_('security_audit.show')}</span>
        <select class="form-select" id="event-filter">
          <option value="">${_('security_audit.all_events')}</option>
          <option value="login_failed">${_('security_audit.event_login_failed')}</option>
          <option value="login_success">${_('security_audit.event_login_success')}</option>
          <option value="peer_banned">${_('security_audit.event_peer_banned')}</option>
          <option value="peer_unbanned">${_('security_audit.event_peer_unbanned')}</option>
          <option value="ip_banned">${_('security_audit.event_ip_banned')}</option>
          <option value="device_approved">${_('security_audit.event_device_approved')}</option>
          <option value="config_changed">${_('security_audit.event_config_changed')}</option>
          <option value="key_created">${_('security_audit.event_key_created')}</option>
        </select>
      </label>
      <div class="toolbar-end"><button type="button" class="btn" id="events-refresh"><span class="material-icons" aria-hidden="true">refresh</span>${_('security_audit.refresh')}</button></div>
    </div>
    <div class="table-scroll">
      <table class="data-table secaudit-table secaudit-stack">
        <thead>
          <tr>
            <th scope="col">${_('security_audit.col_time')}</th>
            <th scope="col">${_('security_audit.col_action')}</th>
            <th scope="col">${_('security_audit.col_actor')}</th>
            <th scope="col">${_('security_audit.col_target')}</th>
            <th scope="col">${_('security_audit.col_details')}</th>
          </tr>
        </thead>
        <tbody id="events-tbody"><tr><td colspan="5" class="state-cell">${_('security_audit.loading')}</td></tr></tbody>
      </table>
    </div>
    <nav class="pagination" id="events-pagination" aria-label="${_('security_audit.pages')}"></nav>
  </section>

  <!-- Security checks: the table and its facts; the result and the passed/failed split beside them -->
  <div class="secaudit-panel" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" ${tab === 'overview' ? '' : 'hidden'}>
    <div class="page-cols">
      <div class="page-main">
        <section class="section" aria-labelledby="checks-title">
          <h2 id="checks-title" class="sr-only">${_('security_audit.tab_checks')}</h2>
          <div class="table-scroll">
            <table class="data-table secaudit-table secaudit-stack secaudit-checks">
              <thead>
                <tr>
                  <th scope="col">${_('security_audit.col_check')}</th>
                  <th scope="col">${_('security_audit.col_status')}</th>
                  <th scope="col">${_('security_audit.col_todo')}</th>
                </tr>
              </thead>
              <tbody id="checks-grid"></tbody>
            </table>
          </div>
        </section>
        <div class="cols">
          <section class="section" aria-labelledby="numbers-title">
            <h2 id="numbers-title">${_('security_audit.numbers_title')}</h2>
            <dl class="facts" id="overview-stats"></dl>
          </section>
          <section class="section" aria-labelledby="tls-title">
            <h2 id="tls-title">${_('security_audit.tls_status')}</h2>
            <p class="section-note">${_('security_audit.tls_note')}</p>
            <dl class="facts" id="tls-grid"></dl>
          </section>
        </div>
      </div>
      <aside class="page-side" aria-labelledby="checks-result-title">
        <section class="section secaudit-result">
          <h2 id="checks-result-title">${_('security_audit.checks_result_title')}</h2>
          <p class="secaudit-summary" id="checks-summary" aria-live="polite">${_('security_audit.loading')}</p>
          <div class="share-bar" id="checks-bar" aria-hidden="true" hidden></div>
          <ul class="share-legend" id="checks-legend"></ul>
        </section>
      </aside>
    </div>
  </div>

  <!-- Hardening plan; the dependency scan beside it -->
  <div class="secaudit-panel" id="panel-hardening" role="tabpanel" aria-labelledby="tab-hardening" ${tab === 'hardening' ? '' : 'hidden'}>
    <div class="page-cols">
      <section class="section page-main" aria-labelledby="hardening-title">
        <h2 id="hardening-title" class="sr-only">${_('security_audit.tab_hardening')}</h2>
        <p class="section-note secaudit-note">${_('security_audit.hardening_hint')}</p>
        <p class="count-line" id="hardening-count"></p>
        <ul class="list" id="hardening-list"><li class="list-row is-empty">${_('security_audit.loading')}</li></ul>
      </section>
      <aside class="page-side" aria-labelledby="vuln-title">
        <section class="section">
          <h2 id="vuln-title">${_('security_audit.vuln_title')}</h2>
          <p class="count-line" id="vuln-summary"></p>
          <div id="vuln-list"></div>
        </section>
      </aside>
    </div>
  </div>

  <!-- Your console sign-in sessions -->
  <section class="secaudit-panel section" id="panel-sessions" role="tabpanel" aria-labelledby="tab-sessions" ${tab === 'sessions' ? '' : 'hidden'}>
    <p class="section-note secaudit-note">${_('security_audit.sessions_hint')}</p>
    <div class="toolbar">
      <p class="count-line" id="session-policy-summary"></p>
      <div class="toolbar-end"><button type="button" class="btn" id="sessions-refresh"><span class="material-icons" aria-hidden="true">refresh</span>${_('security_audit.refresh')}</button></div>
    </div>
    <div class="table-scroll">
      <table class="data-table secaudit-table secaudit-stack">
        <thead>
          <tr>
            <th scope="col">${_('security_audit.col_status')}</th>
            <th scope="col">${_('security_audit.col_ip')}</th>
            <th scope="col">${_('security_audit.col_started')}</th>
            <th scope="col">${_('security_audit.col_last_activity')}</th>
            <th scope="col">${_('security_audit.col_ended')}</th>
            <th scope="col">${_('security_audit.col_reason')}</th>
            <th scope="col">${_('security_audit.col_user_agent')}</th>
          </tr>
        </thead>
        <tbody id="sessions-tbody"><tr><td colspan="7" class="state-cell">${_('security_audit.loading')}</td></tr></tbody>
      </table>
    </div>
  </section>
  </div>
</div>
` }) %>
