<%- include('layouts/main', {
    title: _('nav.keys'),
    uiReworked: true,
    pageStyles: ['ui/keys'],
    pageScripts: ['keys'],
    currentPage: 'keys',
    breadcrumb: [{ label: _('nav.keys') }],
    body: `
        <div class="page keys-page">
            <div class="page-head">
                <h1>${_('nav.keys')}</h1>
                <p class="page-description">${_('keys.page_description')}</p>
            </div>

            <!-- Values to type into RustDesk: same rows and copy fields as the overview -->
            <section class="section" aria-labelledby="keys-values-title">
                <div class="section-head"><h2 id="keys-values-title">${_('keys.values_title')}</h2></div>
                <p class="section-note">${_('dashboard.client_config_hint')}</p>
                <p class="notice warning" id="keys-local-warning" hidden>
                    ${_('keys.local_warning')}
                    <a href="/settings#public-endpoints">${_('dashboard.client_host_settings_link')}</a>
                </p>

                <dl class="facts keys-facts">
                    <dt>${_('dashboard.config_server_id')}</dt>
                    <dd><span class="value-field"><code id="server-ip">…</code><button type="button" data-copy-target="server-ip" aria-label="${_('actions.copy')} ${_('dashboard.config_server_id')}">${_('actions.copy')}</button></span></dd>
                    <dt>${_('dashboard.config_relay_server')}</dt>
                    <dd><span class="value-field"><code id="relay-ip">…</code><button type="button" data-copy-target="relay-ip" aria-label="${_('actions.copy')} ${_('dashboard.config_relay_server')}">${_('actions.copy')}</button></span></dd>
                    <dt>${_('dashboard.config_api_server')}</dt>
                    <dd><span class="value-field"><code id="api-url">…</code><button type="button" data-copy-target="api-url" aria-label="${_('actions.copy')} ${_('dashboard.config_api_server')}">${_('actions.copy')}</button></span></dd>
                    <dt>${_('dashboard.config_key')}</dt>
                    <dd><span class="value-field"><code class="public-key-text is-masked" id="public-key-text">…</code><button type="button" id="reveal-key-btn" aria-label="${_('actions.show_value')} ${_('dashboard.config_key')}" aria-pressed="false"><span class="btn-label">${_('actions.show_value')}</span></button><button type="button" id="copy-key-btn" aria-label="${_('actions.copy')} ${_('dashboard.config_key')}">${_('actions.copy')}</button></span></dd>
                    <dt>${_('keys.server_api_key')}</dt>
                    <dd><span class="mono" id="api-key">…</span><span class="keys-fact-hint">${_('keys.server_api_key_hint')}</span></dd>
                </dl>

                <ul class="list keys-downloads">
                    <li class="list-row">
                        <span class="row-main">
                            <span class="row-title">${_('keys.download_title')}</span>
                            <span class="row-sub">${_('keys.download_hint')}</span>
                        </span>
                        <span class="row-end"><button type="button" class="btn" id="download-key-btn">${_('keys.download')}</button></span>
                    </li>
                    <li><a href="https://github.com/rustdesk/rustdesk/releases/latest" class="list-row" target="_blank" rel="noopener noreferrer">
                        <span class="row-main"><span class="row-title">${_('dashboard.get_rustdesk')}</span><span class="row-sub">${_('dashboard.get_rustdesk_hint')}</span></span>
                        <span class="material-icons row-chevron" aria-hidden="true">open_in_new</span>
                    </a></li>
                </ul>
            </section>

            <!-- The same values as a code the RustDesk phone app can scan -->
            <section class="section" aria-labelledby="keys-qr-title">
                <div class="section-head"><h2 id="keys-qr-title">${_('keys.qr_title')}</h2></div>
                <p class="section-note">${_('keys.qr_hint')}</p>
                <p class="notice warning" id="keys-qr-warning" hidden>${_('keys.qr_unreachable_host')}</p>
                <div class="keys-qr" id="qr-wrapper" aria-live="polite">
                    <p class="state">${_('keys.qr_loading')}</p>
                </div>
            </section>
        </div>
    `
}) %>
