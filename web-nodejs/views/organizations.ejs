<%
    const can = (perm) => typeof hasPermission === 'function' && hasPermission(perm);
%>
<%- include('layouts/main', {
    title: _('nav.organizations'),
    uiReworked: true,
    pageStyles: ['ui/organizations'],
    pageScripts: ['organizations'],
    currentPage: 'organizations',
    breadcrumb: [{ label: _('nav.organizations') }],
    body: `
        <div class="page page-wide org-page" data-can-edit="${can('org.edit')}" data-can-delete="${can('org.delete')}">
            <div class="page-head">
                <h1>${_('nav.organizations')}</h1>
                ${can('org.create') ? `<div class="page-actions">
                    <button type="button" class="btn btn-primary" id="create-org-btn"><span class="material-icons" aria-hidden="true">add</span>${_('organizations.create')}</button>
                </div>` : ''}
                <p class="page-description">${_('organizations.page_description')}</p>
            </div>

            <section class="section" aria-labelledby="org-list-title">
                <h2 id="org-list-title" class="sr-only">${_('nav.organizations')}</h2>
                <p class="count-line" id="org-count-line" aria-live="polite"></p>
                <div class="table-scroll">
                    <table class="data-table org-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('organizations.name')}</th>
                                <th scope="col" class="num-col is-num">${_('organizations.users')}</th>
                                <th scope="col" class="num-col is-num">${_('organizations.devices')}</th>
                                <th scope="col">${_('organizations.created')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="org-list">
                            <tr><td colspan="5" class="state-cell" id="org-loading">${_('organizations.loading_list')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    `
}) %>
