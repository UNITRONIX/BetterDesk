<%
    // Inline data for remote-guest.js; "<" is escaped so a label cannot close the script tag
    const guestJson = (v) => JSON.stringify(v).replace(/</g, '\\u003c');
%><%- include('layouts/remote-desk', {
    title: typeof title !== 'undefined' ? title : _('guest_access.title'),
    pageStyles: ['ui/remote'],
    pageScripts: ['remote-guest'],
    body: `
<div class="rd-desk-app rd-guest-app" id="rd-guest-app">
    <header class="rd-desk-header">
        <span class="rd-desk-brand">
            <span class="rd-desk-logo" id="rd-desk-logo" aria-hidden="true"></span>
            <span class="rd-desk-brand-name">${String(appName).replace(/&/g, "&amp;").replace(/</g, "&lt;")}</span>
        </span>
    </header>

    <main class="page rd-desk-page">
        <div class="page-head">
            <h1 class="rd-desk-title">${_('guest_access.title')}</h1>
            <p class="page-description rd-desk-subtitle" id="rd-guest-subtitle">${_('guest_access.subtitle')}</p>
        </div>

        <dl class="facts rd-guest-facts" id="rd-guest-banner" hidden>
            <dt id="rd-guest-label-term" hidden>${_('guest_access.fact_link')}</dt>
            <dd id="rd-guest-label" hidden></dd>
            <dt>${_('guest_access.expires')}</dt>
            <dd id="rd-guest-expiry">—</dd>
            <dt>${_('guest_access.fact_access')}</dt>
            <dd id="rd-guest-access"></dd>
        </dl>

        <section class="section" aria-labelledby="rd-guest-devices-title">
            <h2 id="rd-guest-devices-title">${_('guest_access.devices')}</h2>
            <p class="state" id="rd-guest-loading">${_('remote_dashboard.loading')}</p>
            <p class="state is-error" id="rd-guest-error" hidden></p>
            <p class="state" id="rd-guest-empty" hidden>${_('guest_access.empty')}</p>
            <div class="table-scroll" id="rd-guest-grid" hidden>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">${_('remote_dashboard.col_name')}</th>
                            <th scope="col">${_('remote_dashboard.col_id')}</th>
                            <th scope="col">${_('remote_dashboard.col_status')}</th>
                            <th scope="col" class="actions"><span class="sr-only">${_('remote.actions')}</span></th>
                        </tr>
                    </thead>
                    <tbody id="rd-guest-tbody"></tbody>
                </table>
            </div>
        </section>
    </main>
</div>
<script nonce="${cspNonce}">
    window.__guestAccess = ` + guestJson(typeof guestMeta !== 'undefined' ? guestMeta : {}) + `;
    window.__guestToken = ` + guestJson(typeof guestToken !== 'undefined' ? guestToken : '') + `;
</script>
`
}); %>
