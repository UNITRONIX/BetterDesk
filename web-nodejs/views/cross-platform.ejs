<%
    const cpTabs = ['matrix', 'distribution', 'protocols', 'limitations'];
    const tab = cpTabs.includes(activeTab) ? activeTab : 'matrix';
    const tabLabels = {
        matrix: _('cross_platform.tab_matrix'),
        distribution: _('cross_platform.tab_distribution'),
        protocols: _('cross_platform.tab_protocols'),
        limitations: _('cross_platform.tab_limitations')
    };
    const platforms = ['windows', 'linux_x86', 'linux_arm', 'macos', 'android', 'ios', 'web', 'chromeos'];
%>
<%- include('layouts/main', {
    title: _('nav.cross_platform'),
    uiReworked: true,
    pageStyles: ['ui/cross-platform'],
    pageScripts: pageScripts,
    currentPage: currentPage,
    breadcrumb: [{ label: _('nav.cross_platform') }],
    body: `
<div class="page page-wide crossplatform-page">
    <div class="page-head">
        <h1>${_('nav.cross_platform')}</h1>
        <p class="page-description">${_('cross_platform.page_description')}</p>
    </div>

    <div class="cp-body">
    <div class="tabs" role="tablist" aria-label="${_('nav.cross_platform')}">
        ${cpTabs.map(id => `<button type="button" class="tab crossplatform-tab ${tab === id ? 'active' : ''}" role="tab" id="tab-${id}" aria-controls="panel-${id}" aria-selected="${tab === id}" tabindex="${tab === id ? '0' : '-1'}" data-tab="${id}" data-bd-call="CrossPlatform.switchTab" data-bd-args='["${id}"]'>${tabLabels[id]}</button>`).join('')}
    </div>

    <!-- Which feature works on which system -->
    <section class="crossplatform-panel section" id="panel-matrix" role="tabpanel" aria-labelledby="tab-matrix" ${tab === 'matrix' ? '' : 'hidden'}>
        <p class="section-note cp-note">${_('cross_platform.matrix_hint')}</p>
        <div class="table-scroll cp-matrix-scroll" tabindex="0" role="region" aria-labelledby="tab-matrix">
            <table class="data-table cp-matrix" id="matrix-table">
                <caption class="sr-only">${_('cross_platform.matrix_caption')}</caption>
                <thead>
                    <tr>
                        <th scope="col">${_('cross_platform.col_feature')}</th>
                        ${platforms.map(p => `<th scope="col">${_('cross_platform.platform_' + p)}</th>`).join('')}
                    </tr>
                </thead>
                <tbody id="matrix-body"></tbody>
            </table>
        </div>
        <dl class="cp-legend">
            <div><dt>${_('cross_platform.value_full')}</dt><dd>${_('cross_platform.legend_full_desc')}</dd></div>
            <div><dt>${_('cross_platform.value_partial')}</dt><dd>${_('cross_platform.legend_partial_desc')}</dd></div>
            <div><dt>${_('cross_platform.value_none')}</dt><dd>${_('cross_platform.legend_none_desc')}</dd></div>
            <div><dt>${_('cross_platform.value_planned')}</dt><dd>${_('cross_platform.legend_planned_desc')}</dd></div>
        </dl>
    </section>

    <!-- What the registered devices run -->
    <div class="crossplatform-panel" id="panel-distribution" role="tabpanel" aria-labelledby="tab-distribution" ${tab === 'distribution' ? '' : 'hidden'}>
        <p class="count-line" id="summary-grid" aria-live="polite">${_('cross_platform.loading')}</p>
        <section class="section" aria-labelledby="platform-dist-title" id="platform-dist-card">
            <h2 id="platform-dist-title">${_('cross_platform.platform_breakdown')}</h2>
            <div id="platform-chart"></div>
        </section>
        <section class="section" aria-labelledby="version-dist-title" id="version-dist-card">
            <h2 id="version-dist-title">${_('cross_platform.version_breakdown')}</h2>
            <p class="section-note">${_('cross_platform.version_note')}</p>
            <div id="version-chart"></div>
        </section>
        <section class="section" aria-labelledby="arch-dist-title" id="arch-dist-card">
            <h2 id="arch-dist-title">${_('cross_platform.arch_breakdown')}</h2>
            <div id="arch-chart"></div>
        </section>
    </div>

    <!-- How clients tell the server what they can do -->
    <div class="crossplatform-panel" id="panel-protocols" role="tabpanel" aria-labelledby="tab-protocols" ${tab === 'protocols' ? '' : 'hidden'}>
        <section class="section" aria-labelledby="proto-title">
            <h2 id="proto-title">${_('cross_platform.capability_negotiation')}</h2>
            <p class="section-note">${_('cross_platform.protocols_hint')}</p>
            <div class="cp-diagram" id="proto-diagram" tabindex="0" role="region" aria-labelledby="proto-title">
                <svg id="proto-svg" viewBox="0 0 660 120" role="img" aria-label="${_('cross_platform.diagram_label')}"></svg>
            </div>
        </section>
        <section class="section" aria-labelledby="codec-title">
            <h2 id="codec-title">${_('cross_platform.codec_support')}</h2>
            <div id="codec-bars"></div>
            <p class="state" id="codec-empty" hidden>${_('cross_platform.no_codec_data')}</p>
        </section>
        <section class="section" aria-labelledby="feature-title">
            <h2 id="feature-title">${_('cross_platform.feature_support')}</h2>
            <div id="feature-bars"></div>
            <p class="state" id="feature-empty" hidden>${_('cross_platform.no_feature_data')}</p>
        </section>
        <section class="section" aria-labelledby="schema-title">
            <h2 id="schema-title">${_('cross_platform.protobuf_schema')}</h2>
            <p class="section-note">${_('cross_platform.schema_note')}</p>
            <pre class="code-block"><code>message ClientCapabilities {
    bool   can_capture_screen  = 1;
    bool   can_inject_input    = 2;
    bool   can_transfer_files  = 3;
    bool   can_capture_audio   = 4;
    bool   supports_clipboard  = 5;
    repeated string supported_codecs   = 6;
    string platform            = 7;
    string arch                = 8;
    string client_version      = 9;
    repeated string supported_features = 10;
}</code></pre>
        </section>
    </div>

    <!-- Known limits per system -->
    <section class="crossplatform-panel section" id="panel-limitations" role="tabpanel" aria-labelledby="tab-limitations" ${tab === 'limitations' ? '' : 'hidden'}>
        <p class="section-note cp-note">${_('cross_platform.limitations_hint')}</p>
        <div class="cp-limits" id="limitations-grid"></div>
    </section>
    </div>
</div>
` }) %>
