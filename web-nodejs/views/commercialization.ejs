<%
    const tab = (typeof activeTab !== 'undefined' && activeTab === 'sessions') ? 'sessions' : 'packages';
    const canManage = typeof hasPermission === 'function' && hasPermission('billing.manage');
    const canExport = typeof hasPermission === 'function' && hasPermission('billing.export');
    const openSettings = typeof openBillingSettings !== 'undefined' && openBillingSettings;
%>
<%- include('layouts/main', {
    title: title,
    uiReworked: true,
    pageStyles: ['ui/commercialization'],
    pageScripts: ['commercialization'],
    currentPage: currentPage,
    breadcrumb: breadcrumb,
    body: `
<div class="page page-wide commercialization-page" data-active-tab="${tab}" data-open-settings="${openSettings ? '1' : '0'}">
    <div class="page-head">
        <h1>${_('commercialization.tabs.' + tab)}</h1>
        ${tab === 'packages' && canManage ? `
        <div class="page-actions">
            <button type="button" class="btn btn-primary" id="btn-new-package"><span class="material-icons" aria-hidden="true">add</span>${_('commercialization.packages.new')}</button>
        </div>` : ''}
        <p class="page-description">${_('commercialization.ui.' + tab + '_description')}
            <a href="/commercialization?tab=${tab === 'packages' ? 'sessions' : 'packages'}">${_('commercialization.tabs.' + (tab === 'packages' ? 'sessions' : 'packages'))}</a></p>
    </div>

    <p id="timesync-banner" class="notice warning" hidden></p>

    ${tab === 'packages' ? `
    <div class="page-cols">
    <div class="page-main">
        <section class="section" id="tab-packages" aria-labelledby="packages-title">
            <div class="section-head"><h2 id="packages-title">${_('commercialization.packages.heading')}</h2></div>
            <div class="toolbar">
                <div class="toolbar-search search-wrapper">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input type="search" id="filter-package-search" class="form-input" aria-label="${_('commercialization.ui.search_packages')}" placeholder="${_('commercialization.ui.search_packages')}">
                </div>
            </div>
            <div class="table-scroll">
                <table class="data-table" id="packages-table">
                    <thead>
                        <tr>
                            <th>${_('commercialization.packages.name')}</th>
                            <th>${_('commercialization.preview.company')}</th>
                            <th class="is-num">${_('commercialization.preview.devices')}</th>
                            <th class="is-num">${_('commercialization.ui.included_time')}</th>
                            <th>${_('commercialization.ui.used_this_month')}</th>
                            <th class="is-num">${_('commercialization.packages.overage_rate')}</th>
                            <th class="actions"><span class="sr-only">${_('commercialization.contracts.actions')}</span></th>
                        </tr>
                    </thead>
                    <tbody><tr><td colspan="7" class="state-cell">${_('commercialization.ui.loading_packages')}</td></tr></tbody>
                </table>
            </div>
        </section>

        <section class="section" aria-labelledby="contracts-title">
            <div class="section-head"><h2 id="contracts-title">${_('commercialization.contracts.assignments_title')}</h2>${canManage ? `
                <button type="button" class="btn btn-sm" id="btn-new-contract"><span class="material-icons" aria-hidden="true">add</span>${_('commercialization.contracts.new')}</button>` : ''}</div>
            <p class="section-note">${_('commercialization.ui.assignments_note')}</p>
            <div class="toolbar">
                <div class="toolbar-search search-wrapper">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input type="search" id="filter-contract-search" class="form-input" aria-label="${_('commercialization.ui.search_assignments')}" placeholder="${_('commercialization.ui.search_assignments')}">
                </div>
                <select id="filter-contract-status" class="form-select" aria-label="${_('commercialization.contracts.status')}">
                    <option value="">${_('commercialization.filters.all_statuses')}</option>
                    <option value="active">${_('commercialization.status.active')}</option>
                    <option value="suspended">${_('commercialization.status.suspended')}</option>
                </select>
                <input type="hidden" id="filter-contract-type" value="">
            </div>
            <div class="table-scroll">
                <table class="data-table" id="contracts-table">
                    <thead>
                        <tr>
                            <th>${_('commercialization.contracts.target')}</th>
                            <th>${_('commercialization.contracts.package')}</th>
                            <th class="is-num">${_('commercialization.preview.remaining')}</th>
                            <th>${_('commercialization.contracts.status')}</th>
                            <th>${_('commercialization.contracts.validity')}</th>
                            <th class="actions"><span class="sr-only">${_('commercialization.contracts.actions')}</span></th>
                        </tr>
                    </thead>
                    <tbody><tr><td colspan="6" class="state-cell">${_('commercialization.ui.loading_assignments')}</td></tr></tbody>
                </table>
            </div>
        </section>
    </div>

    <aside class="page-side" aria-labelledby="billing-explain-title">
        <div class="section billing-explain">
            <div class="section-head"><h2 id="billing-explain-title">${_('commercialization.ui.explain_title')}</h2></div>
            <p>${_('commercialization.ui.explain_text')}</p>
        </div>

        <details class="disclosure section" id="billing-settings-panel"${openSettings ? ' open' : ''}>
            <summary><h2>${_('commercialization.ui.settings_title')}</h2></summary>
            <p class="section-note">${_('commercialization.ui.settings_note')}</p>
            <p><a href="/settings?tab=time">${_('commercialization.clock.open_time_settings')}</a></p>
            <form id="email-notifications-form" class="form-column billing-notifications"${canManage ? ' data-save-form' : ''}>
                <h3>${_('commercialization.notifications.title')}</h3>
                <p class="form-hint">${_('commercialization.notifications.desc')}</p>
                <p id="email-smtp-status" class="smtp-status-line"></p>
                <p><a href="/settings?tab=email">${_('commercialization.notifications.smtp_link')}</a></p>
                <label class="check-field"><input type="checkbox" id="notif-help-requests-enabled" aria-controls="notif-help-options" aria-expanded="true"${canManage ? '' : ' disabled'}><span class="check-label">${_('commercialization.notifications.help_requests_enabled')}</span></label>
                <div class="billing-notif-options" id="notif-help-options">
                    <label class="check-field"><input type="checkbox" id="notif-assigned-operators"${canManage ? '' : ' disabled'}><span class="check-label">${_('commercialization.notifications.notify_assigned_operators')}</span></label>
                    <label class="check-field"><input type="checkbox" id="notif-fallback-alert"${canManage ? '' : ' disabled'}><span class="check-label">${_('commercialization.notifications.fallback_alert_email')}</span></label>
                    <label class="check-field"><input type="checkbox" id="notif-folder-subject"${canManage ? '' : ' disabled'}><span class="check-label">${_('commercialization.notifications.include_folder_in_subject')}</span></label>
                </div>
                <p class="field-effect">${_('commercialization.ui.applies_now')}</p>
                ${canManage ? `
                <div class="save-bar">
                    <span class="save-status" id="email-notifications-status" data-save-status aria-live="polite"></span>
                    <button type="submit" class="btn" id="btn-save-email-notifications" data-save-button>${_('commercialization.notifications.save')}</button>
                </div>` : ''}
            </form>
        </details>
    </aside>
    </div>
    ` : `
    <!-- What needs doing and how much included time is left, above the full-width table -->
    <div class="cols billing-summary">
        <section class="section" aria-labelledby="pending-title">
            <div class="section-head"><h2 id="pending-title">${_('commercialization.ui.pending_title')}</h2></div>
            <p class="section-note" id="pending-note">${_('commercialization.ui.pending_note')}</p>
            <ul class="list pending-list" id="pending-reports"><li class="list-row is-empty">${_('commercialization.ui.loading_sessions')}</li></ul>
        </section>

        <section class="section" aria-labelledby="usage-title">
            <div class="section-head"><h2 id="usage-title">${_('commercialization.ui.usage_title')}</h2></div>
            <p class="section-note">${_('commercialization.ui.usage_note')}</p>
            <ul class="list usage-list" id="contract-usage"><li class="list-row is-empty">${_('commercialization.ui.loading_assignments')}</li></ul>
        </section>
    </div>

    <section class="section" id="tab-sessions" aria-labelledby="sessions-title">
        <div class="section-head"><h2 id="sessions-title">${_('commercialization.ui.all_sessions_title')}</h2></div>
        <div class="toolbar session-filters">
            <div class="form-group">
                <label class="form-label" for="filter-session-org">${_('commercialization.filters.organization')}</label>
                <select id="filter-session-org" class="form-select"><option value="">${_('commercialization.filters.all_orgs')}</option></select>
            </div>
            <div class="form-group">
                <label class="form-label" for="filter-session-status">${_('commercialization.contracts.status')}</label>
                <select id="filter-session-status" class="form-select">
                    <option value="">${_('commercialization.filters.all_statuses')}</option>
                    <option value="active">${_('commercialization.status.active')}</option>
                    <option value="pending_report">${_('commercialization.status.pending_report')}</option>
                    <option value="closed">${_('commercialization.status.closed')}</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="filter-session-device">${_('commercialization.sessions.device')}</label>
                <input type="search" id="filter-session-device" class="form-input" autocomplete="off">
            </div>
            <div class="toolbar-end">
                <button type="button" class="btn" id="btn-refresh-sessions"><span class="material-icons" aria-hidden="true">refresh</span>${_('commercialization.actions.refresh')}</button>
                ${canExport ? `
                <span class="menu-anchor">
                    <button type="button" class="btn" id="btn-export-menu" data-menu-button aria-haspopup="menu" aria-expanded="false" aria-controls="export-menu">
                        <span class="material-icons" aria-hidden="true">download</span>${_('commercialization.ui.export')}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                    </button>
                    <span class="menu menu-end" id="export-menu" role="menu">
                        <button type="button" class="menu-item" role="menuitem" id="btn-export-sessions"><span class="material-icons" aria-hidden="true">download</span>${_('commercialization.ui.export_sessions_csv')}</button>
                        <button type="button" class="menu-item" role="menuitem" id="btn-export-reports-csv"><span class="material-icons" aria-hidden="true">download</span>${_('commercialization.ui.export_reports_csv')}</button>
                        <button type="button" class="menu-item" role="menuitem" id="btn-export-reports-pdf"><span class="material-icons" aria-hidden="true">download</span>${_('commercialization.ui.export_reports_pdf')}</button>
                    </span>
                </span>` : ''}
            </div>
        </div>
        <p class="notice warning" id="sessions-running-notice" hidden>${_('commercialization.ui.running_unreadable')}</p>
        <p class="count-line" id="sessions-count" aria-live="polite"></p>
        <div class="table-scroll">
            <table class="data-table" id="sessions-table">
                <thead>
                    <tr>
                        <th>${_('commercialization.sessions.device')}</th>
                        <th>${_('commercialization.sessions.operator')}</th>
                        <th>${_('commercialization.sessions.started')}</th>
                        <th>${_('commercialization.sessions.ended')}</th>
                        <th class="is-num">${_('commercialization.ui.billed_time')}</th>
                        <th>${_('commercialization.contracts.status')}</th>
                        <th>${_('commercialization.sessions.report')}</th>
                        <th class="actions"><span class="sr-only">${_('commercialization.contracts.actions')}</span></th>
                    </tr>
                </thead>
                <tbody><tr><td colspan="8" class="state-cell">${_('commercialization.ui.loading_sessions')}</td></tr></tbody>
            </table>
        </div>
        <input type="hidden" id="filter-report-org" value="">
    </section>
    `}
</div>

<template id="package-modal-template">
    <form id="package-form" class="form-stack" novalidate>
        <div class="form-group">
            <label class="form-label" for="package-name">${_('commercialization.packages.name')}</label>
            <input type="text" id="package-name" class="form-input" maxlength="128" required autocomplete="off" aria-describedby="package-name-hint">
            <p class="form-hint" id="package-name-hint">${_('commercialization.ui.package_name_hint')}</p>
        </div>
        <div class="form-group">
            <label class="form-label" for="package-description">${_('commercialization.packages.description')}</label>
            <textarea id="package-description" class="form-textarea" rows="3" maxlength="512" aria-describedby="package-description-hint"></textarea>
            <p class="form-hint" id="package-description-hint">${_('commercialization.ui.package_description_hint')}</p>
        </div>
        <section class="form-section" aria-labelledby="package-section-time">
            <h3 class="form-section-title" id="package-section-time">${_('commercialization.ui.included_time')}</h3>
            <div class="form-group">
                <div class="field-pair has-labels">
                    <div class="form-group">
                        <label class="form-label" for="package-amount">${_('commercialization.packages.included_amount')}</label>
                        <input type="number" id="package-amount" class="form-input is-short" value="10" min="0" step="1" required aria-describedby="package-amount-hint">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="package-unit">${_('commercialization.packages.unit')}</label>
                        <select id="package-unit" class="form-select is-medium">
                            <option value="hours">${_('commercialization.packages.unit_hours')}</option>
                            <option value="minutes">${_('commercialization.packages.unit_minutes')}</option>
                        </select>
                    </div>
                </div>
                <p class="form-hint" id="package-amount-hint">${_('commercialization.ui.included_hint')}</p>
            </div>
            <input type="hidden" id="package-minutes" value="600">
        </section>
        <section class="form-section" aria-labelledby="package-section-billing">
            <h3 class="form-section-title" id="package-section-billing">${_('commercialization.ui.section_billing')}</h3>
            <div class="form-group">
                <label class="form-label" for="package-rounding">${_('commercialization.packages.rounding')}</label>
                <select id="package-rounding" class="form-select is-medium" aria-describedby="package-rounding-hint" aria-controls="package-rounding-custom-wrap">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="custom">${_('commercialization.packages.rounding_custom')}</option>
                </select>
                <p class="form-hint" id="package-rounding-hint">${_('commercialization.ui.rounding_hint')}</p>
            </div>
            <div class="form-group" id="package-rounding-custom-wrap" hidden>
                <label class="form-label" for="package-rounding-custom">${_('commercialization.packages.rounding_custom_value')}</label>
                <input type="number" id="package-rounding-custom" class="form-input is-short" min="1" step="1" value="15">
            </div>
            <div class="form-group">
                <div class="field-pair has-labels">
                    <div class="form-group">
                        <label class="form-label" for="package-overage">${_('commercialization.packages.overage_rate')}</label>
                        <input type="number" id="package-overage" class="form-input is-medium" value="100" min="0" step="0.01" required aria-describedby="package-overage-hint">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="package-currency">${_('commercialization.packages.currency')}</label>
                        <input type="text" id="package-currency" class="form-input is-short" value="EUR" maxlength="8" required autocomplete="off" spellcheck="false" aria-describedby="package-overage-hint">
                    </div>
                </div>
                <p class="form-hint" id="package-overage-hint">${_('commercialization.ui.overage_hint')}</p>
            </div>
        </section>
        <button type="submit" hidden tabindex="-1" aria-hidden="true"></button>
    </form>
</template>

<template id="assign-modal-template">
    <form id="assign-form" class="form-stack" novalidate>
        <input type="hidden" id="assign-target-type" value="device_group">
        <div class="form-group">
            <label class="form-label" for="assign-target-select">${_('commercialization.targets.device_group')}</label>
            <select id="assign-target-select" class="form-select is-host" required aria-describedby="assign-target-hint"></select>
            <p class="form-hint" id="assign-target-hint">${_('commercialization.ui.assign_target_hint')}</p>
        </div>
        <div class="form-group">
            <label class="form-label" for="assign-package-select">${_('commercialization.contracts.package')}</label>
            <select id="assign-package-select" class="form-select is-host" required></select>
        </div>
        <section class="form-section" aria-labelledby="assign-section-rates" aria-describedby="assign-section-rates-note">
            <h3 class="form-section-title" id="assign-section-rates">${_('commercialization.ui.section_rates')}</h3>
            <p class="form-hint" id="assign-section-rates-note">${_('commercialization.ui.section_rates_note')}</p>
            <div class="form-group">
                <label class="form-label" for="assign-remaining">${_('commercialization.contracts.remaining')}</label>
                <input type="number" id="assign-remaining" class="form-input is-short" min="0" step="1" aria-describedby="assign-remaining-hint">
                <p class="form-hint" id="assign-remaining-hint">${_('commercialization.ui.remaining_hint')}</p>
            </div>
            <div class="form-group">
                <label class="form-label" for="assign-hourly-rate">${_('commercialization.contracts.hourly_rate')}</label>
                <input type="number" id="assign-hourly-rate" class="form-input is-short" min="0" step="0.01" aria-describedby="assign-hourly-rate-hint">
                <p class="form-hint" id="assign-hourly-rate-hint">${_('commercialization.ui.hourly_rate_hint')}</p>
            </div>
            <div class="form-group">
                <label class="form-label" for="assign-overage-rate">${_('commercialization.contracts.custom_overage')}</label>
                <input type="number" id="assign-overage-rate" class="form-input is-short" min="0" step="0.01" aria-describedby="assign-overage-rate-hint">
                <p class="form-hint" id="assign-overage-rate-hint">${_('commercialization.ui.overage_override_hint')}</p>
            </div>
        </section>
        <section class="form-section" aria-labelledby="assign-section-validity">
            <h3 class="form-section-title" id="assign-section-validity">${_('commercialization.contracts.validity')}</h3>
            <div class="form-group">
                <label class="form-label" for="assign-valid-from">${_('commercialization.contracts.valid_from')}</label>
                <input type="date" id="assign-valid-from" class="form-input is-medium">
            </div>
            <div class="form-group">
                <label class="form-label" for="assign-valid-until">${_('commercialization.contracts.valid_until')}</label>
                <input type="date" id="assign-valid-until" class="form-input is-medium" aria-describedby="assign-validity-hint">
                <p class="form-hint" id="assign-validity-hint">${_('commercialization.ui.validity_hint')}</p>
            </div>
        </section>
        <button type="submit" hidden tabindex="-1" aria-hidden="true"></button>
    </form>
</template>

<template id="package-preview-template">
    <div class="form-stack">
        <div class="form-group package-preview-period">
            <label class="form-label" for="package-preview-period">${_('commercialization.ui.preview_month')}</label>
            <div class="field-pair">
                <button type="button" class="btn btn-sm" id="btn-preview-prev-month">${_('commercialization.preview.prev_month')}</button>
                <select id="package-preview-period" class="form-select"></select>
                <button type="button" class="btn btn-sm" id="btn-preview-next-month">${_('commercialization.preview.next_month')}</button>
            </div>
        </div>
        <dl class="facts" id="package-preview-stats"></dl>
        <p class="form-hint">${_('commercialization.preview.hint')}</p>
    </div>
</template>

<template id="report-modal-template">
    <p class="form-hint" id="report-modal-session"></p>
    <div class="form-group">
        <label class="form-label" for="report-summary">${_('commercialization.report.summary')}</label>
        <textarea id="report-summary" class="form-textarea" rows="4" maxlength="2000" required></textarea>
    </div>
    <div class="form-group">
        <label class="form-label" for="report-category">${_('commercialization.report.category')}</label>
        <select id="report-category" class="form-select">
            <option value="">${_('commercialization.ui.category_none')}</option>
            <option value="software">${_('commercialization.ui.category_software')}</option>
            <option value="hardware">${_('commercialization.ui.category_hardware')}</option>
            <option value="network">${_('commercialization.ui.category_network')}</option>
            <option value="account">${_('commercialization.ui.category_account')}</option>
            <option value="other">${_('commercialization.ui.category_other')}</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label" for="report-ticket">${_('commercialization.report.ticket_ref')}</label>
        <input type="text" id="report-ticket" class="form-input is-medium" maxlength="64" autocomplete="off">
        <p class="form-hint">${_('commercialization.ui.optional_hint')}</p>
    </div>
    <p id="report-modal-error" class="form-status is-error" role="alert" hidden></p>
</template>
`
}) %>
