<%- include('layouts/main', {
    title: typeof title !== 'undefined' ? title : _('activity.title'),
    uiReworked: true,
    pageStyles: ['ui/activity'],
    pageScripts: ['activity'],
    currentPage: 'activity',
    breadcrumb: [{ label: _('nav.activity') }, { label: _('activity.title') }],
    body: `
    <div class="page page-wide activity-page">
        <div class="page-head">
            <h1>${_('activity.title')}</h1>
            <p class="page-description">${_('activity.page_description')}</p>
        </div>

        <div class="page-cols">
        <section class="section page-main" aria-labelledby="activity-list-title">
            <h2 id="activity-list-title" class="sr-only">${_('activity.title')}</h2>
            <div class="toolbar activity-toolbar">
                <div class="toolbar-search search-wrapper">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input type="search" class="form-input" id="activity-search" aria-label="${_('activity.search')}" placeholder="${_('activity.search')}">
                </div>
                <fieldset class="activity-range">
                    <legend class="sr-only">${_('activity.date_range')}</legend>
                    <label class="activity-date">
                        <span>${_('activity.filter_from')}</span>
                        <input type="date" class="form-input" id="activity-from">
                    </label>
                    <label class="activity-date">
                        <span>${_('activity.filter_to')}</span>
                        <input type="date" class="form-input" id="activity-to">
                    </label>
                </fieldset>
                <div class="toolbar-filters" role="group" aria-label="${_('activity.date_range')}" id="activity-presets">
                    <button type="button" class="filter-btn" data-days="7" aria-pressed="false">${_('activity.preset_7')}</button>
                    <button type="button" class="filter-btn" data-days="30" aria-pressed="false">${_('activity.preset_30')}</button>
                    <button type="button" class="filter-btn active" data-days="" aria-pressed="true">${_('activity.preset_all')}</button>
                </div>
                <div class="toolbar-end">
                    <button type="button" class="btn" id="activity-refresh-btn"><span class="material-icons" aria-hidden="true">refresh</span>${_('activity.refresh')}</button>
                </div>
            </div>
            <p class="count-line" id="activity-count" aria-live="polite"></p>
            <div class="table-scroll">
                <table class="data-table activity-table activity-stack">
                    <thead>
                        <tr>
                            <th scope="col">${_('activity.device')}</th>
                            <th scope="col">${_('activity.reported_at')}</th>
                            <th scope="col">${_('activity.active_time')}</th>
                            <th scope="col">${_('activity.idle_time')}</th>
                            <th scope="col">${_('activity.session_count')}</th>
                            <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                        </tr>
                    </thead>
                    <tbody id="activity-body">
                        <tr><td colspan="6" class="state-cell">${_('activity.loading')}</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Summary of the reports in the chosen range (public/js/activity.js renderSummary, loadTopApps) -->
        <aside class="page-side" aria-label="${_('activity.summary_label')}">
            <section class="section" aria-labelledby="activity-time-title">
                <h2 id="activity-time-title">${_('activity.active_idle_title')}</h2>
                <p id="activity-time-line" aria-live="polite">${_('activity.loading')}</p>
            </section>
            <section class="section" aria-labelledby="activity-apps-title">
                <h2 id="activity-apps-title">${_('activity.top_apps_all_title')}</h2>
                <p class="section-note" id="activity-apps-note"></p>
                <div id="activity-apps"><p class="state">${_('activity.loading')}</p></div>
            </section>
        </aside>
        </div>

        <template id="activity-detail-tpl">
            <div class="activity-detail">
                <section class="section" aria-labelledby="detail-apps-title">
                    <h3 id="detail-apps-title">${_('activity.top_apps')}</h3>
                    <div id="apps-list"><p class="state">${_('activity.loading')}</p></div>
                </section>
                <section class="section" aria-labelledby="detail-sessions-title">
                    <h3 id="detail-sessions-title">${_('activity.recent_sessions')}</h3>
                    <div id="sessions-list"><p class="state">${_('activity.loading')}</p></div>
                </section>
            </div>
        </template>
    </div>
    `
}) %>
