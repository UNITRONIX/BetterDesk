<%
/*
 * Account menu: the signed-in person, My status, password, two-factor
 * sign-in and Sign out. One partial for both places it appears:
 *   place 'sidebar': sidebar footer (avatar, name and role on the button,
 *                    opens upwards), shown while the sidebar is docked
 *   place 'topbar':  top bar account button (avatar or the account icon),
 *                    shown below 1100 px where the sidebar is a drawer
 * menu-button.js opens it; public/js/app.js handles the items and keeps
 * My status in step with the chat page (Utils.presence).
 */
const umPlace = typeof place === 'string' && place === 'topbar' ? 'topbar' : 'sidebar';
const umId = umPlace + '-user-menu';
const umT = (key, fallback) => { const v = _(key); return v && v !== key ? v : fallback; };
const umName = user ? String(user.username || '').trim() : '';
let umRole = '';
if (user && user.role) {
    const rk = 'users.role_' + user.role;
    umRole = _(rk);
    if (!umRole || umRole === rk) {
        umRole = String(user.role).replace(/_/g, ' ');
        umRole = umRole.charAt(0).toUpperCase() + umRole.slice(1);
    }
}
// Initials and colour: same rules as Utils.initials / Utils.avatarColor
const umWords = umName.split(/[\s._@-]+/)
    .map((w) => Array.from(w).filter((ch) => /[\p{L}\p{N}]/u.test(ch)))
    .filter((chars) => chars.length);
let umInitials = '';
if (umWords.length) {
    const picked = umWords.length > 1 ? umWords[0][0] + umWords[1][0] : umWords[0].slice(0, 2).join('');
    try { umInitials = picked.toLocaleUpperCase(typeof lang === 'string' ? lang : undefined); } catch (e) { umInitials = picked.toUpperCase(); }
    umInitials = Array.from(umInitials).slice(0, 2).join('');
}
let umHash = 0;
for (const ch of umName.toLowerCase()) umHash = (umHash * 31 + ch.codePointAt(0)) >>> 0;
const umColor = (umHash % 6) + 1;
const umSrc = user && /^\d+$/.test(String(user.id || '')) && typeof userAvatarVersion === 'string' && userAvatarVersion
    ? '/api/users/' + encodeURIComponent(user.id) + '/avatar?v=' + encodeURIComponent(userAvatarVersion) : '';
const umAvatar = (size) => {
    const cls = size ? ' is-' + size : '';
    if (umSrc) {
        return '<span class="avatar' + cls + '" aria-hidden="true" data-initials="' + escapeHtml(umInitials) + '" data-color="' + umColor + '"><img src="' + escapeHtml(umSrc) + '" alt=""></span>';
    }
    return '<span class="avatar' + cls + ' is-c' + umColor + '" aria-hidden="true">'
        + (umInitials ? escapeHtml(umInitials) : '<span class="material-icons" aria-hidden="true">person</span>') + '</span>';
};
// The avatar with my status on its corner (app.js keeps the dot in step)
const umWithPresence = (html) => '<span class="avatar-presence">' + html + '<span class="presence is-online" data-presence-dot aria-hidden="true"></span></span>';
const umStatuses = [
    ['online', umT('chat.presence_online', 'Online')],
    ['away', umT('chat.presence_away', 'Away')],
    ['busy', umT('chat.presence_busy', 'Busy')],
];
%>
<span class="menu-anchor user-menu-anchor is-<%= umPlace %>">
    <% if (umPlace === 'sidebar') { %>
    <button type="button" class="user-menu-btn" data-menu-button aria-haspopup="menu" aria-expanded="false" aria-controls="<%= umId %>">
        <%- umWithPresence(umAvatar('md')) %>
        <span class="user-menu-btn-text">
            <span class="user-menu-name"><%= umName %></span>
            <% if (umRole) { %><span class="user-menu-role"><%= umRole %></span><% } %>
            <span class="sr-only" data-presence-text><%= umStatuses[0][1] %></span>
        </span>
        <span class="material-icons user-menu-chevron" aria-hidden="true">expand_less</span>
    </button>
    <% } else { %>
    <button type="button" class="ux35-topbar-btn ux35-user-btn" id="user-btn" data-menu-button aria-haspopup="menu" aria-expanded="false"
            aria-controls="<%= umId %>" title="<%= umName %>" aria-label="<%= umName %>">
        <%- umWithPresence(umSrc ? umAvatar('') : '<span class="material-icons" aria-hidden="true">account_circle</span>') %>
    </button>
    <% } %>
    <div class="menu user-menu<%= umPlace === 'sidebar' ? ' menu-up' : ' menu-end' %>" id="<%= umId %>">
        <div class="user-menu-person">
            <%- umWithPresence(umAvatar('md')) %>
            <span class="user-menu-btn-text">
                <span class="user-menu-name"><%= umName %></span>
                <% if (umRole) { %><span class="user-menu-role"><%= umRole %></span><% } %>
            </span>
        </div>
        <div role="menu" aria-label="<%= umT('user_menu.label', 'Account') %>">
            <div role="group" aria-labelledby="<%= umId %>-status">
                <div class="menu-label" id="<%= umId %>-status"><%= umT('chat.my_presence', 'My status') %></div>
                <% umStatuses.forEach(function (s) { %>
                <button type="button" class="menu-item" role="menuitemradio" aria-checked="<%= s[0] === 'online' ? 'true' : 'false' %>" data-presence="<%= s[0] %>">
                    <span class="presence is-<%= s[0] %>" aria-hidden="true"></span><span><%= s[1] %></span><span class="material-icons user-menu-check" aria-hidden="true"><%= s[0] === 'online' ? 'check' : '' %></span>
                </button>
                <% }); %>
            </div>
            <div class="menu-divider" role="separator"></div>
            <button type="button" class="menu-item" role="menuitem" data-user-action="change-password"><%= umT('auth.change_password', 'Change password') %></button>
            <a class="menu-item" role="menuitem" href="/settings?tab=auth"><%= umT('nav.account_2fa', 'Two-factor sign-in') %></a>
            <div class="menu-divider" role="separator"></div>
            <button type="button" class="menu-item" role="menuitem" data-user-action="logout"><%= umT('user_menu.sign_out', 'Sign out') %></button>
        </div>
    </div>
</span>
