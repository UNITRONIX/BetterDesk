<%#
    Theme bootstrap for <head>, before first paint.
    - The console-wide theme (Settings › Appearance) is the default.
    - Each browser may override it with Light or Dark from the top bar
      (localStorage "bd-theme-choice"); that choice only affects this browser.
    - In "system" mode the server cannot know the OS setting, so this follows it.
%>
<script nonce="<%= cspNonce %>">
(function () {
    var root = document.documentElement;
    var palettes = <%- JSON.stringify(typeof themePalettes !== 'undefined' && themePalettes ? { light: themePalettes.light || null, dark: themePalettes.dark || null } : {}) %>;
    var VARS = {
        bgPrimary: '--bg-primary', bgSecondary: '--bg-secondary', bgTertiary: '--bg-tertiary',
        bgElevated: '--bg-elevated', textPrimary: '--text-primary', textSecondary: '--text-secondary',
        accentBlue: '--accent-blue', accentBlueHover: '--accent-blue-hover', accentBlueMuted: '--accent-blue-muted',
        accentGreen: '--accent-green', accentGreenHover: '--accent-green-hover', accentGreenMuted: '--accent-green-muted',
        accentRed: '--accent-red', accentRedHover: '--accent-red-hover', accentRedMuted: '--accent-red-muted',
        accentYellow: '--accent-yellow', accentYellowHover: '--accent-yellow-hover', accentYellowMuted: '--accent-yellow-muted',
        accentPurple: '--accent-purple', accentPurpleHover: '--accent-purple-hover', accentPurpleMuted: '--accent-purple-muted',
        borderPrimary: '--border-primary', borderSecondary: '--border-secondary'
    };
    var choice = null;
    try { choice = localStorage.getItem('bd-theme-choice'); } catch (e) { choice = null; }
    if ((choice === 'light' || choice === 'dark') && palettes[choice]) {
        root.setAttribute('data-theme-default', root.getAttribute('data-theme-mode') || 'system');
        root.setAttribute('data-theme-mode', choice);
        root.setAttribute('data-theme', choice);
        root.style.colorScheme = choice;
        var p = palettes[choice];
        for (var k in VARS) { if (p[k]) root.style.setProperty(VARS[k], p[k]); }
        return;
    }
    if (root.getAttribute('data-theme-mode') !== 'system' || !window.matchMedia) return;
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    function apply() {
        if (root.getAttribute('data-theme-mode') !== 'system') return;
        root.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
    }
    apply();
    if (mq.addEventListener) mq.addEventListener('change', apply);
})();
</script>
