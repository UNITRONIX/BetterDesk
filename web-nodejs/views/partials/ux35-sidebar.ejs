<%
    const navState = typeof consoleNav !== 'function' ? { sections: [] } : consoleNav({
        currentPage: typeof currentPage !== 'undefined' ? currentPage : '',
        currentTab: typeof currentTab !== 'undefined' ? currentTab : '',
        activateAgentNav: typeof activateAgentNav !== 'undefined' && activateAgentNav
    });
    var _roleKey = user && user.role ? ('users.role_' + user.role) : 'users.role_admin';
    var _roleLabel = _(_roleKey);
    if (!_roleLabel || _roleLabel === _roleKey) {
        _roleLabel = user && user.role ? user.role.replace(/_/g, ' ') : 'admin';
        _roleLabel = _roleLabel.charAt(0).toUpperCase() + _roleLabel.slice(1);
    }
%>
<aside class="ux35-sidebar" id="ux35-sidebar" aria-label="<%= _('nav.main') %>">
    <div class="ux35-sidebar-resize" id="ux35-sidebar-resize"
         role="separator" aria-orientation="vertical" tabindex="0"
         aria-label="<%= _('ux35.resize_sidebar') %>"
         aria-valuemin="200" aria-valuemax="320" aria-valuenow="232"
         title="<%= _('ux35.resize_sidebar') %>"></div>
    <nav class="ux35-sidebar-nav" id="ux35-sidebar-nav">
        <% navState.sections.forEach(function(section) { %>
        <div class="ux35-sidebar-section<%= section.active ? ' is-current' : ' is-collapsed' %>" data-panel="<%= section.id %>">
            <button type="button" class="ux35-sidebar-heading ux35-sidebar-heading-toggle"
                    aria-expanded="<%= section.active ? 'true' : 'false' %>"
                    aria-controls="nav-section-<%= section.id %>">
                <span><%= section.text %></span>
                <span class="material-icons ux35-section-chevron" aria-hidden="true"><%= section.active ? 'expand_less' : 'expand_more' %></span>
            </button>
            <ul class="nav-list" id="nav-section-<%= section.id %>">
                <% section.pages.forEach(function(item) { %>
                <li>
                    <a href="<%= item.href %>"
                       class="ux35-sidebar-item<%= item.active ? ' active' : '' %><%= item.sub ? ' is-sub' : '' %>"
                       <% if (item.id) { %>id="<%= item.id %>"<% } %>
                       <% if (item.active) { %>aria-current="page"<% } %>
                       <% if (item.external) { %>target="_blank" rel="noopener noreferrer" title="<%= _('nav.remote_open_tab') %>"<% } %>>
                        <span class="nav-label"><%= item.text %></span>
                        <% if (item.beta) { %><span class="nav-note"><%= _('ux35.beta_badge') %></span><% } %>
                        <% if (item.external) { %><span class="nav-note" aria-hidden="true">↗</span><% } %>
                        <% if (item.countId) { %><span class="nav-count" id="<%= item.countId %>" style="display: none;">0</span><% } %>
                    </a>
                </li>
                <% }); %>
            </ul>
        </div>
        <% }); %>
        <div class="ux35-sidebar-section nav-help">
            <button type="button" class="ux35-sidebar-heading" id="ux35-help-btn" aria-haspopup="dialog">
                <span><%= _('nav.help') %></span>
            </button>
        </div>
    </nav>

    <div class="ux35-sidebar-footer">
        <div class="ux35-sidebar-user" id="user-menu-trigger">
            <span class="ux35-sidebar-user-name"><%= user ? user.username : '' %></span>
            <span class="ux35-sidebar-user-role"><%= _roleLabel %></span>
        </div>
        <% if ((branding && branding.footerText) || (branding && branding.showPoweredBy !== 'false')) { %>
        <div class="ux35-sidebar-attribution">
            <% if (branding.footerText) { %><span><%= branding.footerText %></span><% } %>
            <% if (branding.showPoweredBy !== 'false') { %><span><%= _('branding.powered_by') %> BetterDesk</span><% } %>
        </div>
        <% } %>
    </div>
</aside>
<div class="ux35-sidebar-overlay" id="ux35-sidebar-overlay" hidden></div>
