<%
    const navState = typeof consoleNav !== 'function' ? { sections: [] } : consoleNav({
        currentPage: typeof currentPage !== 'undefined' ? currentPage : '',
        currentTab: typeof currentTab !== 'undefined' ? currentTab : '',
        activateAgentNav: typeof activateAgentNav !== 'undefined' && activateAgentNav
    });
    var _roleKey = user && user.role ? ('users.role_' + user.role) : 'users.role_admin';
    var _roleLabel = _(_roleKey);
    if (!_roleLabel || _roleLabel === _roleKey) {
        _roleLabel = user && user.role ? user.role.replace(/_/g, ' ') : 'admin';
        _roleLabel = _roleLabel.charAt(0).toUpperCase() + _roleLabel.slice(1);
    }
%>
<aside class="ux35-sidebar" id="ux35-sidebar" aria-label="<%= _('nav.main') %>">
    <div class="ux35-sidebar-resize" id="ux35-sidebar-resize"
         role="separator" aria-orientation="vertical" tabindex="0"
         aria-label="<%= _('ux35.resize_sidebar') %>"
         aria-valuemin="200" aria-valuemax="320" aria-valuenow="232"
         title="<%= _('ux35.resize_sidebar') %>"></div>
    <nav class="ux35-sidebar-nav" id="ux35-sidebar-nav">
        <% navState.sections.forEach(function(section) { %>
        <div class="ux35-sidebar-section<%= section.active ? ' is-current' : ' is-collapsed' %>" data-panel="<%= section.id %>">
            <button type="button" class="ux35-sidebar-heading ux35-sidebar-heading-toggle"
                    aria-expanded="<%= section.active ? 'true' : 'false' %>"
                    aria-controls="nav-section-<%= section.id %>">
                <span class="material-icons nav-section-icon" aria-hidden="true"><%= section.icon %></span>
                <span class="nav-section-label"><%= section.text %></span>
                <span class="material-icons ux35-section-chevron" aria-hidden="true"><%= section.active ? 'expand_less' : 'expand_more' %></span>
            </button>
            <%
                // Pages used every day stay visible; the rest sit under "More".
                // A section with no core page, or only one extra, shows everything.
                var corePages = section.pages.filter(function (p) { return p.core; });
                var morePages = section.pages.filter(function (p) { return !p.core; });
                if (!corePages.length || morePages.length <= 1) { corePages = section.pages; morePages = []; }
                var moreOpen = morePages.some(function (p) { return p.active; });
            %>
            <ul class="nav-list" id="nav-section-<%= section.id %>">
                <% corePages.forEach(function(item) { %>
                <%- include('nav-item', { item: item, t: _ }) %>
                <% }); %>
                <% if (morePages.length) { %>
                <li class="nav-more<%= moreOpen ? ' is-current' : '' %>" data-more="<%= section.id %>">
                    <button type="button" class="ux35-sidebar-item nav-more-toggle"
                            aria-expanded="<%= moreOpen ? 'true' : 'false' %>"
                            aria-controls="nav-more-<%= section.id %>">
                        <span class="nav-label"><%= moreOpen ? _('nav.fewer') : _('nav.more') %></span>
                        <span class="nav-note"><%= morePages.length %></span>
                        <span class="material-icons nav-more-chevron" aria-hidden="true"><%= moreOpen ? 'expand_less' : 'expand_more' %></span>
                    </button>
                    <ul class="nav-list nav-more-list" id="nav-more-<%= section.id %>"<%= moreOpen ? '' : ' hidden' %>>
                        <% var lastGroup = ''; morePages.forEach(function(item) { %>
                        <% if (item.groupText && item.groupText !== lastGroup) { lastGroup = item.groupText; %>
                        <li class="nav-group"><span class="nav-group-label"><%= item.groupText %></span></li>
                        <% } %>
                        <%- include('nav-item', { item: item, t: _ }) %>
                        <% }); %>
                    </ul>
                </li>
                <% } %>
            </ul>
        </div>
        <% }); %>
    </nav>
    <script nonce="<%= cspNonce %>">
    /* Restore the sidebar before first paint, so it doesn't jump on every
       page load: saved width, sections opened or closed in this tab, and the
       scroll position (keys shared with public/js/ux35-shell.js). */
    (function () {
        try {
            var nav = document.getElementById('ux35-sidebar-nav');
            if (!window.matchMedia('(max-width: 1099px)').matches) {
                var w = parseInt(localStorage.getItem('bd_ux35_sidebar_width'), 10);
                if (w >= 200 && w <= 320) document.documentElement.style.setProperty('--ux35-sidebar-width', w + 'px');
            }
            var closed = JSON.parse(sessionStorage.getItem('bd_nav_sections_collapsed') || '{}') || {};
            nav.querySelectorAll('.ux35-sidebar-section:not(.is-current)').forEach(function (s) {
                var p = s.getAttribute('data-panel');
                if (!p || !Object.prototype.hasOwnProperty.call(closed, p)) return;
                var open = !closed[p];
                s.classList.toggle('is-collapsed', !open);
                var t = s.querySelector('.ux35-sidebar-heading-toggle');
                if (t) t.setAttribute('aria-expanded', open ? 'true' : 'false');
                var i = s.querySelector('.ux35-section-chevron');
                if (i) i.textContent = open ? 'expand_less' : 'expand_more';
            });
            var more = JSON.parse(localStorage.getItem('bd_nav_more_open') || '{}') || {};
            nav.querySelectorAll('.nav-more:not(.is-current)').forEach(function (li) {
                if (!more[li.getAttribute('data-more')]) return;
                var b = li.querySelector('.nav-more-toggle');
                li.querySelector('.nav-more-list').hidden = false;
                b.setAttribute('aria-expanded', 'true');
                b.querySelector('.nav-label').textContent = <%- JSON.stringify(_('nav.fewer')) %>;
                b.querySelector('.nav-more-chevron').textContent = 'expand_less';
            });
            var top = parseInt(sessionStorage.getItem('bd_ux35_sidebar_scroll'), 10);
            if (top > 0) nav.scrollTop = top;
            var a = nav.querySelector('.ux35-sidebar-item.active');
            if (a && (a.offsetTop < nav.scrollTop || a.offsetTop + a.offsetHeight > nav.scrollTop + nav.clientHeight)) {
                nav.scrollTop = Math.max(0, a.offsetTop - nav.clientHeight / 2);
            }
        } catch (e) { /* storage blocked: defaults are fine */ }
    })();
    </script>

    <div class="ux35-sidebar-footer">
        <div class="ux35-sidebar-user" id="user-menu-trigger">
            <span class="ux35-sidebar-user-name"><%= user ? user.username : '' %></span>
            <span class="ux35-sidebar-user-role"><%= _roleLabel %></span>
        </div>
        <% if ((branding && branding.footerText) || (branding && branding.showPoweredBy !== 'false')) { %>
        <div class="ux35-sidebar-attribution">
            <% if (branding.footerText) { %><span><%= branding.footerText %></span><% } %>
            <% if (branding.showPoweredBy !== 'false') { %><span><%= _('branding.powered_by') %> BetterDesk</span><% } %>
        </div>
        <% } %>
    </div>
</aside>
<div class="ux35-sidebar-overlay" id="ux35-sidebar-overlay" hidden></div>
