    var bdTrimmed = bdName.trim();
    var bdMarkOnly = typeof bdLogoMarkOnly !== 'undefined' && bdLogoMarkOnly;
    var bdFull = !bdMarkOnly && (!bdTrimmed || bdTrimmed.toLowerCase() === 'betterdesk');
    var bdH = typeof bdLogoHeight !== 'undefined' && Number(bdLogoHeight) > 0 ? Number(bdLogoHeight) : 20;
    var bdW = Math.round(bdH * 815.9 / 132.92 * 10) / 10;
    var bdMarkH = typeof bdLogoMarkHeight !== 'undefined' && Number(bdLogoMarkHeight) > 0 ? Number(bdLogoMarkHeight) : 24;
    var bdCompact = typeof bdLogoCompact !== 'undefined' && bdLogoCompact;
    var bdNameClass = typeof bdLogoNameClass !== 'undefined' && bdLogoNameClass ? bdLogoNameClass : 'brand-name';
    var bdId = 'bd-logo-' + Math.random().toString(36).slice(2, 9);
    function bdShapes(clipId) {
        return '<rect x="10" y="22" width="32" height="32" rx="10" style="fill:var(--logo-square,#1f6feb)"/>'
            + '<circle cx="38" cy="26" r="16" style="fill:var(--logo-circle,#4d8f06)"/>'
            + '<rect x="10" y="22" width="32" height="32" rx="10" style="fill:var(--logo-overlap,#0f9e96)" clip-path="url(#' + clipId + ')"/>';
    }
    function bdClip(clipId) {
        return '<defs><clipPath id="' + clipId + '"><circle cx="38" cy="26" r="16"/></clipPath></defs>';
    }
