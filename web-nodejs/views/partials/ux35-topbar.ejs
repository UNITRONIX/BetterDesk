<% if (typeof emergencyMode !== 'undefined' && emergencyMode) { %>
<div class="emergency-banner" role="alert">
    <span><%= _('auth.emergency_mode_banner') %></span>
</div>
<% } %>
<%
    const topNav = typeof consoleNav !== 'function' ? {} : consoleNav({
        currentPage: typeof currentPage !== 'undefined' ? currentPage : '',
        currentTab: typeof currentTab !== 'undefined' ? currentTab : '',
        activateAgentNav: typeof activateAgentNav !== 'undefined' && activateAgentNav
    });
    const crumbs = [];
    if (topNav.activeSection) crumbs.push({ label: topNav.activeSection.text });
    const pageCrumbs = (typeof breadcrumb !== 'undefined' && breadcrumb && breadcrumb.length)
        ? breadcrumb
        : (topNav.activePage ? [{ label: topNav.activePage.text }] : (typeof title !== 'undefined' && title ? [{ label: title }] : []));
    pageCrumbs.forEach(function (c) {
        if (!crumbs.length || crumbs[crumbs.length - 1].label !== c.label) crumbs.push(c);
    });
    const themeMode = (branding && branding.themeMode) || 'system';
    const themeIcon = themeMode === 'custom' ? 'palette' : (themeMode === 'system' ? 'contrast' : (themeMode === 'light' ? 'light_mode' : 'dark_mode'));
    const themeName = themeMode === 'custom' ? _('theme.custom') : (themeMode === 'system' ? _('theme.auto') : (themeMode === 'light' ? _('theme.light') : _('theme.dark')));
    const themeLabel = _('theme.title') + ': ' + themeName;
%>
<header class="ux35-topbar" id="ux35-topbar">
    <button type="button" class="ux35-topbar-menu-btn" id="ux35-menu-btn" aria-label="<%= _('ux35.open_menu') %>" aria-controls="ux35-sidebar" aria-expanded="false">
        <span class="material-icons" aria-hidden="true">menu</span>
    </button>

    <a href="/" class="ux35-topbar-logo" title="<%= appName %>">
        <% if (branding.logoType === 'default') { %>
        <%- include('brand-logo', { bdLogoName: appName, bdLogoHeight: 20, bdLogoMarkHeight: 24, bdLogoCompact: true }) %>
        <% } else if (branding.logoType === 'text' && branding.logoText) { %>
        <span class="brand-text-logo"><%= branding.logoText %><% if (branding.logoTextAccent) { %><span class="brand-text-accent"><%= branding.logoTextAccent %></span><% } %></span>
        <% } else if (branding.logoType === 'svg' && branding.logoSvg) { %>
        <span class="sidebar-logo-svg"><%- branding.logoSvg %></span>
        <span class="brand-name"><%= appName %></span>
        <% } else if (branding.logoType === 'image' && branding.logoUrl) { %>
        <img src="<%= branding.logoUrl %>" alt="">
        <span class="brand-name"><%= appName %></span>
        <% } else { %>
        <span class="material-icons" aria-hidden="true"><%= branding.logoIcon || 'dns' %></span>
        <span class="brand-name"><%= appName %></span>
        <% } %>
    </a>

    <nav class="ux35-topbar-breadcrumb" aria-label="<%= _('ux35.breadcrumb') %>">
        <% crumbs.forEach(function (item, index) { %>
            <% if (index > 0) { %><span class="separator" aria-hidden="true">/</span><% } %>
            <% if (index === crumbs.length - 1) { %>
                <span class="current" aria-current="page"><%= item.label %></span>
            <% } else if (item.href) { %>
                <a href="<%= item.href %>"><%= item.label %></a>
            <% } else { %>
                <span><%= item.label %></span>
            <% } %>
        <% }); %>
    </nav>

    <div class="ux35-topbar-spacer"></div>

    <button type="button" class="ux35-search-trigger" data-global-search aria-haspopup="dialog"
            aria-keyshortcuts="Control+K /">
        <span class="material-icons" aria-hidden="true">search</span>
        <span class="ux35-search-label"><%= _('search.placeholder') %></span>
        <kbd class="ux35-search-kbd" aria-hidden="true">Ctrl K</kbd>
    </button>

    <div class="ux35-topbar-actions">
        <button type="button" class="ux35-topbar-text-btn" id="ux35-help-btn" aria-haspopup="dialog"><%= _('nav.help') %></button>
        <div class="ux35-topbar-action-list" id="ux35-topbar-action-list">
        <div class="notif-wrapper">
            <button type="button" class="ux35-topbar-btn notif-btn" id="notif-btn" title="<%= _('notifications.title') %>"
                    aria-label="<%= _('notifications.title') %>" aria-haspopup="menu" aria-expanded="false" aria-controls="notif-dropdown">
                <span class="material-icons" aria-hidden="true">notifications</span>
                <span class="notif-badge" id="notif-badge" hidden aria-hidden="true"></span>
            </button>
            <% const notifHelpLink = typeof hasPermission !== 'function' || hasPermission('device.view'); %>
            <% const notifRegLink = typeof hasPermission !== 'function' || hasPermission('enrollment.approve'); %>
            <div class="notif-dropdown" id="notif-dropdown" role="menu" aria-labelledby="notif-title" hidden>
                <div class="notif-header">
                    <span class="notif-title" id="notif-title"><%= _('notifications.title') %></span>
                    <button type="button" class="notif-mark-all" id="notif-mark-all" role="menuitem" tabindex="-1" hidden><%= _('notifications.mark_all_read') %></button>
                </div>
                <div class="notif-list" id="notif-list">
                    <p class="notif-state"><%= _('notifications.loading') %></p>
                </div>
                <% if (notifHelpLink || notifRegLink) { %>
                <div class="notif-footer">
                    <% if (notifHelpLink) { %>
                    <a href="/help-requests" class="notif-see-all" role="menuitem" tabindex="-1"><%= _('notifications.see_all') %></a>
                    <% } %>
                    <% if (notifRegLink) { %>
                    <a href="/registrations" class="notif-see-all" role="menuitem" tabindex="-1"><%= _('nav.registrations') %></a>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>

        <button type="button" class="ux35-topbar-btn" id="refresh-btn" title="<%= _('actions.refresh') %>"
                aria-label="<%= _('actions.refresh') %>">
            <span class="material-icons" aria-hidden="true">refresh</span>
        </button>

        <button type="button" class="ux35-topbar-btn" id="ux35-theme-btn" title="<%= themeLabel %>" aria-label="<%= themeLabel %>">
            <span class="material-icons" id="ux35-theme-icon" aria-hidden="true"><%= themeIcon %></span>
        </button>

        <button type="button" class="ux35-topbar-btn accessibility-btn" id="accessibility-btn" title="<%= _('accessibility.title') %>" aria-label="<%= _('accessibility.title') %>" aria-haspopup="dialog">
            <span class="material-icons" aria-hidden="true">accessibility_new</span>
        </button>

        <div class="lang-selector">
            <button type="button" class="ux35-topbar-btn" id="lang-btn" title="<%= _('settings.language') %>"
                    aria-label="<%= _('settings.language') %>" aria-haspopup="true" aria-expanded="false">
                <span class="material-icons" aria-hidden="true">language</span>
            </button>
            <div class="lang-dropdown menu" id="lang-dropdown">
                <% (availableLanguageList || Object.values(availableLanguages || {})).forEach(function(language) { %>
                    <div class="lang-option menu-item <%= lang === language.code ? 'active' : '' %>" data-lang="<%= language.code %>" role="button" tabindex="0"<%- lang === language.code ? ' aria-current="true"' : '' %> lang="<%= language.code %>">
                        <%- include('lang-flag', { flagCode: language.code }) %>
                        <span class="lang-label"><%= language.native || language.name || language.code %></span>
                    </div>
                <% }); %>
            </div>
        </div>

        <div class="lang-selector">
            <button type="button" class="ux35-topbar-btn ux35-user-btn" id="user-btn" title="<%= user ? user.username : '' %>"
                    aria-label="<%= user ? user.username : '' %>" aria-haspopup="true" aria-expanded="false">
                <span class="material-icons" aria-hidden="true">account_circle</span>
            </button>
            <div class="lang-dropdown menu" id="user-dropdown">
                <div class="menu-label"><%= user ? user.username : '' %></div>
                <div class="lang-option menu-item" id="change-password-btn" role="button" tabindex="0">
                    <span><%= _('auth.change_password') %></span>
                </div>
                <a class="menu-item" id="account-2fa-link" href="/settings?tab=auth"><%= _('nav.account_2fa') %></a>
                <div class="menu-divider"></div>
                <div class="lang-option menu-item" id="logout-btn" role="button" tabindex="0">
                    <span><%= _('auth.logout') %></span>
                </div>
            </div>
        </div>
        </div>
        <button type="button" class="ux35-topbar-btn ux35-topbar-actions-menu-btn" id="ux35-actions-menu-btn"
                aria-label="<%= _('mobile_nav.more') %>"
                title="<%= _('mobile_nav.more') %>"
                aria-controls="ux35-topbar-action-list" aria-expanded="false">
            <span class="material-icons" aria-hidden="true">more_vert</span>
        </button>
    </div>
</header>
