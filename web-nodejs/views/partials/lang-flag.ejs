<%_
/*
 * Flag next to a language name: language menu and sign-in pages.
 *
 * Language code -> country whose flag stands for it. /img/flags/<code>.svg is
 * that country's Twemoji flag (CC-BY 4.0, see THIRD_PARTY_NOTICES.md).
 * A language without an entry here gets no flag rather than a wrong one.
 *
 *   ar -> Saudi Arabia   cs -> Czechia       da -> Denmark      en -> United Kingdom
 *   hi -> India          ja -> Japan         ko -> South Korea  nb -> Norway
 *   sv -> Sweden         uk -> Ukraine       vi -> Vietnam      zh -> China
 *   zh-TW -> Taiwan
 *   pt -> Portugal: lang/pt.json is European Portuguese (utilizador, ficheiro).
 *   All others: the country with the same two letters (de -> DE, fr -> FR, ...).
 *
 * Locals: flagCode ("de") prints the <img>.
 * After changing the map, copy the SVGs with .ui-rework/tools/flags-copy.mjs.
 */
var LANG_FLAG_COUNTRY = {
    'ar': 'SA', 'cs': 'CZ', 'da': 'DK', 'de': 'DE', 'en': 'GB', 'es': 'ES',
    'fi': 'FI', 'fr': 'FR', 'hi': 'IN', 'hu': 'HU', 'id': 'ID', 'it': 'IT',
    'ja': 'JP', 'ko': 'KR', 'nb': 'NO', 'nl': 'NL', 'pl': 'PL', 'pt': 'PT',
    'ro': 'RO', 'sv': 'SE', 'th': 'TH', 'tr': 'TR', 'uk': 'UA', 'vi': 'VN',
    'zh': 'CN', 'zh-TW': 'TW'
};
var hasFlag = typeof flagCode === 'string' && Object.prototype.hasOwnProperty.call(LANG_FLAG_COUNTRY, flagCode);
if (hasFlag) { _%>
<img class="lang-flag" src="/img/flags/<%= flagCode %>.svg" alt="" width="20" height="20">
<%_ } _%>
