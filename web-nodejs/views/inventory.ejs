<%- include('layouts/main', {
    title: _('nav.inventory'),
    uiReworked: true,
    pageStyles: ['ui/chart', 'ui/device-detail', 'ui/inventory'],
    pageScripts: ['ui-chart', 'deviceDetail', 'inventory'],
    currentPage: 'inventory',
    breadcrumb: [{ label: _('nav.inventory') }],
    body: `
        <div class="page page-wide inventory-page">
            <div class="page-head">
                <h1>${_('nav.inventory')}</h1>
                <p class="page-description">${_('inventory.page_description')}</p>
            </div>

            <div class="page-cols">
            <section class="section page-main" aria-label="${_('nav.inventory')}">
                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" class="form-input" id="search-input"
                            aria-label="${_('inventory.search_label')}"
                            placeholder="${_('inventory.search_label')}">
                    </div>
                    <!-- Next to the search, not alone at the far end of the line -->
                    <button type="button" class="btn" id="refresh-btn"><span class="material-icons" aria-hidden="true">refresh</span>${_('actions.refresh')}</button>
                </div>
                <p class="count-line" id="inventory-count" aria-live="polite"></p>

                <div class="table-scroll">
                    <table class="data-table inventory-table" id="inventory-table">
                        <thead>
                            <tr>
                                <th class="col-device">${_('inventory.col_device')}</th>
                                <th class="col-os">${_('inventory.os')}</th>
                                <th class="col-cpu">${_('inventory.cpu')}</th>
                                <th class="col-memory">${_('inventory.memory')}</th>
                                <th class="col-disks is-num">${_('inventory.disks')}</th>
                                <th class="col-updated">${_('inventory.col_updated')}</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-body">
                            <tr><td colspan="6" class="state-cell">${_('inventory.loading')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- What the whole fleet runs and which devices are short of space (inventory.js renderSummary) -->
            <aside class="page-side inventory-side" aria-label="${_('inventory.side_label')}" id="inventory-side" hidden>
                <section class="section" aria-labelledby="inv-os-title">
                    <h2 id="inv-os-title">${_('inventory.os_title')}</h2>
                    <p class="section-note">${_('inventory.os_note')}</p>
                    <div class="share-bar inv-os-bar" id="inv-os-bar" aria-hidden="true"></div>
                    <ul class="share-legend" id="inv-os-legend"></ul>
                    <div class="table-scroll">
                        <table class="data-table inv-os-table">
                            <thead><tr><th scope="col">${_('inventory.os_col_system')}</th><th scope="col" class="is-num">${_('inventory.os_col_devices')}</th></tr></thead>
                            <tbody id="inv-os-body"></tbody>
                        </table>
                    </div>
                    <p class="count-line" id="inv-os-more" hidden></p>
                </section>
                <section class="section" aria-labelledby="inv-space-title" id="inv-space">
                    <h2 id="inv-space-title">${_('inventory.space_title')}</h2>
                    <p class="section-note">${_('inventory.space_note')}</p>
                    <h3 class="inv-space-sub" id="inv-disk-title">${_('inventory.disks')}</h3>
                    <ul class="list inv-space-list" id="inv-disk-list" aria-labelledby="inv-disk-title"></ul>
                    <h3 class="inv-space-sub" id="inv-mem-title">${_('inventory.memory')}</h3>
                    <ul class="list inv-space-list" id="inv-mem-list" aria-labelledby="inv-mem-title"></ul>
                </section>
            </aside>
            </div>
        </div>
    `
}) %>
