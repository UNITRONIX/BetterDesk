                    <div class="rd-state-device">
                        <span class="rd-state-os session-device-os"></span>
                        <h2 class="rd-state-name overlay-device-name session-device-name"></h2>
                        <span class="rd-state-id session-device-label"></span>
                    </div>
                    <h3 class="rd-state-title session-state-title">${T('remote_viewer.title_connecting', 'Connecting')}</h3>
                    <p class="overlay-status" role="status">
                        <span class="spinner" aria-hidden="true"></span>
                        <span class="session-status-text">${_('remote.connecting')}</span>
                    </p>
                    <p class="rd-state-try session-state-try" hidden></p>
                    <ol class="rd-steps session-steps" aria-label="${T('remote_viewer.steps_label', 'Connection steps')}"></ol>
                    <p class="rd-state-hint session-slow-hint" hidden></p>
                    <div class="overlay-actions session-connecting-actions">
                        <button type="button" class="btn session-btn-cancel">${_('common.cancel')}</button>
                    </div>
                    <div class="overlay-actions session-overlay-actions" style="display:none;">
                        <button type="button" class="btn btn-primary session-btn-reconnect"><span class="material-icons" aria-hidden="true">refresh</span>${_('remote.reconnect')}</button>
                        <button type="button" class="btn session-btn-cdap-fallback" style="display:none;" title="${_('remote.cdap_fallback_hint')}">${_('remote.use_cdap_fallback')}</button>
                        <a class="btn session-btn-open-device" href="/devices" target="_blank" rel="noopener" hidden><span class="material-icons" aria-hidden="true">open_in_new</span>${T('remote_viewer.open_device', 'Open device')}</a>
                        <button type="button" class="btn session-btn-close-tab">${T('remote_viewer.close_tab', 'Close tab')}</button>
                    </div>
                    <details class="disclosure rd-state-details session-details" hidden>
                        <summary>${T('remote_viewer.details', 'Details')}</summary>
                        <button type="button" class="btn btn-sm btn-ghost session-btn-copy-details"><span class="material-icons" aria-hidden="true">content_copy</span>${T('remote_viewer.copy_details', 'Copy details')}</button>
                        <dl class="facts session-details-facts"></dl>
                    </details>
                </div>
                <div class="overlay-card-divider session-billing-divider" hidden aria-hidden="true"></div>
                <div class="overlay-card-billing session-billing-pane" hidden>
                    <h3 class="billing-pane-title">${_('commercialization.report.title') || 'Work report'}</h3>
                    <p class="billing-pane-package session-billing-package"></p>
                    <p class="billing-pane-hours session-billing-hours"></p>
                    <label class="billing-pane-label">${_('commercialization.report.summary') || 'Work performed'}
                        <textarea class="form-input session-billing-summary" rows="6" maxlength="8000"></textarea>
                    </label>
                    <p class="billing-pane-error session-billing-error" hidden></p>
                    <div class="billing-pane-actions">
                        <button type="button" class="btn session-billing-skip">${_('commercialization.report.skip') || 'Skip for now'}</button>
                        <button type="button" class="btn btn-primary session-billing-submit">${_('commercialization.report.submit') || 'Submit report'}</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="viewer-overlay session-password-overlay" style="display:none;">
            <div class="overlay-card">
                <div class="rd-state">
                    <div class="rd-state-device">
                        <span class="rd-state-os session-device-os"></span>
                        <h2 class="rd-state-name session-device-name-copy"></h2>
                        <span class="rd-state-id session-device-id-copy"></span>
                    </div>
                    <h3 class="rd-state-title overlay-title">${T('remote_viewer.password_title', 'Password needed')}</h3>
                    <p class="rd-state-text session-password-label"></p>
                    <div class="password-form">
                        <div class="form-group">
                            <label class="form-label">${_('remote.password_placeholder')}
                                <input type="password" class="form-input session-password-input" autocomplete="off">
                            </label>
                        </div>
                        <p class="login-error session-login-error" role="alert" style="display:none;"></p>
                        <label class="check-field session-remember-peer">
                            <input type="checkbox" class="session-remember-peer-checkbox">
                            <span class="check-label">${T('remote_viewer.remember_password', 'Remember the password in this browser')}</span>
                        </label>
                        <div class="overlay-actions">
                            <button type="button" class="btn btn-primary session-btn-authenticate">${_('remote.connect')}</button>
                            <button type="button" class="btn session-btn-auth-cancel">${_('common.cancel')}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="viewer-overlay session-2fa-overlay" style="display:none;">
            <div class="overlay-card">
                <div class="rd-state">
                    <div class="rd-state-device">
                        <span class="rd-state-os session-device-os"></span>
                        <h2 class="rd-state-name session-device-name-copy"></h2>
                        <span class="rd-state-id session-device-id-copy"></span>
                    </div>
                    <h3 class="rd-state-title overlay-title">${_('remote.2fa_required')}</h3>
                    <p class="rd-state-text session-2fa-label"></p>
                    <div class="password-form">
                        <div class="form-group">
                            <label class="form-label">${_('auth.totp_code')}
                                <input type="text" class="form-input session-2fa-input"
                                       autocomplete="one-time-code" maxlength="6" inputmode="numeric" pattern="[0-9]*">
                            </label>
                            <p class="form-hint">${_('remote.2fa_hint')}</p>
                        </div>
                        <p class="login-error session-2fa-error" role="alert" style="display:none;"></p>
                        <div class="overlay-actions">
                            <button type="button" class="btn btn-primary session-btn-verify-2fa">${_('remote.verify')}</button>
                            <button type="button" class="btn session-btn-auth-cancel">${_('common.cancel')}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <canvas class="session-canvas" tabindex="0"></canvas>
        <aside class="rd-sheet chat-panel session-chat-panel" style="display:none;">
            <div class="rd-sheet-head chat-header">
                <h2 class="rd-sheet-title">${_('remote.chat')}</h2>
                <button type="button" class="icon-btn rd-sheet-close chat-close session-btn-chat-close" aria-label="${T('remote_viewer.close_chat', 'Close chat')}" title="${_('actions.close')}"><span class="material-icons" aria-hidden="true">close</span></button>
            </div>
            <div class="chat-messages session-chat-messages" aria-live="polite">
                <p class="chat-empty">${T('remote_viewer.chat_empty', 'Your messages appear on the screen of the device. Replies show here.')}</p>
            </div>
            <div class="chat-input-area">
                <input type="text" class="form-input chat-input session-chat-input" aria-label="${_('remote.chat_placeholder')}" placeholder="${_('remote.chat_placeholder')}" />
                <button type="button" class="btn chat-send session-btn-chat-send"><span class="material-icons" aria-hidden="true">send</span>${_('remote.type_text_send')}</button>
            </div>
        </aside>
    </div>
</template>

<!-- Initial session data (from server route) -->
<script nonce="${cspNonce}">
    window.__initialDeviceId = ` + JSON.stringify(deviceId) + `;
    window.__initialDeviceName = ` + JSON.stringify(initialName) + `;
    window.__initialDevicePlatform = ` + JSON.stringify(initialPlatform) + `;
    window.__capabilities = ` + JSON.stringify(capabilities || { transport: 'rd' }) + `;
    window.__guestToken = ` + JSON.stringify((typeof guestToken !== 'undefined' && guestToken) ? guestToken : '') + `;
</script>
` + (mock ? `
<!-- Dev only (BD_DEV_MOCK_REMOTE=1): a fake device instead of the network -->
<script nonce="${cspNonce}">window.__mockRemote = ` + JSON.stringify(mock) + `;</script>
<script src="/dev/mock-remote.js?v=${cacheVersion}"></script>
` : '') + `
`
}) %>
