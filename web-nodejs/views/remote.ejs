<%- include('layouts/viewer', {
    title: title || _('remote.title'),
    pageScripts: ['billing-report', 'remote'],
    body: `

<!-- Phones: the web viewer needs a larger screen; offer the RustDesk app instead -->
<div class="rd-phone-gate" id="rd-phone-gate" hidden>
    <div class="rd-phone-gate-card">
        <h1 class="rd-phone-gate-title">${_('remote_viewer.phone_title')}</h1>
        <p class="rd-phone-gate-body">${_('remote_viewer.phone_body')}</p>
        <p class="rd-phone-gate-id mono">${deviceId}</p>
        <div class="rd-phone-gate-actions">
            <a href="rustdesk://${encodeURIComponent(deviceId)}" class="btn btn-primary">${_('remote_viewer.open_in_app')}</a>
            <a href="/remote" class="btn">${_('remote_viewer.back_to_list')}</a>
        </div>
    </div>
</div>

<!-- RdClient shell: tabs + viewer + toolbar (fullscreen target) -->
<div id="rd-viewer-shell" class="rd-viewer-shell">

<!-- Session bar: back, open sessions, new connection, controls -->
<div class="session-tab-bar" id="session-tab-bar">
    <button type="button" class="btn btn-sm tab-bar-back" id="btn-back-devices">${_('remote.back_to_devices')}</button>
    <div class="session-tabs" id="session-tabs"></div>
    <button type="button" class="btn btn-sm tab-bar-add" id="btn-add-session">${_('remote.new_connection')}</button>
    <div class="toolbar-notch-slot toolbar-chrome-hidden" id="toolbar-notch-slot">
        <div class="viewer-toolbar" id="viewer-toolbar">
            <div class="toolbar-drawer" id="toolbar-drawer">
            <div class="toolbar-handle" id="toolbar-handle">
                <button type="button" class="btn btn-sm handle-btn handle-expand" id="btn-toolbar-expand" aria-expanded="false" aria-controls="toolbar-expanded">
                    ${_('remote_viewer.controls')}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                </button>
                <button type="button" class="btn btn-sm handle-btn" id="btn-handle-fullscreen"><span class="fullscreen-label">${_('remote.fullscreen')}</span></button>
            </div>
            <div class="toolbar-expanded" id="toolbar-expanded" role="group" aria-label="${_('remote_viewer.controls')}">
                <div class="toolbar-left">
                    <span class="toolbar-device-info">
                        <span class="toolbar-device-id mono" id="toolbar-device-id"></span>
                        <span class="toolbar-separator toolbar-status-sep" aria-hidden="true">·</span>
                        <span class="toolbar-status" id="toolbar-status">${_('remote.connecting')}</span>
                    </span>
                    <span class="toolbar-package-badge" id="toolbar-package-badge" hidden title=""></span>
                </div>
                <div class="toolbar-monitor-strip" id="toolbar-monitor-strip" hidden></div>
                <div class="toolbar-right">
                    <div class="toolbar-dropdown">
                        <button type="button" class="btn btn-sm toolbar-btn" id="btn-actions" aria-haspopup="true" aria-expanded="false" aria-controls="actions-menu">
                            ${_('remote.actions')}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="toolbar-dropdown-menu menu" id="actions-menu">
                            <button type="button" class="dropdown-item" id="btn-cad">Ctrl+Alt+Del</button>
                            <button type="button" class="dropdown-item" id="btn-lock">${_('remote.lock_screen')}</button>
                            <button type="button" class="dropdown-item" id="btn-restart-remote">${_('remote.restart_remote')}</button>
                            <div class="dropdown-separator"></div>
                            <button type="button" class="dropdown-item" id="btn-refresh-screen">${_('remote.refresh_screen')}</button>
                            <button type="button" class="dropdown-item" id="btn-clipboard-paste" title="${_('remote.clipboard_paste_hint')}">${_('remote.clipboard_paste')}</button>
                            <button type="button" class="dropdown-item" id="btn-reset-keyboard">${_('remote.reset_keyboard')}</button>
                            <div class="dropdown-separator"></div>
                            <button type="button" class="dropdown-item toggle-item" id="btn-block-input" data-active="false">${_('remote.block_input')}</button>
                        </div>
                    </div>
                    <div class="toolbar-dropdown">
                        <button type="button" class="btn btn-sm toolbar-btn" id="btn-type-text" aria-expanded="false" aria-controls="type-text-menu">
                            ${_('remote.type_text')}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="toolbar-dropdown-menu menu toolbar-type-text-menu" id="type-text-menu">
                            <div class="type-text-panel">
                                <label class="form-label" for="type-text-input">${_('remote.type_text')}</label>
                                <textarea id="type-text-input" class="form-input type-text-input" rows="3" autocomplete="off" spellcheck="false" aria-describedby="type-text-hint"></textarea>
                                <p class="form-hint" id="type-text-hint">${_('remote.type_text_placeholder')}</p>
                                <button type="button" class="btn btn-sm type-text-send" id="btn-type-text-send">${_('remote.type_text_send')}</button>
                            </div>
                        </div>
                    </div>
                    <div class="toolbar-dropdown">
                        <button type="button" class="btn btn-sm toolbar-btn" id="btn-display" aria-haspopup="true" aria-expanded="false" aria-controls="display-menu">
                            ${_('remote.display_settings')}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="toolbar-dropdown-menu menu toolbar-dropdown-wide" id="display-menu">
                            <div class="display-menu-grid">
                                <section class="display-menu-section">
                                    <div class="dropdown-label">${_('remote.image_quality')}</div>
                                    <button type="button" class="dropdown-item quality-item active" data-quality="Best">${_('remote.quality_best')}</button>
                                    <button type="button" class="dropdown-item quality-item" data-quality="Balanced">${_('remote.quality_balanced')}</button>
                                    <button type="button" class="dropdown-item quality-item" data-quality="Low">${_('remote.quality_low')}</button>
                                </section>
                                <section class="display-menu-section">
                                    <div class="dropdown-label">${_('remote_viewer.frame_rate')}</div>
                                    <button type="button" class="dropdown-item fps-mode-item" data-fps-mode="30">30 fps</button>
                                    <button type="button" class="dropdown-item fps-mode-item" data-fps-mode="60">60 fps</button>
                                    <button type="button" class="dropdown-item fps-mode-item active" data-fps-mode="adaptive">${_('remote_viewer.fps_adaptive')}</button>
                                </section>
                                <section class="display-menu-section">
                                    <div class="dropdown-label">${_('remote.codec')}</div>
                                    <button type="button" class="dropdown-item codec-item active" data-codec="Auto">${_('remote.codec_auto')}</button>
                                    <button type="button" class="dropdown-item codec-item" data-codec="VP9">VP9</button>
                                    <button type="button" class="dropdown-item codec-item" data-codec="AV1">AV1</button>
                                    <button type="button" class="dropdown-item codec-item" data-codec="H264">H264</button>
                                    <button type="button" class="dropdown-item codec-item" data-codec="VP8">VP8</button>
                                    <button type="button" class="dropdown-item codec-item" data-codec="H265">H265</button>
                                </section>
                                <section class="display-menu-section">
                                    <div class="dropdown-label">${_('remote.keyboard_mode')}</div>
                                    <button type="button" class="dropdown-item keyboard-mode-item active" data-keyboard-mode="Auto">${_('remote.keyboard_mode_auto')}</button>
                                    <button type="button" class="dropdown-item keyboard-mode-item" data-keyboard-mode="Legacy">${_('remote.keyboard_mode_legacy')}</button>
                                    <button type="button" class="dropdown-item keyboard-mode-item" data-keyboard-mode="Map">${_('remote.keyboard_mode_map')}</button>
                                </section>
                                <section class="display-menu-section">
                                    <div class="dropdown-label">${_('remote.scale_mode')}</div>
                                    <button type="button" class="dropdown-item scale-item active" data-scale="fit">${_('remote.scale_fit')}</button>
                                    <button type="button" class="dropdown-item scale-item" data-scale="fill">${_('remote.scale_fill')}</button>
                                    <button type="button" class="dropdown-item scale-item" data-scale="1:1">${_('remote.scale_original')}</button>
                                    <button type="button" class="dropdown-item scale-item" data-scale="stretch">${_('remote.scale_stretch')}</button>
                                </section>
                                <section class="display-menu-section display-menu-section--full">
                                    <button type="button" class="dropdown-item toggle-item" id="btn-show-cursor" data-active="true">${_('remote.show_cursor')}</button>
                                    <button type="button" class="dropdown-item toggle-item" id="btn-lock-session" data-active="false">${_('remote.lock_after_session')}</button>
                                    <button type="button" class="dropdown-item toggle-item" id="btn-privacy-mode" data-active="false">${_('remote.privacy_mode')}</button>
                                    <button type="button" class="dropdown-item toggle-item" id="btn-disable-clipboard" data-active="false">${_('remote.disable_clipboard')}</button>
                                </section>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm toolbar-btn" id="btn-billing-report" style="display:none;">${_('commercialization.report.toolbar') || 'Work report'}</button>
                    <button type="button" class="btn btn-sm toolbar-btn" id="btn-audio">
                        <span class="when-off">${_('remote_viewer.mute')}</span><span class="when-on">${_('remote_viewer.unmute')}</span>
                    </button>
                    <div class="toolbar-dropdown">
                        <button type="button" class="btn btn-sm toolbar-btn" id="btn-monitors" aria-haspopup="true" aria-expanded="false" aria-controls="monitors-menu" style="display:none">
                            ${_('remote.monitors') || 'Monitors'}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="toolbar-dropdown-menu menu" id="monitors-menu">
                            <div class="dropdown-label">${_('remote.select_monitor') || 'Select Monitor'}</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm toolbar-btn" id="btn-chat">${_('remote.chat')}</button>
                    <button type="button" class="btn btn-sm toolbar-btn" id="btn-file-transfer">${_('remote.file_transfer') || 'File transfer'}</button>
                    <button type="button" class="btn btn-sm toolbar-btn" id="btn-record">
                        <span class="when-off">${_('remote.record')}</span><span class="when-on">${_('remote_viewer.stop_recording')}</span>
                    </button>
                    <button type="button" class="btn btn-sm toolbar-btn" id="btn-viewonly">${_('remote.view_only')}</button>
                    <button type="button" class="btn btn-sm toolbar-btn" id="btn-pin">${_('remote.pin_toolbar')}</button>
                    <button type="button" class="btn btn-sm btn-danger-quiet toolbar-btn toolbar-btn-danger" id="btn-disconnect">${_('remote.disconnect')}</button>
                </div>
            </div>
            </div>
        </div>
    </div>
</div>

<!-- Session picker (address book dialog) -->
<div class="session-picker-backdrop" id="session-picker-backdrop" hidden>
    <div class="session-picker-panel" id="session-picker-panel" role="dialog" aria-modal="true" aria-labelledby="session-picker-title">
        <div class="session-picker-header">
            <h2 class="session-picker-title" id="session-picker-title">${_('remote.session_picker.title') || 'Choose device'}</h2>
            <button type="button" class="session-picker-close modal-close" id="session-picker-close" aria-label="${_('actions.close')}">
                <span class="material-icons" aria-hidden="true">close</span>
            </button>
        </div>
        <div class="session-picker-quick">
            <label class="form-label" for="session-picker-quick-id">${_('remote_dashboard.col_id')}</label>
            <div class="session-picker-quick-row">
                <input type="text" class="form-input mono session-picker-quick-input" id="session-picker-quick-id" inputmode="numeric" autocomplete="off" spellcheck="false">
                <button type="button" class="btn btn-primary session-picker-quick-btn" id="session-picker-quick-btn">${_('remote_dashboard.connect')}</button>
            </div>
        </div>
        <div class="session-picker-body">
            <aside class="session-picker-sidebar" id="session-picker-sidebar" aria-label="${_('remote_dashboard.nav_folders')}">
                <h3 class="session-picker-nav-heading">${_('remote_dashboard.nav_folders')}</h3>
                <ul class="session-picker-nav-list filter-list" id="session-picker-folders">
                    <li class="filter-item" data-static="1"><button type="button" class="rd-picker-nav-item filter-option active" data-nav="folder" data-id="all">
                        <span class="rd-picker-nav-label chip-label">${_('remote_dashboard.filter_all')}</span>
                        <span class="rd-picker-nav-count chip-count" id="rd-picker-count-all">0</span>
                    </button></li>
                    <li class="filter-item" data-static="1"><button type="button" class="rd-picker-nav-item filter-option" data-nav="folder" data-id="unassigned">
                        <span class="rd-picker-nav-label chip-label">${_('remote_dashboard.unassigned')}</span>
                        <span class="rd-picker-nav-count chip-count" id="rd-picker-count-unassigned">0</span>
                    </button></li>
                </ul>
                <ul class="session-picker-nav-list filter-list" id="session-picker-folders-custom"></ul>
                <h3 class="session-picker-nav-heading">${_('remote_dashboard.nav_groups')}</h3>
                <ul class="session-picker-nav-list filter-list" id="session-picker-groups">
                    <li class="hidden session-picker-nav-empty" data-static="1" id="session-picker-groups-empty">${_('remote_dashboard.no_groups')}</li>
                </ul>
                <h3 class="session-picker-nav-heading">${_('remote_dashboard.nav_tags')}</h3>
                <ul class="session-picker-nav-list filter-list" id="session-picker-tags">
                    <li class="hidden session-picker-nav-empty" data-static="1" id="session-picker-tags-empty">${_('remote_dashboard.no_tags')}</li>
                </ul>
            </aside>
            <div class="session-picker-content" id="session-picker-content">
                <div class="session-picker-toolbar toolbar">
                    <h3 class="session-picker-section-title sr-only" id="session-picker-section-title">${_('remote_dashboard.nav_address_book')}</h3>
                    <div class="session-picker-search-wrap toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" id="session-picker-search" class="form-input session-picker-search"
                            aria-label="${_('remote_dashboard.search_placeholder')}"
                            placeholder="${_('remote_dashboard.search_placeholder')}" autocomplete="off">
                    </div>
                    <div class="session-picker-filters toolbar-filters" role="group" aria-label="${_('remote_dashboard.col_status')}">
                        <button type="button" class="rd-picker-filter filter-btn active" data-filter="all">${_('remote_dashboard.filter_all')}</button>
                        <button type="button" class="rd-picker-filter filter-btn" data-filter="online">${_('remote_dashboard.filter_online')}</button>
                        <button type="button" class="rd-picker-filter filter-btn" data-filter="offline">${_('remote_dashboard.filter_offline')}</button>
                    </div>
                    <div class="toolbar-end">
                        <div class="session-picker-view-toggle view-switch" role="group" aria-label="${_('remote_dashboard.view_list')}">
                            <button type="button" class="rd-picker-icon-btn" id="session-picker-view-list">${_('remote_dashboard.view_list')}</button>
                            <button type="button" class="rd-picker-icon-btn active" id="session-picker-view-grid">${_('remote_dashboard.view_grid')}</button>
                        </div>
                        <button type="button" class="btn btn-sm rd-picker-refresh" id="session-picker-refresh">${_('remote_dashboard.sync_now')}</button>
                    </div>
                </div>
                <p class="count-line session-picker-count" id="session-picker-count" aria-live="polite"></p>
                <div class="session-picker-main" id="session-picker-main">
                    <p class="state session-picker-loading hidden" id="session-picker-loading">${_('remote_dashboard.loading')}</p>
                    <p class="state is-error session-picker-error hidden" id="session-picker-error">
                        <span id="session-picker-error-text">${_('remote_dashboard.error_load')}</span>
                        <button type="button" class="btn btn-sm rd-picker-btn" id="session-picker-retry">${_('remote_dashboard.retry')}</button>
                    </p>
                    <p class="state session-picker-empty hidden" id="session-picker-empty">${_('remote_dashboard.empty')}</p>
                    <div class="rd-picker-grid hidden" id="session-picker-grid"></div>
                    <div class="rd-picker-table-wrap table-scroll hidden" id="session-picker-table-wrap">
                        <table class="rd-picker-table data-table">
                            <thead>
                                <tr>
                                    <th>${_('remote_dashboard.col_name')}</th>
                                    <th>${_('remote_dashboard.col_id')}</th>
                                    <th>${_('remote_dashboard.col_status')}</th>
                                    <th>${_('remote_dashboard.col_platform')}</th>
                                    <th>${_('remote_dashboard.col_last_seen')}</th>
                                    <th class="actions"><span class="sr-only">${_('remote.actions')}</span></th>
                                </tr>
                            </thead>
                            <tbody id="session-picker-tbody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Viewer Container (session panels are inserted here) -->
<div class="viewer-container" id="viewer-container"></div>

</div><!-- /#rd-viewer-shell -->
<nav class="rd-mobile-toolbar" id="rd-mobile-toolbar" aria-label="${_('remote.mobile_toolbar') || 'Remote controls'}">
    <button type="button" class="rd-mobile-toolbar-btn active" id="rd-mob-input-touch" data-mode="direct">${_('remote.input_mode_touch')}</button>
    <button type="button" class="rd-mobile-toolbar-btn" id="rd-mob-input-touchpad" data-mode="touchpad">${_('remote.input_mode_touchpad')}</button>
    <button type="button" class="rd-mobile-toolbar-btn" id="rd-mob-keyboard">${_('remote.show_keyboard')}</button>
    <button type="button" class="rd-mobile-toolbar-btn" id="rd-mob-special">${_('remote.special_keys')}</button>
    <button type="button" class="rd-mobile-toolbar-btn" id="rd-mob-cad">Ctrl+Alt+Del</button>
    <button type="button" class="rd-mobile-toolbar-btn" id="rd-mob-fullscreen">${_('remote.fullscreen')}</button>
</nav>
<div class="rd-special-keys-panel" id="rd-special-keys-panel" role="group" aria-label="${_('remote.special_keys')}">
    <button type="button" class="btn rd-special-key-btn" data-special="Meta">Win</button>
    <button type="button" class="btn rd-special-key-btn" data-special="Alt+Tab">Alt+Tab</button>
    <button type="button" class="btn rd-special-key-btn" data-special="PrintScreen">${_('remote.special_print_screen') || 'Print Screen'}</button>
    <button type="button" class="btn rd-special-key-btn" data-special="Escape">Esc</button>
</div>
<input type="text" class="rd-keyboard-bridge" id="rd-keyboard-bridge" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-hidden="true" tabindex="-1">

<!-- Session Panel Template (cloned for each session) -->
<template id="session-panel-template">
    <div class="session-panel">
        <div class="viewer-overlay session-connection-overlay">
            <div class="overlay-card overlay-card--splitable">
                <div class="overlay-card-main">
                    <h2 class="overlay-device-name session-device-name"></h2>
                    <p class="overlay-device-id session-device-label mono"></p>
                    <p class="overlay-status" role="status">
                        <span class="spinner" aria-hidden="true"></span>
                        <span class="session-status-text">${_('remote.connecting')}</span>
                    </p>
                    <div class="overlay-actions session-overlay-actions" style="display:none;">
                        <button type="button" class="btn btn-primary session-btn-reconnect">${_('remote.reconnect')}</button>
                        <button type="button" class="btn session-btn-cdap-fallback" style="display:none;" title="${_('remote.cdap_fallback_hint')}">${_('remote.use_cdap_fallback')}</button>
                    </div>
                </div>
                <div class="overlay-card-divider session-billing-divider" hidden aria-hidden="true"></div>
                <div class="overlay-card-billing session-billing-pane" hidden>
                    <h3 class="billing-pane-title">${_('commercialization.report.title') || 'Work report'}</h3>
                    <p class="billing-pane-package session-billing-package"></p>
                    <p class="billing-pane-hours session-billing-hours"></p>
                    <label class="billing-pane-label">${_('commercialization.report.summary') || 'Work performed'}
                        <textarea class="form-input session-billing-summary" rows="6" maxlength="8000"></textarea>
                    </label>
                    <p class="billing-pane-error session-billing-error" hidden></p>
                    <div class="billing-pane-actions">
                        <button type="button" class="btn session-billing-skip">${_('commercialization.report.skip') || 'Skip for now'}</button>
                        <button type="button" class="btn btn-primary session-billing-submit">${_('commercialization.report.submit') || 'Submit report'}</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="viewer-overlay session-password-overlay" style="display:none;">
            <div class="overlay-card">
                <h2 class="overlay-title">${_('remote.password_required')}</h2>
                <p class="overlay-device-id session-password-label"></p>
                <div class="password-form">
                    <div class="form-group">
                        <label class="form-label">${_('remote.password_placeholder')}
                            <input type="password" class="form-input session-password-input" autocomplete="off">
                        </label>
                    </div>
                    <p class="login-error session-login-error" role="alert" style="display:none;"></p>
                    <div class="password-form-footer">
                        <label class="checkbox-row session-remember-peer">
                            <input type="checkbox" class="session-remember-peer-checkbox">
                            <span>${_('remote.remember_peer_password') || 'Remember device password on this device'}</span>
                        </label>
                        <button type="button" class="btn btn-primary btn-block session-btn-authenticate">${_('remote.connect')}</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="viewer-overlay session-2fa-overlay" style="display:none;">
            <div class="overlay-card">
                <h2 class="overlay-title">${_('remote.2fa_required') || '2FA Verification'}</h2>
                <div class="password-form">
                    <div class="form-group">
                        <label class="form-label">${_('auth.totp_code')}
                            <input type="text" class="form-input mono session-2fa-input"
                                   autocomplete="one-time-code" maxlength="6" inputmode="numeric" pattern="[0-9]*">
                        </label>
                        <p class="form-hint">${_('remote.2fa_hint') || 'Enter the 6-digit code from your authenticator app'}</p>
                    </div>
                    <p class="login-error session-2fa-error" role="alert" style="display:none;"></p>
                    <button type="button" class="btn btn-primary btn-block session-btn-verify-2fa">${_('remote.verify') || 'Verify'}</button>
                </div>
            </div>
        </div>
        <canvas class="session-canvas" tabindex="0"></canvas>
        <div class="chat-panel session-chat-panel" style="display:none;">
            <div class="chat-header">
                <h2>${_('remote.chat')}</h2>
                <button type="button" class="chat-close modal-close session-btn-chat-close" aria-label="${_('actions.close')}"><span class="material-icons" aria-hidden="true">close</span></button>
            </div>
            <div class="chat-messages session-chat-messages" aria-live="polite"></div>
            <div class="chat-input-area">
                <input type="text" class="form-input chat-input session-chat-input" aria-label="${_('remote.chat_placeholder')}" placeholder="${_('remote.chat_placeholder')}" />
                <button type="button" class="btn chat-send session-btn-chat-send">${_('remote.type_text_send')}</button>
            </div>
        </div>
    </div>
</template>

<!-- Initial session data (from server route) -->
<script nonce="${cspNonce}">
    window.__initialDeviceId = ` + JSON.stringify(deviceId) + `;
    window.__initialDeviceName = ` + JSON.stringify(device && device.hostname ? device.hostname : '') + `;
    window.__capabilities = ` + JSON.stringify(capabilities || { transport: 'rd' }) + `;
    window.__guestToken = ` + JSON.stringify((typeof guestToken !== 'undefined' && guestToken) ? guestToken : '') + `;
</script>

`
}) %>
