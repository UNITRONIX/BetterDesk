<%- include('layouts/main', {
    title: _('cdap.device_detail'),
    uiReworked: true,
    pageStyles: ['ui/cdap'],
    pageScripts: ['vendor/jmuxer.min', 'rdclient/video', 'cdap-widgets', 'cdap-commands', 'cdap-terminal', 'cdap-desktop', 'cdap-video', 'cdap-filebrowser', 'cdap-audio'],
    currentPage: 'cdap',
    breadcrumb: [
        { label: _('nav.cdap'), href: '/cdap' },
        { label: _('cdap.device_detail') }
    ],
    body: `
<div class="page page-wide cdap-device-page" data-device-id="${escapeHtml(deviceId)}">
    <div class="page-head">
        <h1 id="cdap-device-name">${escapeHtml(deviceId)}</h1>
        <p class="page-description">${_('cdap.device_description')}</p>
    </div>

    <!-- Shown when the device answers 404 or the request fails -->
    <p class="state is-error hidden" id="cdap-device-error"></p>

    <div class="cdap-device-body" id="cdap-device-body">
        <dl class="facts cdap-facts" id="cdap-device-meta">
            <dt>${_('cdap.col_status')}</dt>
            <dd id="cdap-device-status"><span class="status">${_('cdap.loading')}</span></dd>
            <dt>${_('cdap.device_id')}</dt>
            <dd><span class="mono">${escapeHtml(deviceId)}</span></dd>
            <dt>${_('cdap.col_type')}</dt>
            <dd id="cdap-device-type">–</dd>
            <dt>${_('cdap.firmware')}</dt>
            <dd id="cdap-device-version">–</dd>
            <dt>${_('cdap.col_connected_for')}</dt>
            <dd id="cdap-device-uptime">–</dd>
        </dl>

        <p class="notice warning hidden" id="cdap-offline-banner">${_('cdap.device_offline_msg')}</p>

        <!-- Alerts that are firing now -->
        <section class="section hidden" id="cdap-alerts-panel" aria-labelledby="cdap-alerts-title">
            <h2 id="cdap-alerts-title">${_('cdap.active_alerts')}</h2>
            <p class="count-line" id="cdap-alerts-count"></p>
            <ul class="list" id="cdap-alerts-list"></ul>
        </section>

        <!-- Values and controls from the device's manifest -->
        <section class="section" aria-labelledby="cdap-widgets-title">
            <h2 id="cdap-widgets-title">${_('cdap.widgets_heading')}</h2>
            <div class="cdap-widget-grid" id="cdap-widget-grid">
                <p class="state" id="cdap-loading">${_('cdap.loading_widgets')}</p>
            </div>
            <p class="state hidden" id="cdap-empty">${_('cdap.no_widgets_sentence')}</p>
        </section>

        <!-- Commands sent from this page -->
        <section class="section hidden" id="cdap-command-log" aria-labelledby="cdap-log-title">
            <div class="section-head">
                <h2 id="cdap-log-title">${_('cdap.command_log')}</h2>
                <button type="button" class="btn btn-sm" id="cdap-clear-log">${_('cdap.clear_log')}</button>
            </div>
            <div class="cdap-command-log-entries" id="cdap-log-entries"></div>
        </section>

        <!-- Remote desktop peers linked to this device -->
        <section class="section" id="cdap-linked-panel" aria-labelledby="cdap-linked-title">
            <div class="section-head">
                <h2 id="cdap-linked-title">${_('cdap.linked_devices')}</h2>
                <button type="button" class="btn btn-sm" id="cdap-link-btn">${_('cdap.link_device')}</button>
            </div>
            <p class="section-note">${_('cdap.linked_note')}</p>
            <p class="count-line" id="cdap-linked-count"></p>
            <ul class="list" id="cdap-linked-list">
                <li class="list-row is-empty" id="cdap-linked-empty">${_('cdap.no_linked_devices')}</li>
            </ul>
        </section>
    </div>
</div>
`
}) %>
