<%- include('layouts/studio', {
    title: _('nav.sdk_studio'),
    pageStyles: ['ui/cdap-studio'],
    pageScripts: ['cdap-studio'],
    currentPage: 'cdap-studio',
    body: `

<main class="studio-container" id="studio-container">

    <header class="studio-head">
        <a href="/" class="studio-back-btn">${_('sdk_studio.back_console')}</a>
        <h1>${_('nav.sdk_studio')}</h1>
        <p class="studio-description">${_('sdk_studio.page_description')}</p>
    </header>

    <!-- Toolbar -->
    <div class="studio-toolbar" id="studio-toolbar" role="toolbar" aria-label="${_('nav.sdk_studio')}">
        <div class="studio-toolbar-left">
            <span class="studio-flow-name" id="studio-flow-name">${_('sdk_studio.untitled')}</span>
            <button type="button" class="btn btn-sm" id="btn-new-flow"><span class="material-icons" aria-hidden="true">add</span>${_('sdk_studio.new_flow')}</button>
            <button type="button" class="btn btn-sm" id="btn-open-flow">${_('sdk_studio.open_flow')}</button>
            <button type="button" class="btn btn-sm btn-primary" id="btn-save-flow">${_('sdk_studio.save_flow')}</button>
            <span class="studio-toolbar-sep" aria-hidden="true"></span>
            <button type="button" class="btn btn-sm" id="btn-run-flow">${_('sdk_studio.run_flow')}</button>
            <button type="button" class="btn btn-sm" id="btn-deploy-flow">${_('sdk_studio.deploy')}</button>
            <span class="studio-toolbar-sep" aria-hidden="true"></span>
            <button type="button" class="btn btn-sm" id="btn-undo">${_('sdk_studio.undo')}</button>
            <button type="button" class="btn btn-sm" id="btn-redo">${_('sdk_studio.redo')}</button>
            <span class="menu-anchor">
                <button type="button" class="btn btn-sm" id="btn-more" data-menu-button aria-haspopup="menu" aria-expanded="false" aria-controls="studio-more-menu">
                    ${_('sdk_studio.more')}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                </button>
                <span class="menu" id="studio-more-menu" role="menu">
                    <button type="button" class="menu-item" role="menuitem" id="btn-rename-flow"><span class="material-icons" aria-hidden="true">drive_file_rename_outline</span>${_('sdk_studio.rename_flow')}</button>
                    <button type="button" class="menu-item" role="menuitem" id="btn-empty-template-menu"><span class="material-icons" aria-hidden="true">arrow_forward</span>${_('sdk_studio.browse_templates')}</button>
                    <span class="menu-divider"></span>
                    <button type="button" class="menu-item" role="menuitem" id="btn-import-flow"><span class="material-icons" aria-hidden="true">upload</span>${_('sdk_studio.import_flow')}</button>
                    <button type="button" class="menu-item" role="menuitem" id="btn-export-flow"><span class="material-icons" aria-hidden="true">download</span>${_('sdk_studio.download_file')}</button>
                    <span class="menu-divider"></span>
                    <button type="button" class="menu-item" role="menuitem" id="btn-toggle-code"><span class="material-icons" aria-hidden="true">visibility</span>${_('sdk_studio.show_json')}</button>
                </span>
            </span>
            <input type="file" id="import-flow-input" accept=".bdflow,.json" hidden>
        </div>
        <div class="studio-toolbar-right">
            <label class="checkbox-row studio-grid-toggle">
                <input type="checkbox" id="btn-toggle-grid" checked>
                <span>${_('sdk_studio.snap_grid')}</span>
            </label>
            <div class="studio-zoom-group" role="group" aria-label="${_('sdk_studio.zoom')}">
                <button type="button" class="btn-icon" id="btn-zoom-out" aria-label="${_('sdk_studio.zoom_out')}" title="${_('sdk_studio.zoom_out')}">
                    <span class="material-icons" aria-hidden="true">remove</span>
                </button>
                <span class="studio-zoom-label" id="studio-zoom-label" aria-live="polite">100%</span>
                <button type="button" class="btn-icon" id="btn-zoom-in" aria-label="${_('sdk_studio.zoom_in')}" title="${_('sdk_studio.zoom_in')}">
                    <span class="material-icons" aria-hidden="true">add</span>
                </button>
                <button type="button" class="btn-icon" id="btn-zoom-fit" aria-label="${_('sdk_studio.zoom_fit')}" title="${_('sdk_studio.zoom_fit')}">
                    <span class="material-icons" aria-hidden="true">fit_screen</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Shown when the server cannot store flows (the list request fails) -->
    <p class="studio-store-notice notice warning" id="studio-store-notice" hidden>${_('sdk_studio.store_unavailable')}</p>

    <p class="studio-small-screen notice" id="studio-small-screen">${_('sdk_studio.small_screen')}</p>

    <!-- Workspace -->
    <div class="studio-workspace">

        <!-- Palette (start side) -->
        <section class="studio-palette studio-panel" id="studio-palette" aria-labelledby="studio-palette-title">
            <div class="studio-panel-header">
                <h2 id="studio-palette-title">${_('sdk_studio.palette')}</h2>
                <button type="button" class="btn-icon studio-panel-toggle" id="btn-toggle-palette" aria-expanded="true" aria-controls="studio-palette-body"
                        aria-label="${_('sdk_studio.hide_palette')}" title="${_('sdk_studio.hide_palette')}"
                        data-label-hide="${_('sdk_studio.hide_palette')}" data-label-show="${_('sdk_studio.show_palette')}">
                    <span class="material-icons" aria-hidden="true">chevron_left</span>
                </button>
            </div>
            <div class="studio-panel-body" id="studio-palette-body">
                <div class="studio-palette-search-wrap search-wrapper">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input type="search" class="form-input is-small studio-palette-search" id="palette-search"
                           aria-label="${_('sdk_studio.search_nodes')}" placeholder="${_('sdk_studio.search_nodes')}" autocomplete="off">
                </div>
                <p class="studio-palette-hint">${_('sdk_studio.add_hint')}</p>

                <div class="studio-palette-category" data-category="sources">
                    <button type="button" class="studio-palette-cat-btn" data-cat="sources" aria-expanded="true" aria-controls="palette-sources">
                        <span class="material-icons studio-cat-chevron" aria-hidden="true">expand_more</span>
                        <span>${_('sdk_studio.cat_sources')}</span>
                    </button>
                    <div class="studio-palette-items" id="palette-sources"></div>
                </div>

                <div class="studio-palette-category" data-category="processing">
                    <button type="button" class="studio-palette-cat-btn" data-cat="processing" aria-expanded="true" aria-controls="palette-processing">
                        <span class="material-icons studio-cat-chevron" aria-hidden="true">expand_more</span>
                        <span>${_('sdk_studio.cat_processing')}</span>
                    </button>
                    <div class="studio-palette-items" id="palette-processing"></div>
                </div>

                <div class="studio-palette-category" data-category="outputs">
                    <button type="button" class="studio-palette-cat-btn" data-cat="outputs" aria-expanded="true" aria-controls="palette-outputs">
                        <span class="material-icons studio-cat-chevron" aria-hidden="true">expand_more</span>
                        <span>${_('sdk_studio.cat_outputs')}</span>
                    </button>
                    <div class="studio-palette-items" id="palette-outputs"></div>
                </div>
            </div>
        </section>

        <!-- Canvas (centre) -->
        <div class="studio-canvas-wrap" id="studio-canvas-wrap">
            <svg class="studio-canvas-svg" id="studio-canvas-svg" role="img" aria-label="${_('sdk_studio.canvas_label')}">
                <defs>
                    <pattern id="studio-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                        <circle cx="1" cy="1" r="1" class="studio-grid-dot" />
                    </pattern>
                    <marker id="arrow-data" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" class="studio-arrow-data"/>
                    </marker>
                    <marker id="arrow-error" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" class="studio-arrow-error"/>
                    </marker>
                </defs>
                <rect width="100%" height="100%" fill="url(#studio-grid)" class="studio-grid-rect" id="studio-grid-rect"/>
                <g id="studio-wires-layer"></g>
                <g id="studio-nodes-layer"></g>
                <line id="studio-temp-wire" class="studio-temp-wire" x1="0" y1="0" x2="0" y2="0" style="display:none"/>
            </svg>

            <!-- Selection box -->
            <div class="studio-select-box" id="studio-select-box" style="display:none"></div>

            <!-- Minimap -->
            <div class="studio-minimap" id="studio-minimap" aria-hidden="true">
                <canvas id="studio-minimap-canvas" width="160" height="100"></canvas>
                <div class="studio-minimap-viewport" id="studio-minimap-viewport"></div>
            </div>

            <!-- Empty canvas -->
            <div class="studio-empty-state" id="studio-empty-state">
                <h2>${_('sdk_studio.empty_title')}</h2>
                <p>${_('sdk_studio.empty_desc')}</p>
                <div class="studio-empty-actions">
                    <button type="button" class="btn" id="btn-empty-template">${_('sdk_studio.browse_templates')}</button>
                </div>
            </div>
        </div>

        <!-- End side: node settings and the log -->
        <div class="studio-right-panel studio-panel" id="studio-right-panel">
            <div class="studio-panel-header">
                <button type="button" class="btn-icon studio-panel-toggle" id="btn-toggle-inspector" aria-expanded="true" aria-controls="studio-right-body"
                        aria-label="${_('sdk_studio.hide_inspector')}" title="${_('sdk_studio.hide_inspector')}"
                        data-label-hide="${_('sdk_studio.hide_inspector')}" data-label-show="${_('sdk_studio.show_inspector')}">
                    <span class="material-icons" aria-hidden="true">chevron_right</span>
                </button>
                <h2 id="studio-inspector-title">${_('sdk_studio.inspector')}</h2>
            </div>
            <div class="studio-panel-body studio-right-body" id="studio-right-body">
                <section class="studio-inspector" id="studio-inspector" aria-labelledby="studio-inspector-title">
                    <div class="studio-inspector-body" id="studio-inspector-body"></div>
                </section>

                <section class="studio-console" id="studio-console" aria-labelledby="studio-console-title">
                    <div class="studio-console-header">
                        <h2 class="studio-console-heading">
                            <button type="button" class="studio-console-toggle" id="btn-toggle-console" aria-expanded="false" aria-controls="studio-console-body">
                                <span class="material-icons studio-console-chevron" aria-hidden="true">expand_more</span>
                                <span id="studio-console-title">${_('sdk_studio.console')}</span>
                                <span class="studio-console-last" id="studio-console-last"></span>
                            </button>
                        </h2>
                        <button type="button" class="btn btn-sm btn-ghost studio-console-clear" id="btn-clear-console">${_('sdk_studio.clear_console')}</button>
                    </div>
                    <div class="studio-console-body" id="studio-console-body" role="log" aria-live="polite" tabindex="0" aria-labelledby="studio-console-title" hidden></div>
                </section>
            </div>
        </div>
    </div>

    <!-- Status line (the flow's name is in the toolbar) -->
    <div class="studio-statusbar" id="studio-statusbar">
        <span class="studio-status-item" id="status-node-count">${_('sdk_studio.nodes')}: <b id="status-nodes">0</b></span>
        <span class="studio-status-item" id="status-wire-count">${_('sdk_studio.wires')}: <b id="status-wires">0</b></span>
        <span class="studio-status-item studio-status-right" id="status-state">
            <span class="status is-neutral studio-status-dot" id="status-state-text">${_('sdk_studio.status_ready')}</span>
        </span>
    </div>
</main>

<!-- Dialogs: the bodies of Open flow, Browse templates and Save flow.
     cdap-studio.js opens them with Modal.show (modal.js). -->

<template id="tpl-open-flow">
    <div class="studio-flow-list" id="flow-list-container">
        <p class="state">${_('sdk_studio.loading')}</p>
    </div>
</template>

<template id="tpl-templates">
    <p class="studio-modal-note">${_('sdk_studio.templates_note')}</p>
    <div class="studio-template-grid" id="template-grid-container">
        <p class="state">${_('sdk_studio.loading')}</p>
    </div>
</template>

<template id="tpl-save-flow">
    <form id="save-flow-form" class="form-stack" novalidate>
        <p class="notice" id="save-flow-note" hidden></p>
        <div class="form-group">
            <label class="form-label" for="save-flow-name">${_('sdk_studio.flow_name')}</label>
            <input type="text" id="save-flow-name" class="form-input" maxlength="100" autocomplete="off" required>
        </div>
        <div class="form-group">
            <label class="form-label" for="save-flow-desc">${_('sdk_studio.flow_desc')}</label>
            <textarea id="save-flow-desc" class="form-textarea" rows="3" maxlength="500" aria-describedby="save-flow-desc-hint"></textarea>
            <p class="form-hint" id="save-flow-desc-hint">${_('sdk_studio.flow_desc_hint')}</p>
        </div>
        <p class="form-status" id="save-flow-status" role="status" aria-live="polite"></p>
        <button type="submit" hidden tabindex="-1" aria-hidden="true"></button>
    </form>
</template>

`
}) %>
