<%
    // A field's "when does this apply" line: devices fetch their policy, the
    // network rules are enforced by the signal server itself.
    const effectDevice = `<p class="field-effect">${_('policies.effect_device')}</p>`;
    const effectServer = `<p class="field-effect">${_('policies.effect_server')}</p>`;
    const tocItems = [['connection', 'connection_title'], ['features', 'features_title'], ['security', 'security_title'],
        ['network', 'network_title'], ['update', 'update_title'], ['audit', 'audit_title']];
%>
<%- include('layouts/main', {
    title: _('nav.policies'),
    uiReworked: true,
    pageStyles: ['ui/policies'],
    pageScripts: ['policies'],
    currentPage: 'policies',
    breadcrumb: [{ label: _('nav.policies') }],
    body: `
        <div class="page policy-page">
            <div class="page-head">
                <h1>${_('nav.policies')}</h1>
                <p class="page-description">${_('policies.page_description')}</p>
            </div>

            <div class="form-column policy-org-field">
                <div class="form-group">
                    <label class="form-label" for="policy-org-select">${_('policies.select_org')}</label>
                    <select id="policy-org-select" class="form-select" aria-describedby="policy-org-hint">
                        <option value="">${_('policies.select_org_placeholder')}</option>
                    </select>
                    <p class="form-hint" id="policy-org-hint">${_('policies.org_hint')}</p>
                </div>
            </div>

            <div id="policy-state" aria-live="polite">
                <p class="state">${_('policies.pick_org_state')}</p>
            </div>

            <div class="policy-sections" id="policy-sections" hidden>
            <div class="page-cols">
            <div class="page-main">
                <!-- On wide screens policies.js moves this list into the side column -->
                <div class="policy-toc-slot" id="policy-toc-inline">
                <nav class="policy-toc" id="policy-toc" aria-label="${_('policies.on_this_page')}">
                    <ul class="toc">
                        ${tocItems.map(([sec, key]) => `<li><a href="#pol-${sec}-title">${_('policies.' + key)}</a>${sec !== 'audit' ? `<span class="toc-state" data-toc-state="${sec}"></span>` : ''}</li>`).join('')}
                    </ul>
                </nav>
                </div>

                <form id="policy-form" class="form-column policy-form" autocomplete="off" novalidate data-save-form>
                    <section class="section" data-section="connection" aria-labelledby="pol-connection-title">
                        <div class="section-head">
                            <h2 id="pol-connection-title">${_('policies.connection_title')}</h2>
                            <span class="policy-state" id="conn-status"></span>
                        </div>
                        <p class="section-note">${_('policies.connection_desc')}</p>
                        <div class="form-group">
                            <label class="form-label" for="pol-connection-mode">${_('policies.connection_mode')}</label>
                            <select id="pol-connection-mode" class="form-select">
                                <option value="attended">${_('policies.mode_attended')}</option>
                                <option value="unattended">${_('policies.mode_unattended')}</option>
                                <option value="ask_always">${_('policies.mode_ask')}</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="pol-max-session">${_('policies.max_session')}</label>
                            <input type="number" id="pol-max-session" class="form-input is-short" min="0" max="1440" step="1" inputmode="numeric" aria-describedby="pol-max-session-hint">
                            <p class="form-hint" id="pol-max-session-hint">${_('policies.max_session_hint')}</p>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="pol-idle-lock">${_('policies.idle_lock')}</label>
                            <input type="number" id="pol-idle-lock" class="form-input is-short" min="0" max="120" step="1" inputmode="numeric" aria-describedby="pol-idle-lock-hint">
                            <p class="form-hint" id="pol-idle-lock-hint">${_('policies.idle_lock_hint')}</p>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="pol-wallpaper">${_('policies.wallpaper_policy')}</label>
                            <select id="pol-wallpaper" class="form-select">
                                <option value="show">${_('policies.wallpaper_show')}</option>
                                <option value="hide_during_session">${_('policies.wallpaper_hide_session')}</option>
                                <option value="hide_always">${_('policies.wallpaper_hide_always')}</option>
                            </select>
                        </div>
                        ${effectDevice}
                    </section>

                    <section class="section" data-section="features" aria-labelledby="pol-features-title">
                        <div class="section-head">
                            <h2 id="pol-features-title">${_('policies.features_title')}</h2>
                            <span class="policy-state" id="feat-status"></span>
                        </div>
                        <p class="section-note">${_('policies.features_desc')}</p>
                        <label class="check-field">
                            <input type="checkbox" id="pol-file-transfer">
                            <span class="check-label">${_('policies.allow_file_transfer')}</span>
                        </label>
                        <label class="check-field">
                            <input type="checkbox" id="pol-clipboard">
                            <span class="check-label">${_('policies.allow_clipboard')}</span>
                        </label>
                        <label class="check-field">
                            <input type="checkbox" id="pol-audio">
                            <span class="check-label">${_('policies.allow_audio')}</span>
                        </label>
                        <label class="check-field">
                            <input type="checkbox" id="pol-recording">
                            <span class="check-label">${_('policies.allow_recording')}</span>
                        </label>
                        ${effectDevice}
                    </section>

                    <section class="section" data-section="security" aria-labelledby="pol-security-title">
                        <div class="section-head">
                            <h2 id="pol-security-title">${_('policies.security_title')}</h2>
                            <span class="policy-state" id="sec-status"></span>
                        </div>
                        <p class="section-note">${_('policies.security_desc')}</p>
                        <label class="check-field">
                            <input type="checkbox" id="pol-require-2fa">
                            <span class="check-label">${_('policies.require_2fa')}</span>
                        </label>
                        <div class="form-group">
                            <label class="form-label" for="pol-pass-min">${_('policies.password_min_length')}</label>
                            <input type="number" id="pol-pass-min" class="form-input is-short" min="6" max="128" step="1" inputmode="numeric" aria-describedby="pol-pass-min-hint">
                            <p class="form-hint" id="pol-pass-min-hint">${_('policies.password_min_hint')}</p>
                        </div>
                        <label class="check-field">
                            <input type="checkbox" id="pol-pass-special">
                            <span class="check-label">${_('policies.password_require_special')}</span>
                        </label>
                        <div class="form-group">
                            <label class="form-label" for="pol-pass-age">${_('policies.password_max_age')}</label>
                            <input type="number" id="pol-pass-age" class="form-input is-short" min="0" max="365" step="1" inputmode="numeric" aria-describedby="pol-pass-age-hint">
                            <p class="form-hint" id="pol-pass-age-hint">${_('policies.password_max_age_hint')}</p>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="pol-allowed-ops">${_('policies.allowed_operators')}</label>
                            <input type="text" id="pol-allowed-ops" class="form-input" placeholder="admin, helpdesk" aria-describedby="pol-allowed-ops-hint">
                            <p class="form-hint" id="pol-allowed-ops-hint">${_('policies.allowed_operators_hint')}</p>
                        </div>
                        ${effectDevice}
                    </section>

                    <section class="section" data-section="network" aria-labelledby="pol-network-title">
                        <div class="section-head">
                            <h2 id="pol-network-title">${_('policies.network_title')}</h2>
                            <span class="policy-state" id="net-status"></span>
                        </div>
                        <p class="section-note">${_('policies.network_desc')}</p>
                        <label class="check-field">
                            <input type="checkbox" id="pol-block-p2p">
                            <span class="check-label">${_('policies.block_direct_p2p')}</span>
                            <span class="form-hint">${_('policies.block_direct_p2p_hint')}</span>
                            <span class="field-effect">${_('policies.effect_server')}</span>
                        </label>
                        <div class="form-group">
                            <label class="form-label" for="pol-relay-servers">${_('policies.allowed_relays')}</label>
                            <textarea id="pol-relay-servers" class="form-input mono" rows="3" dir="ltr" spellcheck="false" placeholder="relay1.example.com:21117" aria-describedby="pol-relay-servers-hint"></textarea>
                            <p class="form-hint" id="pol-relay-servers-hint">${_('policies.allowed_relays_hint')}</p>
                            ${effectServer}
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="pol-ip-allowlist">${_('policies.ip_allowlist')}</label>
                            <textarea id="pol-ip-allowlist" class="form-input mono" rows="3" dir="ltr" spellcheck="false" placeholder="192.168.1.0/24" aria-describedby="pol-ip-allowlist-hint"></textarea>
                            <p class="form-hint" id="pol-ip-allowlist-hint">${_('policies.ip_allowlist_hint')}</p>
                            ${effectDevice}
                        </div>
                    </section>

                    <section class="section" data-section="update" aria-labelledby="pol-update-title">
                        <div class="section-head">
                            <h2 id="pol-update-title">${_('policies.update_title')}</h2>
                            <span class="policy-state" id="upd-status"></span>
                        </div>
                        <p class="section-note">${_('policies.update_desc')}</p>
                        <label class="check-field">
                            <input type="checkbox" id="pol-auto-update">
                            <span class="check-label">${_('policies.auto_update')}</span>
                        </label>
                        <div class="form-group">
                            <label class="form-label" for="pol-update-channel">${_('policies.update_channel')}</label>
                            <select id="pol-update-channel" class="form-select is-medium">
                                <option value="stable">${_('policies.channel_stable')}</option>
                                <option value="beta">${_('policies.channel_beta')}</option>
                                <option value="dev">${_('policies.channel_dev')}</option>
                            </select>
                            <p class="form-hint">${_('policies.update_channel_hint')}</p>
                        </div>
                        ${effectDevice}
                    </section>

                    <div class="save-bar">
                        <span class="save-status" data-save-status aria-live="polite"></span>
                        <button type="submit" class="btn btn-primary" data-save-button>${_('policies.save_button')}</button>
                    </div>
                </form>

                <section class="section" data-section="audit" aria-labelledby="pol-audit-title">
                    <h2 id="pol-audit-title">${_('policies.audit_title')}</h2>
                    <p class="section-note">${_('policies.audit_desc')}</p>
                    <div id="policy-audit-list" class="policy-audit-list" aria-live="polite">
                        <p class="state">${_('policies.audit_loading')}</p>
                    </div>
                </section>
            </div>

            <!-- The organization these policies belong to, and the contents with each group's state -->
            <aside class="page-side is-sticky policy-side" aria-labelledby="policy-org-name">
                <section class="section policy-org-summary">
                    <h2 id="policy-org-name"></h2>
                    <dl class="facts" id="policy-org-facts">
                        <dt>${_('nav.devices')}</dt><dd id="policy-org-devices">…</dd>
                        <dt data-org-people>${_('policies.fact_people')}</dt><dd data-org-people id="policy-org-people">…</dd>
                        <dt>${_('policies.fact_groups_set')}</dt><dd id="policy-org-groups">…</dd>
                    </dl>
                    <p class="form-hint">${_('policies.groups_default_hint')}</p>
                    <p><a href="/organizations" id="policy-org-link">${_('policies.open_org')}</a></p>
                </section>
                <div class="policy-toc-slot" id="policy-toc-side"></div>
            </aside>
            </div>
            </div>
        </div>
    `
}) %>
