<%- include('layouts/main', {
    title: _('nav.scaling'),
    uiReworked: true,
    pageStyles: ['ui/scaling'],
    pageScripts: ['scaling'],
    currentPage: 'scaling',
    breadcrumb: [{ label: _('nav.scaling') }],
    body: `
<div class="page page-wide scaling-page" id="scaling-page" data-initial-section="${typeof activeTab !== 'undefined' ? activeTab : 'overview'}">
    <div class="page-head">
        <h1>${_('nav.scaling')}</h1>
        <p class="page-description">${_('scaling.page_description', { link: '<a href="/settings?tab=general#public-endpoints">' + _('nav.settings') + ' › ' + _('settings.tab_general') + ' › ' + _('settings.public_endpoints_title') + '</a>' })}</p>
        <div class="page-actions">
            <button type="button" class="btn btn-primary" data-bd-call="Scaling.showAddRelay">${_('scaling.relay_add')}</button>
        </div>
    </div>

    <section class="section" id="panel-relays" aria-labelledby="relays-title">
        <div class="section-head"><h2 id="relays-title">${_('scaling.relays_title')}</h2></div>
        <p class="section-note">${_('scaling.relays_info_banner')}</p>
        <div class="toolbar">
            <div class="toolbar-search search-wrapper">
                <span class="material-icons" aria-hidden="true">search</span>
                <input type="search" id="relay-search" class="form-input" aria-label="${_('scaling.relay_search')}" placeholder="${_('scaling.relay_search')}">
            </div>
        </div>
        <p class="count-line" id="relays-count" aria-live="polite"></p>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="relays-title">
            <table class="data-table" id="relays-table">
                <thead>
                    <tr>
                        <th scope="col">${_('scaling.col_name')}</th>
                        <th scope="col">${_('scaling.col_address')}</th>
                        <th scope="col">${_('scaling.col_limits')}</th>
                        <th scope="col">${_('scaling.col_status')}</th>
                        <th scope="col" class="actions"><span class="sr-only">${_('scaling.col_actions')}</span></th>
                    </tr>
                </thead>
                <tbody id="relays-tbody">
                    <tr><td colspan="5" class="state-cell">${_('scaling.relays_loading')}</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="section" id="panel-rules" aria-labelledby="rules-title">
        <div class="section-head">
            <h2 id="rules-title">${_('scaling.tab_rules')}</h2>
            <button type="button" class="btn btn-sm" id="rule-add-btn" data-bd-call="Scaling.showAddRule">${_('scaling.rule_add')}</button>
        </div>
        <p class="section-note">${_('scaling.rules_hint')}</p>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="rules-title">
            <table class="data-table" id="rules-table">
                <thead>
                    <tr>
                        <th scope="col" class="num-col">${_('scaling.col_priority')}</th>
                        <th scope="col">${_('scaling.col_rule_name')}</th>
                        <th scope="col">${_('scaling.col_match')}</th>
                        <th scope="col">${_('scaling.col_target_relay')}</th>
                        <th scope="col">${_('scaling.col_fallback')}</th>
                        <th scope="col">${_('scaling.col_status')}</th>
                        <th scope="col" class="actions"><span class="sr-only">${_('scaling.col_actions')}</span></th>
                    </tr>
                </thead>
                <tbody id="rules-tbody">
                    <tr><td colspan="7" class="state-cell">${_('scaling.rules_loading')}</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="section" id="panel-capacity" aria-labelledby="capacity-title">
        <div class="section-head"><h2 id="capacity-title">${_('scaling.tab_capacity')}</h2></div>
        <p class="section-note">${_('scaling.capacity_note')}</p>
        <dl class="facts" id="capacity-tiers">
            <dt>${_('scaling.cap_tier_devices')}</dt><dd>–</dd>
        </dl>
        <p id="capacity-recommendations" class="scaling-recommendation"></p>
        <details class="disclosure">
            <summary><h3>${_('scaling.cap_planning')}</h3></summary>
            <p class="section-note scaling-planning-note">${_('scaling.cap_planning_note')}</p>
            <div class="table-scroll" tabindex="0" role="region" aria-label="${_('scaling.cap_planning')}">
                <table class="data-table" id="capacity-table">
                    <thead>
                        <tr>
                            <th scope="col">${_('scaling.cap_config')}</th>
                            <th scope="col" class="num-col">${_('scaling.cap_max_devices')}</th>
                            <th scope="col" class="num-col">${_('scaling.cap_max_sessions')}</th>
                            <th scope="col">${_('scaling.cap_utilization')}</th>
                        </tr>
                    </thead>
                    <tbody id="capacity-tbody"></tbody>
                </table>
            </div>
        </details>
    </section>
</div>
` }) %>
