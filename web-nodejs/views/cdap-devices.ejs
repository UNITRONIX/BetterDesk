<%
    const canToggleGateway = !!(user && user.role === 'admin');
    const cdapTypes = [
        ['', _('common.all')],
        ['iot', _('cdap.type_iot')],
        ['scada', _('cdap.type_scada')],
        ['os_agent', _('cdap.type_os_agent')],
        ['network', _('cdap.type_network')],
        ['camera', _('cdap.type_camera')],
        ['custom', _('cdap.type_custom')]
    ];
%>
<%- include('layouts/main', {
    title: _('nav.cdap'),
    uiReworked: true,
    pageStyles: ['ui/cdap'],
    pageScripts: ['cdap-devices'],
    currentPage: 'cdap',
    breadcrumb: [
        { label: _('nav.cdap') }
    ],
    body: `
<div class="page page-wide cdap-list-page">
    <div class="page-head">
        <h1>${_('nav.cdap')}</h1>
        <p class="page-description">${_('cdap.page_description')}</p>
    </div>

    <div class="page-cols">
    <div class="page-main">
    <!-- Gateway turned off -->
    <div class="cdap-disabled hidden" id="cdap-disabled-banner">
        <p class="state">${_('cdap.gateway_off_state')}</p>
        ${canToggleGateway ? `
        <div class="cdap-enable-row">
            <button type="button" class="btn btn-primary" id="cdap-enable-btn">${_('cdap.toggle_enable')}</button>
            <span class="form-status" id="cdap-enable-status" aria-live="polite"></span>
        </div>` : ''}
    </div>

    <section class="section" id="cdap-list-section" aria-labelledby="cdap-list-title">
        <h2 id="cdap-list-title" class="sr-only">${_('cdap.devices_heading')}</h2>
        <div class="toolbar">
            <div class="toolbar-search search-wrapper">
                <span class="material-icons" aria-hidden="true">search</span>
                <input type="search" class="form-input" id="cdap-search" aria-label="${_('cdap.search_devices')}" placeholder="${_('cdap.search_devices')}">
            </div>
            <div class="toolbar-filters" id="cdap-type-filter" role="group" aria-label="${_('cdap.filter_type')}">
                ${cdapTypes.map(([type, label]) => `<button type="button" class="filter-btn ${type === '' ? 'active' : ''}" aria-pressed="${type === ''}" data-type="${type}">${label}</button>`).join('')}
            </div>
        </div>
        <p class="count-line" id="cdap-count" aria-live="polite"></p>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="cdap-list-title">
            <table class="data-table cdap-table-list">
                <thead>
                    <tr>
                        <th scope="col">${_('cdap.col_device')}</th>
                        <th scope="col">${_('cdap.col_type')}</th>
                        <th scope="col">${_('cdap.col_status')}</th>
                        <th scope="col">${_('cdap.col_address')}</th>
                        <th scope="col">${_('cdap.col_connected_for')}</th>
                        <th scope="col" class="cdap-num">${_('cdap.col_widgets')}</th>
                        <th scope="col" class="cdap-num">${_('cdap.col_heartbeats')}</th>
                    </tr>
                </thead>
                <tbody id="cdap-device-grid">
                    <tr id="cdap-list-loading"><td colspan="7" class="state-cell">${_('cdap.loading_devices')}</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    </div>

    <!-- The gateway the devices connect to: its state, and turning it off -->
    <aside class="page-side cdap-side" id="cdap-side" aria-labelledby="cdap-gw-title">
    <section class="section" aria-labelledby="cdap-gw-title">
        <h2 id="cdap-gw-title">${_('cdap.danger_zone')}</h2>
        <p class="cdap-gateway" id="cdap-gateway-banner" aria-live="polite">
            <span class="status" id="cdap-gw-status"><span id="cdap-gw-status-text">${_('cdap.gateway_checking')}</span></span>
        </p>
        <p class="section-note">${_('cdap.gateway_note')}</p>
    </section>
    ${canToggleGateway ? `
    <section class="danger-zone" id="cdap-danger-zone" aria-label="${_('cdap.disable_title')}">
        <ul class="list">
            <li class="list-row">
                <span class="row-main">
                    <span class="row-title">${_('cdap.disable_title')}</span>
                    <span class="row-sub">${_('cdap.disable_desc')}</span>
                </span>
                <span class="row-end">
                    <button type="button" class="btn btn-danger-quiet" id="cdap-toggle-btn">${_('cdap.toggle_disable')}</button>
                </span>
            </li>
        </ul>
        <p class="form-status" id="cdap-toggle-status" aria-live="polite"></p>
    </section>` : ''}
    </aside>
    </div>
</div>
` }) %>
