<%- include('layouts/main', {
    title: _('nav.registrations'),
    uiReworked: true,
    pageStyles: ['ui/registrations'],
    pageScripts: ['registrations'],
    currentPage: 'registrations',
    breadcrumb: [{ label: _('nav.registrations') }],
    body: `
        <div class="page page-wide registrations-page">
            <div class="page-head">
                <h1>${_('nav.registrations')}</h1>
                <p class="page-description">${_('registrations.page_description')}</p>
            </div>

            <section class="section" aria-label="${_('nav.registrations')}">
                <p class="notice warning" id="enrollment-mode-banner" hidden>
                    <span id="enrollment-mode-banner-text"></span>
                    <a href="/settings#auth" id="enrollment-mode-link" hidden>${_('registrations.mode_link')}</a>
                </p>

                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" class="form-input" id="search-input"
                            aria-label="${_('registrations.search_label')}"
                            placeholder="${_('registrations.search_label')}">
                    </div>
                    <div class="toolbar-filters" role="group" aria-label="${_('registrations.col_status')}">
                        <button type="button" class="filter-btn active" aria-pressed="true" data-status="pending">${_('registrations.filter_waiting')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="approved">${_('registrations.status_approved')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="rejected">${_('registrations.status_rejected')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="">${_('registrations.filter_all')}</button>
                    </div>
                </div>
                <p class="count-line" id="registrations-count" aria-live="polite"></p>

                <table class="data-table registrations-table" id="registrations-table">
                    <thead>
                        <tr>
                            <th>${_('registrations.col_device')}</th>
                            <th class="col-platform">${_('registrations.col_platform')}</th>
                            <th class="col-ip">${_('registrations.col_ip')}</th>
                            <th class="col-source">${_('registrations.col_source')}</th>
                            <th class="col-requested">${_('registrations.col_asked')}</th>
                            <th class="col-status">${_('registrations.col_status')}</th>
                            <th class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                        </tr>
                    </thead>
                    <tbody id="registrations-body">
                        <tr><td colspan="7" class="state-cell">${_('registrations.loading')}</td></tr>
                    </tbody>
                </table>
            </section>
        </div>
    `
}) %>
