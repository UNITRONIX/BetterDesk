<%
// Public download page for the generic support agent (/portal). No auth, no shared layout.
const themeMode = (typeof branding !== 'undefined' && branding && branding.themeMode) || 'system';
const dataTheme = themeMode === 'dark' ? 'dark' : 'light';
const nonce = typeof cspNonce !== 'undefined' ? cspNonce : '';
const ver = typeof cacheVersion !== 'undefined' ? cacheVersion : '';
const name = (typeof appName !== 'undefined' && appName) || 'BetterDesk';
%><!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang ? lang : 'en' %>" dir="<%= typeof isRtl !== 'undefined' && isRtl ? 'rtl' : 'ltr' %>" data-theme="<%= dataTheme %>" data-theme-mode="<%= themeMode %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= _('portal.title') %> - <%= name %></title>
    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg">
    <% if (typeof cspNonce !== 'undefined') { %><%- include('partials/theme-head') %><% } %>
    <link rel="stylesheet" href="/css/branding.css?v=<%= typeof brandingRevision !== 'undefined' ? brandingRevision : ver %>">
    <link rel="stylesheet" href="/css/ui/tokens.css?v=<%= ver %>">
    <link rel="stylesheet" href="/css/ui/base.css?v=<%= ver %>">
    <link rel="stylesheet" href="/css/ui/components.css?v=<%= ver %>">
    <link rel="stylesheet" href="/css/ui/agent-download.css?v=<%= ver %>">
</head>
<body class="dl-page">
    <main class="dl-main">
        <div class="page dl-content">
            <header class="dl-head">
                <h1><%= _('portal.title') %></h1>
                <p class="page-description"><%= _('portal.description') %></p>
            </header>

            <section class="section" aria-labelledby="portal-list-title">
                <div class="section-head"><h2 id="portal-list-title"><%= _('download.choose_platform') %></h2></div>
                <p class="count-line" id="portal-release" hidden></p>
                <div id="installer-grid" aria-live="polite">
                    <p class="state"><%= _('portal.loading') %></p>
                </div>
            </section>

            <p class="dl-footer"><%= _('portal.footer') %></p>
        </div>
    </main>

    <script nonce="<%= nonce %>">
        (function () {
            var text = <%- JSON.stringify({
                download: _('download.download'),
                thisDevice: _('download.this_device'),
                release: _('portal.release'),
                empty: _('portal.empty'),
                noRelease: _('portal.no_release'),
                incomplete: _('portal.incomplete'),
                failed: _('portal.load_failed'),
                retry: _('actions.retry'),
                portable: _('portal.format_portable'),
            }).replace(/</g, '\\u003c') %>;
            var ver = <%- JSON.stringify(String(ver)) %>;
            var names = { windows: 'Windows', linux: 'Linux', macos: 'macOS' };
            var marks = { windows: 'windows', linux: 'linux', macos: 'apple' };
            var grid = document.getElementById('installer-grid');

            function detect() {
                var ua = navigator.userAgent || '';
                var arm = /arm64|aarch64/i.test(ua);
                if (/Windows/i.test(ua)) return { platform: 'windows', arch: arm ? 'arm64' : 'x64' };
                if (/Mac OS X|Macintosh/i.test(ua) && !/iPhone|iPad/i.test(ua)) return { platform: 'macos' };
                if (/Linux/i.test(ua) && !/Android/i.test(ua)) return { platform: 'linux', arch: arm ? 'arm64' : 'x64' };
                return null;
            }

            function state(message, isError) {
                grid.replaceChildren();
                var p = document.createElement('p');
                p.className = 'state' + (isError ? ' is-error' : '');
                p.textContent = message;
                if (isError) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'btn btn-sm';
                    b.textContent = text.retry;
                    b.addEventListener('click', load);
                    p.appendChild(b);
                }
                grid.appendChild(p);
            }

            function render(data) {
                var mine = detect();
                var picked = false;
                var list = document.createElement('ul');
                list.className = 'list dl-list';
                data.installers.forEach(function (i) {
                    var li = document.createElement('li');
                    li.className = 'list-row';
                    var mark = marks[i.platform];
                    if (mark) {
                        var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                        svg.setAttribute('class', 'os-icon');
                        svg.setAttribute('aria-hidden', 'true');
                        var use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
                        use.setAttribute('href', '/img/os-icons.svg?v=' + encodeURIComponent(ver) + '#' + mark);
                        svg.appendChild(use);
                        li.appendChild(svg);
                    }
                    var main = document.createElement('span');
                    main.className = 'row-main';
                    var title = document.createElement('span');
                    title.className = 'row-title';
                    var format = (i.format === 'portable' ? text.portable : (i.format || ''));
                    title.textContent = (names[i.platform] || i.platform) + ' ' + (i.arch || '') + (format ? ', ' + format : '');
                    main.appendChild(title);
                    var match = !picked && mine && i.platform === mine.platform && (!mine.arch || i.arch === mine.arch);
                    if (match) {
                        picked = true;
                        var sub = document.createElement('span');
                        sub.className = 'row-sub';
                        sub.textContent = text.thisDevice;
                        main.appendChild(sub);
                    }
                    li.appendChild(main);
                    var end = document.createElement('span');
                    end.className = 'row-end';
                    var a = document.createElement('a');
                    a.className = 'btn' + (match ? ' btn-primary' : '');
                    a.href = i.url;
                    a.textContent = text.download;
                    end.appendChild(a);
                    li.appendChild(end);
                    list.appendChild(li);
                });
                grid.replaceChildren(list);
                var rel = document.getElementById('portal-release');
                if (rel && data.release) {
                    // "Version 1.4.2": the number as a .version value, no leading "v"
                    var parts = text.release.split('{tag}');
                    var v = document.createElement('span');
                    v.className = 'version';
                    v.textContent = String(data.release).replace(/^v(?=\d)/i, '');
                    rel.replaceChildren(parts[0] || '', v, parts.slice(1).join(''));
                    rel.hidden = false;
                }
            }

            function load() {
                state(<%- JSON.stringify(_('portal.loading')).replace(/</g, '\\u003c') %>, false);
                fetch('/api/portal/installers', { credentials: 'omit' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data || !data.success || !Array.isArray(data.installers) || data.installers.length === 0) {
                            var msg = text.empty;
                            if (data && data.reason === 'no_release_imported') msg = text.noRelease;
                            else if (data && data.reason === 'release_cache_incomplete') msg = text.incomplete;
                            state(msg, false);
                            return;
                        }
                        render(data);
                    })
                    .catch(function () { state(text.failed, true); });
            }
            load();
        })();
    </script>
</body>
</html>
