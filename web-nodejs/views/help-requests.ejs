<%- include('layouts/main', {
    title: _('nav.help_requests'),
    uiReworked: true,
    pageStyles: ['ui/chart', 'ui/help-requests'],
    pageScripts: ['ui-chart', 'help-requests'],
    currentPage: 'help-requests',
    breadcrumb: [{ label: _('nav.help_requests') }],
    body: `
        <div class="page page-wide help-requests-page">
            <div class="page-head">
                <h1>${_('nav.help_requests')}</h1>
                <p class="page-description">${_('help_request.page_description')}
                    ${_('help_request.page_related').replace('{tickets}', '<a href="/tickets">' + _('nav.tickets') + '</a>').replace('{chat}', '<a href="/chat">' + _('nav.chat') + '</a>')}</p>
            </div>

            <div class="page-cols">
            <div class="page-main">
            <section class="section" aria-label="${_('nav.help_requests')}">
                <div class="toolbar">
                    <div class="toolbar-filters" role="group" aria-label="${_('help_request.status')}">
                        <button type="button" class="filter-btn active" aria-pressed="true" data-status="open">${_('help_request.filter_open')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="pending">${_('help_request.filter_waiting')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="accepted">${_('help_request.accepted')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="resolved">${_('help_request.resolved')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="">${_('help_request.filter_all')}</button>
                    </div>
                    <div class="toolbar-end">
                        <select class="form-select" id="hr-sort" aria-label="${_('help_request.sort_label')}">
                            <option value="oldest">${_('help_request.sort_oldest')}</option>
                            <option value="newest">${_('help_request.sort_newest')}</option>
                        </select>
                    </div>
                </div>
                <p class="count-line" id="hr-count"></p>
                <p class="sr-only" id="hr-live" aria-live="polite"></p>

                <table class="data-table hr-table" id="hr-table">
                    <thead>
                        <tr>
                            <th>${_('help_request.message')}</th>
                            <th class="col-device">${_('help_request.device')}</th>
                            <th class="col-age">${_('help_request.col_asked')}</th>
                            <th class="col-status">${_('help_request.status')}</th>
                            <th class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                        </tr>
                    </thead>
                    <tbody id="hr-list">
                        <tr><td colspan="5" class="state-cell" id="hr-empty">${_('help_request.loading')}</td></tr>
                    </tbody>
                </table>
            </section>
            </div>

            <aside class="page-side" aria-label="${_('help_request.side_label')}">
                <!-- Every loaded request split by status; each part filters the table -->
                <section class="section" aria-labelledby="hr-share-title">
                    <div class="section-head"><h2 id="hr-share-title">${_('help_request.share_title')}</h2></div>
                    <div class="share-bar" id="hr-share-bar" aria-hidden="true" hidden></div>
                    <ul class="share-legend hr-share-legend" id="hr-share-legend"></ul>
                </section>

                <!-- Opened and resolved per day, from the same list (public/js/ui-chart.js) -->
                <section class="section" aria-labelledby="hr-trend-title">
                    <div class="section-head"><h2 id="hr-trend-title">${_('help_request.trend_title')}</h2></div>
                    <p class="section-note" id="hr-trend-note">${_('help_request.trend_note')}</p>
                    <div id="hr-trend"></div>
                </section>
            </aside>
            </div>
        </div>
    `
}) %>
