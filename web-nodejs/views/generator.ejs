<%- include('layouts/main', {
    title: _('nav.generator'),
    pageStyles: ['pages', 'generator'],
    pageScripts: ['generator'],
    currentPage: 'generator',
    breadcrumb: [{ label: _('nav.generator') }],
    body: `
        <div class="page-header">
            <h1 class="page-title">
                <span class="material-icons">support_agent</span>
                ${_('generator.title')}
            </h1>
            <p class="page-subtitle">${_('generator.subtitle')}</p>
        </div>

        <!-- Module install gate (shown when templates are not ready) -->
        <div id="gen-module-gate" class="card generator-module-gate hidden">
            <div class="card-header">
                <h2 class="card-title">
                    <span class="material-icons">extension</span>
                    ${_('generator.module_title')}
                </h2>
            </div>
            <div class="card-body">
                <p class="gen-module-intro">${_('generator.module_intro')}</p>
                <ul class="gen-module-bullets">
                    <li>${_('generator.module_bullet_incoming')}</li>
                    <li>${_('generator.module_bullet_platforms')}</li>
                    <li>${_('generator.module_bullet_terms')}</li>
                </ul>
                <div id="gen-module-status" class="gen-module-status text-muted">${_('generator.module_checking')}</div>
                <div class="gen-module-actions">
                    <button id="gen-accept-terms" class="btn btn-secondary" type="button">
                        <span class="material-icons">gavel</span>
                        ${_('generator.module_accept_terms')}
                    </button>
                    <button id="gen-install-module" class="btn btn-primary" type="button" disabled>
                        <span class="material-icons">download</span>
                        <span class="gen-install-label">${_('generator.module_install')}</span>
                    </button>
                    <button id="gen-finish-install" class="btn btn-success hidden" type="button">
                        <span class="material-icons">check_circle</span>
                        ${_('generator.module_finish')}
                    </button>
                </div>
            </div>
        </div>

        <div id="gen-main" class="generator-layout hidden">
            <!-- Left column: bundle list -->
            <aside class="generator-bundles card">
                <div class="card-header">
                    <h2 class="card-title">
                        <span class="material-icons">inventory_2</span>
                        ${_('generator.bundles_title')}
                    </h2>
                    <button id="gen-new-support" class="btn btn-primary btn-sm" title="${_('generator.new_bundle')}">
                        <span class="material-icons">add</span>
                        ${_('generator.new_bundle')}
                    </button>
                </div>
                <div class="card-body">
                    <div id="gen-bundle-list" class="bundle-list">
                        <p class="text-muted">${_('generator.loading')}</p>
                    </div>
                </div>
            </aside>

            <!-- Right column: editor -->
            <section class="generator-editor card">
                <div class="card-header">
                    <h2 class="card-title" id="gen-editor-title">
                        <span class="material-icons">edit</span>
                        ${_('generator.editor_title')}
                    </h2>
                    <div class="editor-actions">
                        <button id="gen-revoke-btn" class="btn btn-warning btn-sm hidden">
                            <span class="material-icons">block</span>
                            ${_('generator.revoke')}
                        </button>
                        <button id="gen-delete-btn" class="btn btn-danger btn-sm hidden">
                            <span class="material-icons">delete</span>
                            ${_('common.delete')}
                        </button>
                        <button id="gen-rebuild-btn" class="btn btn-secondary btn-sm hidden">
                            <span class="material-icons">rebuild</span>
                            ${_('generator.rebuild')}
                        </button>
                        <button id="gen-save-btn" class="btn btn-primary btn-sm" disabled>
                            <span class="material-icons">save</span>
                            ${_('common.save')}
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="gen-empty-state" class="empty-state">
                        <span class="material-icons">touch_app</span>
                        <p>${_('generator.empty_state')}</p>
                    </div>

                    <div id="gen-editor-form" class="editor-form hidden">
                        <div class="editor-fields">
                            <div class="form-group">
                                <label class="form-label" for="gen-name">${_('generator.bundle_name')}</label>
                                <input type="text" id="gen-name" class="form-input" maxlength="100" required>
                                <p class="form-hint">${_('generator.bundle_name_hint')}</p>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="gen-slug">${_('generator.short_link')}</label>
                                <div class="download-link-row">
                                    <span class="input-prefix">/d/</span>
                                    <input type="text" id="gen-slug" class="form-input" maxlength="32"
                                           pattern="[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?"
                                           autocomplete="off" spellcheck="false">
                                </div>
                                <p class="form-hint">${_('generator.short_link_hint')}</p>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="gen-app-name">App name</label>
                                <input type="text" id="gen-app-name" class="form-input" maxlength="100"
                                       placeholder="BetterDesk Support Agent">
                                <p class="form-hint">Shown in the desktop client window title. Optional company label only — colors/logo come from Client Branding at runtime.</p>
                            </div>

                            <h3 class="section-title">${_('generator.connection_section')}</h3>

                            <div class="form-group">
                                <label class="form-label" for="gen-server-host">${_('generator.server_host')}</label>
                                <input type="text" id="gen-server-host" class="form-input" maxlength="253"
                                       placeholder="${_('generator.server_host_placeholder')}" required>
                                <p class="form-hint">${_('generator.server_host_hint')}</p>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="gen-relay-host">Relay host</label>
                                <input type="text" id="gen-relay-host" class="form-input" maxlength="253"
                                       placeholder="Same as server host if empty">
                            </div>

                            <div class="form-row">
                                <div class="form-group form-group-checkbox">
                                    <label class="form-label">
                                        <input type="checkbox" id="gen-use-https" checked>
                                        ${_('generator.use_https')}
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="gen-api-port">API port</label>
                                    <input type="text" id="gen-api-port" class="form-input" maxlength="8" placeholder="21114">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="gen-public-key">Server public key</label>
                                <input type="text" id="gen-public-key" class="form-input" readonly>
                                <p class="form-hint">Injected from this console (id_ed25519.pub).</p>
                            </div>

                            <h3 class="section-title">${_('generator.platforms_section')}</h3>
                            <p class="form-hint">${_('generator.platforms_hint')}</p>
                            <div id="gen-platforms" class="platforms-checklist" role="group" aria-label="${_('generator.platforms_section')}"></div>

                            <div id="gen-download-info" class="download-info hidden">
                                <h3 class="section-title">${_('generator.download_hub')}</h3>
                                <div class="download-link-row">
                                    <input type="text" id="gen-download-url" class="form-input" readonly>
                                    <button type="button" id="gen-copy-link" class="btn btn-secondary btn-sm">
                                        <span class="material-icons">content_copy</span>
                                    </button>
                                    <a id="gen-open-link" class="btn btn-secondary btn-sm" target="_blank" rel="noopener">
                                        <span class="material-icons">open_in_new</span>
                                    </a>
                                </div>
                            </div>

                            <div id="gen-builds-section" class="builds-section">
                                <div class="builds-header">
                                    <h3 class="section-title">${_('generator.builds')}</h3>
                                    <span id="gen-builds-summary" class="text-muted"></span>
                                </div>
                                <div id="gen-builds-list" class="builds-list"></div>
                            </div>

                            <div id="gen-validation-errors" class="validation-errors hidden"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    `
}); %>
