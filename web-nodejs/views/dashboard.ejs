<%
    const canApprove = typeof hasPermission === 'function' && hasPermission('enrollment.approve');
    const canSeeDevices = typeof hasPermission === 'function' && hasPermission('device.view');
    const canServerConfig = typeof hasPermission === 'function' && hasPermission('server.config');
%>
<%- include('layouts/main', {
    title: (typeof activateAgentNav !== 'undefined' && activateAgentNav) ? _('nav.activate_agent') : _('nav.dashboard'),
    pageStyles: ['ui/chart', 'ui/dashboard'],
    pageScripts: ['dashboard', 'ui-chart', 'reports-trends'],
    currentPage: 'dashboard',
    activateAgentNav: typeof activateAgentNav !== 'undefined' && activateAgentNav,
    body: `
        <div class="page page-wide dashboard-page" id="welcome-section">
            <div class="page-head">
                <h1>${_('nav.dashboard')}</h1>
                <p class="page-description">${_('dashboard.page_intro')}</p>
                ${canSeeDevices ? `
                <!-- The most common job: someone reads out an ID or a name -->
                <form class="overview-find page-actions" action="/devices" method="get" role="search" aria-label="${_('dashboard.find_device')}">
                    <label class="sr-only" for="overview-find-input">${_('dashboard.find_device')}</label>
                    <div class="search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" class="form-input" id="overview-find-input" name="search" autocomplete="off" spellcheck="false"
                               placeholder="${_('dashboard.find_device_long')}">
                    </div>
                    <button type="submit" class="btn">${_('dashboard.find_device_button')}</button>
                </form>` : ''}
            </div>

            <div class="page-cols">
            <div class="page-main">
            <!-- Attention and device counts are short: side by side when the main column is wide -->
            <div class="cols overview-now">
            <!-- Only things someone has to act on; each row shows when its count is above zero -->
            <section class="section attention" aria-labelledby="attention-title">
                <div class="section-head"><h2 id="attention-title">${_('dashboard.attention_panel')}</h2></div>
                <ul class="list attention-list" id="attention-list">
                    <li class="attention-row attention-server" id="dashboard-system-pill" hidden aria-live="polite">
                        <a href="/server-management?tab=overview" class="list-row">
                            <span class="row-mark danger" aria-hidden="true"></span>
                            <span class="row-main">
                                <span class="row-title">${_('dashboard.server_status')}</span>
                                <span class="row-sub" id="dashboard-system-status">${_('status.checking')}</span>
                            </span>
                            <span class="material-icons row-chevron" aria-hidden="true">chevron_right</span>
                        </a>
                    </li>
                    ${canApprove ? `
                    <li class="attention-row" id="attention-enrollment" hidden>
                        <a href="/registrations" class="list-row">
                            <span class="row-mark" aria-hidden="true"></span>
                            <span class="row-count attention-count">0</span>
                            <span class="row-main row-title">${_('nav.registrations')}</span>
                            <span class="material-icons row-chevron" aria-hidden="true">chevron_right</span>
                        </a>
                    </li>` : ''}
                    ${canSeeDevices ? `
                    <li class="attention-row" id="attention-help" hidden>
                        <a href="/help-requests" class="list-row">
                            <span class="row-mark" aria-hidden="true"></span>
                            <span class="row-count attention-count">0</span>
                            <span class="row-main row-title">${_('nav.help_requests')}</span>
                            <span class="material-icons row-chevron" aria-hidden="true">chevron_right</span>
                        </a>
                    </li>
                    <li class="attention-row" id="attention-banned" hidden>
                        <a href="/devices?status=banned" class="list-row">
                            <span class="row-mark danger" aria-hidden="true"></span>
                            <span class="row-count attention-count">0</span>
                            <span class="row-main row-title">${_('dashboard.banned')}</span>
                            <span class="material-icons row-chevron" aria-hidden="true">chevron_right</span>
                        </a>
                    </li>` : ''}
                    <li class="list-row is-empty" id="attention-none" hidden>${_('dashboard.attention_none')}</li>
                </ul>
            </section>

            ${canSeeDevices ? `
            <!-- How the devices are doing right now: a count sentence and the parts of the whole -->
            <section class="section devices-now" aria-labelledby="devices-now-title">
                <div class="section-head">
                    <h2 id="devices-now-title">${_('nav.devices')}</h2>
                    <a href="/devices">${_('dashboard.open_device_list')}</a>
                </div>
                <p class="count-line" id="devices-now-line" aria-live="polite">${_('status.checking')}</p>
                <div class="share-bar" id="devices-now-bar" aria-hidden="true"></div>
                <ul class="share-legend" id="devices-now-legend"></ul>
                <span id="stat-total" hidden></span><span id="stat-online" hidden></span><span id="stat-banned" hidden></span><span id="stat-connections" hidden></span>
            </section>` : ''}
            </div>

            ${typeof hasPermission === 'function' && hasPermission('audit.view') ? `
            <!-- Two weeks of remote sessions and help requests (public/js/reports-trends.js) -->
            <section class="section overview-trends" id="reports-trends" data-trends-compact hidden></section>` : ''}
            </div>

            <aside class="page-side" aria-label="${_('dashboard.client_config_title')}">
            <!-- Values to type into RustDesk -->
            <section class="section client-setup" aria-labelledby="client-config-title">
                <div class="section-head"><h2 id="client-config-title">${_('dashboard.client_config_title')}</h2></div>
                <p class="section-note">${_('dashboard.client_config_hint')}</p>
                <p class="notice warning" id="client-config-local-warning" hidden>${_('dashboard.client_config_local_warning')}</p>

                <div class="form-group client-config-host-row" id="client-config-host-row">
                    <label class="form-label" for="client-config-host-input">${_('dashboard.client_server_host_label')}</label>
                    <div class="client-config-host-controls">
                        <input type="text" class="form-input client-config-host-input" id="client-config-host-input"
                               placeholder="${_('dashboard.client_server_host_placeholder')}" autocomplete="off" spellcheck="false">
                        <button type="button" class="btn btn-secondary" id="apply-client-host-btn">${_('dashboard.apply_client_host')}</button>
                    </div>
                    <p class="form-hint client-config-host-hint" id="client-config-host-hint">${_('dashboard.client_server_host_hint')}</p>
                    <p class="form-hint client-config-env-badge" id="client-config-env-badge" hidden>${_('dashboard.client_server_host_env_hint')}</p>
                    <p class="form-hint client-config-host-env-link" id="client-config-host-env-link" hidden>
                        <a href="/settings#public-endpoints">${_('dashboard.client_host_settings_link')}</a>
                    </p>
                </div>

                <dl class="facts client-config-grid">
                    <dt>${_('dashboard.config_server_id')}</dt>
                    <dd><span class="value-field"><code class="client-config-value" id="client-config-server-id">…</code><button type="button" class="client-config-copy" data-copy-target="client-config-server-id" aria-label="${_('actions.copy')} ${_('dashboard.config_server_id')}">${_('actions.copy')}</button></span></dd>
                    <dt>${_('dashboard.config_relay_server')}</dt>
                    <dd><span class="value-field"><code class="client-config-value" id="client-config-relay-server">…</code><button type="button" class="client-config-copy" data-copy-target="client-config-relay-server" aria-label="${_('actions.copy')} ${_('dashboard.config_relay_server')}">${_('actions.copy')}</button></span></dd>
                    <dt>${_('dashboard.config_api_server')}</dt>
                    <dd><span class="value-field"><code class="client-config-value" id="client-config-api-url">…</code><button type="button" class="client-config-copy" data-copy-target="client-config-api-url" aria-label="${_('actions.copy')} ${_('dashboard.config_api_server')}">${_('actions.copy')}</button></span></dd>
                    <dt>${_('dashboard.config_key')}</dt>
                    <dd><span class="value-field"><code class="client-config-value is-masked" id="client-config-public-key">…</code><button type="button" class="client-config-reveal" id="client-config-key-reveal" aria-label="${_('actions.show_value')} ${_('dashboard.config_key')}" aria-pressed="false"><span class="btn-label">${_('actions.show_value')}</span></button><button type="button" class="client-config-copy" data-copy-target="client-config-public-key" aria-label="${_('actions.copy')} ${_('dashboard.config_key')}">${_('actions.copy')}</button></span></dd>
                </dl>

                <div class="page-actions client-config-actions">
                    ${canApprove ? `<button type="button" class="btn btn-primary" id="activate-agent-qr-btn">${_('dashboard.activate_agent_qr')}</button>` : ''}
                    <button type="button" class="btn btn-secondary" id="copy-client-config-btn"><span class="material-icons" aria-hidden="true">content_copy</span>${_('dashboard.copy_all_config')}</button>
                    <button type="button" class="btn btn-secondary" id="show-client-qr-btn"><span class="material-icons" aria-hidden="true">qr_code_2</span>${_('dashboard.show_config_qr')}</button>
                    <span class="menu-anchor">
                        <button type="button" class="btn btn-secondary" data-menu-button aria-haspopup="menu" aria-expanded="false" aria-controls="client-config-more">
                            ${_('mobile_nav.more')}<span class="material-icons btn-caret" aria-hidden="true">expand_more</span>
                        </button>
                        <span class="menu" id="client-config-more" role="menu">
                            <button type="button" class="menu-item" role="menuitem" id="copy-deploy-string-btn"><span class="material-icons" aria-hidden="true">content_copy</span>${_('dashboard.copy_deploy_string')}</button>
                            <button type="button" class="menu-item" role="menuitem" id="show-intune-script-btn"><span class="material-icons" aria-hidden="true">terminal</span>${_('dashboard.show_intune_script')}</button>
                        </span>
                    </span>
                </div>

                <ul class="list client-config-links">
                    <li><a href="https://github.com/rustdesk/rustdesk/releases/latest" class="list-row" target="_blank" rel="noopener noreferrer">
                        <span class="row-main"><span class="row-title">${_('dashboard.get_rustdesk')}</span><span class="row-sub">${_('dashboard.get_rustdesk_hint')}</span></span>
                        <span class="material-icons row-chevron" aria-hidden="true">open_in_new</span>
                    </a></li>
                    ${canServerConfig ? `<li><a href="/agents" class="list-row">
                        <span class="row-main"><span class="row-title">${_('dashboard.open_agents')}</span><span class="row-sub">${_('dashboard.agents_hint')}</span></span>
                        <span class="material-icons row-chevron" aria-hidden="true">chevron_right</span>
                    </a></li>
                    <li><a href="/keys" class="list-row">
                        <span class="row-main row-title">${_('dashboard.open_keys')}</span>
                        <span class="material-icons row-chevron" aria-hidden="true">chevron_right</span>
                    </a></li>` : ''}
                </ul>
            </section>

            <!-- Server processes at a glance; ports are rarely needed and stay folded -->
            <section class="section server-details" aria-labelledby="server-details-title">
                <div class="section-head">
                    <h2 id="server-details-title">${_('dashboard.server_status')}</h2>
                    ${canServerConfig ? `<a href="/server-management?tab=overview">${_('dashboard.open_server_status')}</a>` : ''}
                </div>
                <dl class="facts">
                    <dt>${_('dashboard.signal_server')}</dt>
                    <dd><span class="status server-status-indicator is-waiting" id="hbbs-status"><span class="status-dot"></span><span class="status-text">${_('status.checking')}</span></span></dd>
                    <dt>${_('dashboard.relay_server_label')}</dt>
                    <dd><span class="status server-status-indicator is-waiting" id="hbbr-status"><span class="status-dot"></span><span class="status-text">${_('status.checking')}</span></span></dd>
                    <dt>${_('dashboard.web_console')}</dt>
                    <dd><span class="status server-status-indicator is-good"><span class="status-dot"></span><span class="status-text">${_('status.running')}</span></span></dd>
                    <dt>${_('dashboard.server_uptime')}</dt>
                    <dd id="stat-uptime">–</dd>
                </dl>
                <details class="disclosure">
                    <summary>${_('dashboard.ports_title')}</summary>
                <dl class="facts">
                    <dt>${_('dashboard.port_signal')}</dt><dd id="hbbs-port">–</dd>
                    <dt>${_('dashboard.port_nat')}</dt><dd id="nat-port">–</dd>
                    <dt>${_('dashboard.port_ws_signal')}</dt><dd id="ws-signal-port">–</dd>
                    <dt>${_('dashboard.port_api')}</dt><dd id="api-port">–</dd>
                    <dt>${_('dashboard.port_relay')}</dt><dd id="hbbr-port">–</dd>
                    <dt>${_('dashboard.port_ws_relay')}</dt><dd id="ws-relay-port">–</dd>
                    <dt>${_('dashboard.port_console')}</dt><dd id="console-port">–</dd>
                    <dt>${_('dashboard.port_client_api')}</dt><dd id="client-api-port">–</dd>
                </dl>
                </details>
            </section>
            </aside>
            </div>

            <div class="modal-overlay open dashboard-agent-activation-modal" id="dashboard-agent-activation-modal"
                 role="dialog" aria-modal="true" aria-labelledby="dashboard-agent-activation-title" hidden>
                <div class="modal dashboard-agent-activation-dialog">
                    <div class="modal-header">
                        <h2 class="modal-title" id="dashboard-agent-activation-title">${_('dashboard.activate_agent_qr')}</h2>
                        <button type="button" class="modal-close" id="dashboard-agent-activation-close"
                                aria-label="${_('actions.close')}">
                            <span class="material-icons" aria-hidden="true">close</span>
                        </button>
                    </div>
                    <div class="modal-body dashboard-agent-activation-body">
                        <p class="form-hint">${_('dashboard.activate_agent_qr_hint')}</p>
                        <div class="dashboard-agent-activation-reader" id="dashboard-agent-activation-reader">
                            <video id="dashboard-agent-activation-video" autoplay muted playsinline></video>
                        </div>
                        <input type="file" id="dashboard-agent-activation-file" accept="image/*"
                               class="dashboard-agent-activation-file" hidden>
                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary" id="dashboard-agent-activation-file-btn">${_('dashboard.activate_agent_choose_image')}</button>
                            <button type="button" class="btn btn-ghost" id="dashboard-agent-activation-stop">${_('actions.cancel')}</button>
                        </div>
                        <p class="dashboard-agent-activation-status" id="dashboard-agent-activation-status"
                           aria-live="polite"></p>
                        <div class="dashboard-agent-activation-form" id="dashboard-agent-activation-form" hidden>
                            <div class="form-group">
                                <label class="form-label" for="dashboard-agent-activation-name">${_('dashboard.activate_agent_name')}</label>
                                <input class="form-input" id="dashboard-agent-activation-name" maxlength="120">
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="dashboard-agent-activation-folder">${_('dashboard.activate_agent_folder')}</label>
                                <select class="form-select" id="dashboard-agent-activation-folder">
                                    <option value="0">${_('dashboard.activate_agent_folder_none')}</option>
                                </select>
                            </div>
                            <button type="button" class="btn btn-primary" id="dashboard-agent-activation-submit">${_('dashboard.activate_agent_submit')}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `
}) %>
