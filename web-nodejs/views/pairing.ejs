<%- include('layouts/main', {
    title: _('nav.pairing'),
    uiReworked: true,
    pageStyles: ['ui/pairing'],
    pageScripts: ['pairing'],
    currentPage: 'pairing',
    breadcrumb: [{ label: _('nav.pairing') }],
    body: `
        <div class="page pairing-page">
            <div class="page-head">
                <h1>${_('nav.pairing')}</h1>
                <p class="page-description">${_('pairing.subtitle')}</p>
            </div>

            <!-- Create a code: the form and the new code side by side, so the code
                 appears next to the button that made it (below it on narrow screens) -->
            <section class="section" aria-labelledby="pairing-create-title">
                <div class="section-head"><h2 id="pairing-create-title">${_('pairing.generate_title')}</h2></div>
                <p class="section-note">${_('pairing.generate_hint')}</p>
                <div class="cols pairing-create">
                <form class="form-column pairing-form" id="pairing-form" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="pairing-label">${_('pairing.label_field')}</label>
                        <input id="pairing-label" class="form-input is-medium" maxlength="64" autocomplete="off"
                               placeholder="${_('pairing.label_placeholder')}">
                        <p class="form-hint">${_('pairing.label_hint')}</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="pairing-host">${_('pairing.host_field')}</label>
                        <input id="pairing-host" class="form-input pairing-host-input" value="${escapeHtml(suggested_host || '')}" autocomplete="off" spellcheck="false">
                        <p class="form-hint">${_('pairing.host_hint')}</p>
                    </div>
                    <div class="form-actions">
                        <button type="submit" id="pairing-generate" class="btn btn-primary"><span class="material-icons" aria-hidden="true">add</span>${_('pairing.generate_button')}</button>
                        <span class="form-status" id="pairing-status" aria-live="polite"></span>
                    </div>
                </form>

                <!-- The new code, shown once, large enough to read out -->
                <div class="pairing-result-area" role="region" aria-labelledby="pairing-result-title">
                    <h3 id="pairing-result-title">${_('pairing.title')}</h3>
                    <p class="state" id="pairing-result-empty">${_('pairing.code_empty')}</p>
                    <div id="pairing-result" class="pairing-result" hidden>
                        <p>${_('pairing.code_hint')}</p>
                        <span class="value-field pairing-code-field">
                            <code class="pairing-code" id="pairing-code" aria-live="polite"></code>
                            <button type="button" id="pairing-copy" aria-label="${_('pairing.copy')}"><span class="material-icons" aria-hidden="true">content_copy</span><span class="btn-label">${_('actions.copy')}</span></button>
                        </span>
                        <dl class="facts pairing-meta">
                            <dt>${_('pairing.host_field')}</dt>
                            <dd class="mono" id="pairing-code-host"></dd>
                            <dt>${_('pairing.expires_in')}</dt>
                            <dd id="pairing-code-ttl"></dd>
                        </dl>
                    </div>
                </div>
                </div>
            </section>

            <section class="section" aria-labelledby="pairing-active-title">
                <div class="section-head">
                    <h2 id="pairing-active-title">${_('pairing.active_title')}</h2>
                    <button type="button" id="pairing-refresh" class="btn btn-sm"><span class="material-icons" aria-hidden="true">refresh</span>${_('actions.refresh')}</button>
                </div>
                <p class="section-note">${_('pairing.active_hint')}</p>
                <div class="table-scroll" tabindex="0" role="region" aria-labelledby="pairing-active-title">
                    <table class="data-table" id="pairing-table">
                        <thead>
                            <tr>
                                <th>${_('pairing.col_label')}</th>
                                <th>${_('tokens.status')}</th>
                                <th>${_('pairing.col_created')}</th>
                                <th>${_('pairing.col_expires')}</th>
                                <th>${_('pairing.col_created_by')}</th>
                                <th class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="pairing-tbody">
                            <tr><td colspan="6" class="state-cell">${_('pairing.loading')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    `
}) %>
