<%- include('layouts/main', {
    title: _('nav.attestation'),
    uiReworked: true,
    pageStyles: ['ui/attestation'],
    pageScripts: ['attestation'],
    currentPage: 'attestation',
    breadcrumb: [{ label: _('nav.attestation') }],
    body: `
        <div class="page page-wide att-page">
            <div class="page-head">
                <h1>${_('nav.attestation')}</h1>
                <p class="page-description">${_('attestation.page_description')}</p>
            </div>

            <section class="section" aria-labelledby="att-list-title">
                <h2 id="att-list-title" class="sr-only">${_('nav.attestation')}</h2>
                <p class="count-line" id="att-count-line" aria-live="polite" hidden></p>
                <!-- Verified, waiting and problem devices: one whole split into parts -->
                <div class="share-bar" id="att-share-bar" aria-hidden="true" hidden></div>
                <ul class="share-legend" id="att-share-legend" hidden></ul>
                <!-- Shown instead of the table while no device has reported a fingerprint -->
                <div class="att-empty" id="att-empty" hidden>
                    <p class="notice">${_('attestation.unavailable_note')}</p>
                    <p class="att-empty-how">${_('attestation.empty_how')}</p>
                </div>
                <div class="table-scroll" id="att-table-wrap">
                    <table class="data-table att-table" id="attestation-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('attestation.col_device_short')}</th>
                                <th scope="col">${_('attestation.col_fingerprint')}</th>
                                <th scope="col">${_('attestation.col_status')}</th>
                                <th scope="col">${_('attestation.col_last_check')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="attestation-body">
                            <tr><td colspan="5" class="state-cell">${_('attestation.loading')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    `
}) %>
