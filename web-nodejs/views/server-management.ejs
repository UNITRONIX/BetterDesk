<%
    var initialTab = (typeof currentTab !== 'undefined' && currentTab) ? currentTab : 'overview';
    var smTitles = {
        overview: _('nav.server_status'),
        terminal: _('server_mgmt.tab_terminal'),
        files: _('server_mgmt.tab_files'),
        services: _('server_mgmt.tab_services')
    };
    var smTitle = smTitles[initialTab] || smTitles.overview;
%><%- include('layouts/main', {
    title: smTitle,
    uiReworked: true,
    pageStyles: initialTab === 'overview' ? ['ui/chart', 'ui/server-management'] : ['ui/server-management'],
    pageScripts: initialTab === 'overview' ? ['ui-chart', 'server-management'] : ['server-management'],
    currentPage: 'server-management',
    currentTab: initialTab,
    breadcrumb: [{ label: smTitle }],
    body: `
        <div class="page ${initialTab === 'overview' ? '' : 'page-wide'} sm-page" id="server-mgmt-page" data-initial-tab="${initialTab}">
            <div class="page-head">
                <h1>${smTitle}</h1>
                <p class="page-description">${_('server_mgmt.' + initialTab + '_description')}</p>
            </div>

            ${initialTab === 'overview' ? `
            <div class="page-cols">
            <div class="page-main">
            <section class="sm-tab-panel section" id="sm-panel-overview" aria-labelledby="sm-history-title">
                <div class="section-head"><h2 id="sm-history-title">${_('server_mgmt.history')}</h2></div>
                <p class="section-note">${_('server_mgmt.history_note')}</p>
                <div id="sm-history-chart"><p class="state">${_('server_mgmt.history_waiting')}</p></div>
                <p class="sm-history-audit">${_('server_mgmt.history_restarts', { link: '<a href="/security-audit">' + _('nav.security_audit') + '</a>' })}</p>
            </section>

            <section class="section" aria-labelledby="sm-machine-title">
                <div class="section-head"><h2 id="sm-machine-title">${_('server_mgmt.machine_title')}</h2></div>
                <p class="section-note">${_('server_mgmt.machine_note')}</p>
                <p class="state" id="sm-machine-state">${_('server_mgmt.machine_loading')}</p>
                <dl class="facts" id="sm-machine" hidden>
                    <dt>${_('server_mgmt.cpu')}</dt>
                    <dd><div class="meter sm-meter" id="sm-cpu-gauge"><span class="meter-bar"><span class="meter-fill" id="sm-cpu-fill"></span></span><span class="meter-value" id="sm-cpu-value">–</span></div><span class="sm-dd-sub" id="sm-cpu-meta"></span></dd>
                    <dt>${_('server_mgmt.memory')}</dt>
                    <dd><div class="meter sm-meter" id="sm-mem-gauge"><span class="meter-bar"><span class="meter-fill" id="sm-mem-fill"></span></span><span class="meter-value" id="sm-mem-value">–</span></div><span class="sm-dd-sub" id="sm-mem-meta"></span></dd>
                    <dt>${_('server_mgmt.load')}</dt>
                    <dd><span class="num" id="sm-load">–</span><span class="sm-dd-sub" id="sm-load-meta"></span></dd>
                </dl>
                <dl class="facts sm-disks" id="sm-disks" hidden></dl>
            </section>
            </div>

            <aside class="page-side" aria-labelledby="sm-servers-title">
                <section class="section" aria-labelledby="sm-servers-title">
                    <div class="section-head"><h2 id="sm-servers-title">${_('server_mgmt.servers_title')}</h2></div>
                    <dl class="facts sm-side-facts sm-servers">
                        <dt>${_('dashboard.signal_server')}</dt>
                        <dd><span class="status" id="sm-hbbs-status">${_('status.checking')}</span><span class="sm-dd-sub" id="sm-hbbs-meaning"></span></dd>
                        <dt>${_('dashboard.relay_server_label')}</dt>
                        <dd><span class="status" id="sm-hbbr-status">${_('status.checking')}</span><span class="sm-dd-sub" id="sm-hbbr-meaning"></span></dd>
                        <dt>${_('dashboard.web_console')}</dt>
                        <dd><span class="status ok">${_('status.running')}</span></dd>
                        <dt id="sm-server-version-label" hidden>${_('server_mgmt.server_version')}</dt>
                        <dd id="sm-server-version" hidden>–</dd>
                    </dl>
                </section>

                <section class="section" aria-labelledby="sm-uptime-title">
                    <div class="section-head"><h2 id="sm-uptime-title">${_('server_mgmt.uptime')}</h2></div>
                    <dl class="facts sm-side-facts">
                        <dt id="sm-server-uptime-label" hidden>${_('server_mgmt.server_uptime')}</dt>
                        <dd id="sm-server-uptime" hidden>–</dd>
                        <dt>${_('server_mgmt.console_uptime')}</dt>
                        <dd id="sm-console-uptime">–</dd>
                        <dt>${_('server_mgmt.host_uptime')}</dt>
                        <dd><span id="sm-uptime-meta">–</span><span class="sm-dd-sub">${_('server_mgmt.host_uptime_hint')}</span></dd>
                    </dl>
                </section>

                <details class="section disclosure" id="sm-host-details">
                    <summary><h2>${_('server_mgmt.host_info')}</h2></summary>
                    <dl class="facts sm-side-facts" id="sm-host-info"></dl>
                </details>
            </aside>
            </div>
            ` : ''}

            ${initialTab === 'terminal' ? `
            <section class="sm-tab-panel section" id="sm-panel-terminal" aria-label="${_('server_mgmt.tab_terminal')}">
                <p class="sm-term-note">${_('server_mgmt.term_warning')} ${_('server_mgmt.term_keyboard')}</p>
                <div class="toolbar">
                    <button type="button" class="btn" id="sm-term-connect"><span class="material-icons" aria-hidden="true">terminal</span>${_('server_mgmt.term_connect')}</button>
                    <button type="button" class="btn" id="sm-term-disconnect" disabled>${_('server_mgmt.term_disconnect')}</button>
                    <button type="button" class="btn" id="sm-term-clear" disabled>${_('server_mgmt.term_clear')}</button>
                    <span class="sm-term-status" id="sm-term-status" role="status">${_('server_mgmt.term_disconnected')}</span>
                </div>
                <div class="terminal-box sm-terminal-host" id="sm-terminal-host" aria-label="${_('server_mgmt.tab_terminal')}"></div>
            </section>
            ` : ''}

            ${initialTab === 'files' ? `
            <div class="page-cols">
            <section class="sm-tab-panel section page-main" id="sm-panel-files" aria-label="${_('server_mgmt.tab_files')}">
                <form class="sm-files-pathbar" id="sm-files-form" role="search">
                    <label class="form-label" for="sm-files-path">${_('server_mgmt.files_path_label')}</label>
                    <div class="sm-files-pathrow">
                        <input type="text" class="form-input sm-files-path" id="sm-files-path" value="" spellcheck="false" autocomplete="off">
                        <button type="submit" class="btn" id="sm-files-go"><span class="material-icons" aria-hidden="true">folder_open</span>${_('server_mgmt.files_go')}</button>
                    </div>
                </form>
                <div class="toolbar">
                    <button type="button" class="btn" id="sm-files-up">${_('server_mgmt.files_up')}</button>
                    <button type="button" class="btn" id="sm-files-refresh"><span class="material-icons" aria-hidden="true">refresh</span>${_('actions.refresh')}</button>
                    <div class="toolbar-end">
                        <button type="button" class="btn" id="sm-files-mkdir"><span class="material-icons" aria-hidden="true">add</span>${_('server_mgmt.files_mkdir')}</button>
                    </div>
                </div>
                <p class="count-line" id="sm-files-count" aria-live="polite"></p>
                <div class="table-scroll" tabindex="0" role="region" aria-label="${_('server_mgmt.tab_files')}">
                    <table class="data-table sm-files-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('server_mgmt.files_name')}</th>
                                <th scope="col" class="num-col">${_('server_mgmt.files_size')}</th>
                                <th scope="col">${_('server_mgmt.files_mtime')}</th>
                                <th scope="col">${_('server_mgmt.files_perms')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="sm-files-body">
                            <tr><td colspan="5" class="state-cell">${_('server_mgmt.files_loading')}</td></tr>
                        </tbody>
                    </table>
                </div>

                <section class="section sm-file-editor" id="sm-file-editor" aria-labelledby="sm-file-editor-path" hidden>
                    <div class="section-head">
                        <h2 class="mono" id="sm-file-editor-path"></h2>
                    </div>
                    <p class="section-note" id="sm-file-meta"></p>
                    <label class="sr-only" for="sm-file-textarea">${_('server_mgmt.file_content')}</label>
                    <textarea class="form-input sm-file-textarea" id="sm-file-textarea" spellcheck="false"></textarea>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" id="sm-file-save">${_('server_mgmt.file_save')}</button>
                        <button type="button" class="btn" id="sm-file-close">${_('actions.close')}</button>
                        <span class="form-status" id="sm-file-status" aria-live="polite"></span>
                    </div>
                </section>
            </section>

            <aside class="page-side" aria-labelledby="sm-roots-title">
                <section class="section" aria-labelledby="sm-roots-title">
                    <div class="section-head"><h2 id="sm-roots-title">${_('server_mgmt.files_roots_title')}</h2></div>
                    <p class="section-note">${_('server_mgmt.files_roots_note')}</p>
                    <p class="state" id="sm-files-roots-state">${_('server_mgmt.files_roots_loading')}</p>
                    <ul class="list sm-roots" id="sm-files-roots" hidden></ul>
                </section>
            </aside>
            </div>
            ` : ''}

            ${initialTab === 'services' ? `
            <section class="sm-tab-panel section" id="sm-panel-services" aria-label="${_('server_mgmt.tab_services')}">
                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" class="form-input sm-services-search" id="sm-services-search"
                               aria-label="${_('server_mgmt.svc_search_label')}" placeholder="${_('server_mgmt.svc_search_label')}">
                    </div>
                    <div class="toolbar-end">
                        <button type="button" class="btn" id="sm-services-refresh"><span class="material-icons" aria-hidden="true">refresh</span>${_('actions.refresh')}</button>
                    </div>
                </div>
                <p class="count-line" id="sm-services-count" aria-live="polite"></p>
                <div class="table-scroll" tabindex="0" role="region" aria-label="${_('server_mgmt.tab_services')}">
                    <table class="data-table sm-services-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('server_mgmt.svc_name')}</th>
                                <th scope="col">${_('server_mgmt.svc_state')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="sm-services-body">
                            <tr><td colspan="3" class="state-cell">${_('server_mgmt.svc_loading')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
            ` : ''}
        </div>
    `
}) %>
