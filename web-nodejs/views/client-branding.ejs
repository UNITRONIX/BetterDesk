<%- include('layouts/main', {
    title: _('nav.client_branding'),
    uiReworked: true,
    pageStyles: ['ui/client-branding'],
    pageScripts: ['client-branding'],
    currentPage: 'client-branding',
    breadcrumb: [{ label: _('nav.client_branding') }],
    body: `
        <div class="page client-branding-page">
            <div class="page-head">
                <h1>${_('nav.client_branding')}</h1>
                <p class="page-description">${_('client_branding.page_description')}</p>
            </div>

            <div class="page-cols">
            <div class="page-main">
            <p class="state is-error" id="cb-load-error" hidden></p>

            <form id="cb-form" class="form-column client-branding-form" autocomplete="off" data-save-form>
                <section class="section" aria-labelledby="cb-contact-title">
                    <h2 id="cb-contact-title">${_('client_branding.contact_title')}</h2>
                    <p class="section-note">${_('client_branding.contact_note')}</p>
                    <div class="form-group">
                        <label class="form-label" for="cb-company">${_('client_branding.company_name')}</label>
                        <input type="text" class="form-input" id="cb-company" maxlength="256">
                        <p class="form-hint">${_('client_branding.company_hint')}</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="cb-support">${_('client_branding.support_contact')}</label>
                        <input type="text" class="form-input" id="cb-support" maxlength="256">
                        <p class="form-hint">${_('client_branding.support_hint')}</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="cb-phone">${_('client_branding.phone')}</label>
                        <input type="tel" class="form-input is-medium" id="cb-phone" maxlength="256" dir="ltr">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="cb-email">${_('client_branding.email')}</label>
                        <input type="email" class="form-input" id="cb-email" maxlength="256" dir="ltr">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="cb-website">${_('client_branding.website')}</label>
                        <input type="url" class="form-input" id="cb-website" maxlength="512" dir="ltr" placeholder="https://">
                    </div>
                </section>

                <section class="section" aria-labelledby="cb-look-title">
                    <h2 id="cb-look-title">${_('client_branding.look_title')}</h2>
                    <div class="form-group">
                        <label class="form-label" for="cb-accent">${_('client_branding.accent_color')}</label>
                        <div class="color-field">
                            <input type="color" id="cb-accent-picker" value="#4f6ef7" aria-label="${_('client_branding.accent_color')}">
                            <input type="text" class="form-input" id="cb-accent" maxlength="7" spellcheck="false" dir="ltr" aria-describedby="cb-accent-hint">
                        </div>
                        <p class="form-hint" id="cb-accent-hint">${_('client_branding.accent_hint')}</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="cb-logo-file">${_('client_branding.logo')}</label>
                        <div class="cb-logo-current">
                            <img id="cb-preview-logo" alt="${_('client_branding.logo_preview_alt')}" hidden>
                            <span class="text-muted" id="cb-preview-logo-fallback">${_('client_branding.no_logo')}</span>
                            <button type="button" id="cb-clear-logo" class="btn btn-sm" hidden>${_('client_branding.clear_logo')}</button>
                        </div>
                        <input type="file" id="cb-logo-file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp">
                        <p class="form-hint">${_('client_branding.logo_hint')}</p>
                    </div>
                    <p class="field-effect">${_('client_branding.effect')}</p>
                </section>

                <div class="save-bar">
                    <span class="save-status" data-save-status aria-live="polite"></span>
                    <span class="cb-revision" id="cb-revision"></span>
                    <button type="submit" id="cb-save" class="btn btn-primary" data-save-button>${_('client_branding.save')}</button>
                </div>
            </form>
            </div>

            <!-- Live preview built from the form values (client-branding.js renderPreview) -->
            <aside class="page-side is-sticky" aria-labelledby="cb-preview-title">
            <section class="section">
                <div class="section-head"><h2 id="cb-preview-title">${_('client_branding.preview_title')}</h2></div>
                <p class="section-note">${_('client_branding.preview_note')}</p>
                <div class="cb-preview" id="cb-preview">
                    <div class="cb-preview-head">
                        <img class="cb-pv-logo" id="cb-pv-logo" src="/img/betterdesk_icon.png" alt="" width="32" height="32">
                        <span class="cb-pv-name" id="cb-pv-name">BetterDesk</span>
                    </div>
                    <div class="cb-preview-body">
                        <p class="cb-pv-support" id="cb-pv-support" hidden></p>
                        <ul class="cb-pv-contact">
                            <li id="cb-pv-phone" dir="ltr" hidden></li>
                            <li id="cb-pv-email" dir="ltr" hidden></li>
                            <li id="cb-pv-website" dir="ltr" hidden></li>
                        </ul>
                        <span class="cb-pv-button" id="cb-pv-button">${_('client_branding.preview_button')}</span>
                    </div>
                </div>
                <p class="cb-preview-reach">${_('client_branding.hint')}</p>
            </section>
            </aside>
            </div>
        </div>
    `
}) %>
