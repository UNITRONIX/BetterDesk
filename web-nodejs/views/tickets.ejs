<%
    const ticketsCanEdit = typeof user !== 'undefined' && user && user.role !== 'viewer';
%><%- include('layouts/main', {
    title: _('nav.tickets'),
    uiReworked: true,
    pageStyles: ['ui/tickets'],
    pageScripts: ['tickets'],
    currentPage: 'tickets',
    breadcrumb: [{ label: _('nav.tickets') }],
    body: `
        <div class="page page-wide tickets-page">
            <div class="page-head">
                <h1>${_('nav.tickets')}</h1>
                <p class="page-description">${_('tickets.page_description')}</p>
                ${ticketsCanEdit ? `<div class="page-actions">
                    <button type="button" class="btn btn-primary" id="create-ticket-btn"><span class="material-icons" aria-hidden="true">add</span><span>${_('tickets.create')}</span></button>
                </div>` : ''}
            </div>

            <div class="page-cols">
            <div class="page-main">
            <section class="section" aria-label="${_('nav.tickets')}">
                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" class="form-input" id="search-input"
                            aria-label="${_('tickets.search_placeholder')}"
                            placeholder="${_('tickets.search_placeholder')}">
                    </div>
                    <div class="toolbar-filters" role="group" aria-label="${_('tickets.status')}">
                        <button type="button" class="filter-btn active" aria-pressed="true" data-status="">${_('tickets.filter_all')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="open">${_('tickets.status_open')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="in_progress">${_('tickets.status_in_progress')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="resolved">${_('tickets.status_resolved')}</button>
                        <button type="button" class="filter-btn" aria-pressed="false" data-status="closed">${_('tickets.status_closed')}</button>
                    </div>
                    <div class="toolbar-end">
                        <select class="form-select" id="priority-filter" aria-label="${_('tickets.priority')}">
                            <option value="">${_('tickets.all_priorities')}</option>
                            <option value="critical">${_('tickets.priority_critical')}</option>
                            <option value="high">${_('tickets.priority_high')}</option>
                            <option value="medium">${_('tickets.priority_medium')}</option>
                            <option value="low">${_('tickets.priority_low')}</option>
                        </select>
                    </div>
                </div>
                <p class="count-line" id="tickets-count" aria-live="polite"></p>

                <div class="table-scroll">
                    <table class="data-table tickets-table" id="tickets-table">
                        <thead>
                            <tr>
                                <th class="col-id">#</th>
                                <th>${_('tickets.ticket_title')}</th>
                                <th>${_('tickets.status')}</th>
                                <th class="col-priority">${_('tickets.priority')}</th>
                                <th class="col-category">${_('tickets.category')}</th>
                                <th class="col-assignee">${_('tickets.assigned_to')}</th>
                                <th class="col-device">${_('tickets.device')}</th>
                                <th class="col-created">${_('tickets.created_at')}</th>
                                <th class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="tickets-body">
                            <tr><td colspan="9" class="state-cell">${_('tickets.loading')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
            </div>

            <aside class="page-side" id="tickets-side" aria-label="${_('tickets.side_label')}">
                <!-- Every ticket split by status; each part filters the table -->
                <section class="section" aria-labelledby="tickets-share-title">
                    <div class="section-head"><h2 id="tickets-share-title">${_('tickets.share_title')}</h2></div>
                    <div class="share-bar" id="tickets-share-bar" aria-hidden="true" hidden></div>
                    <ul class="share-legend tickets-share-legend" id="tickets-share-legend"></ul>
                </section>

                <section class="section" id="tickets-priority-section" aria-labelledby="tickets-priority-title" hidden>
                    <div class="section-head"><h2 id="tickets-priority-title">${_('tickets.open_by_priority')}</h2></div>
                    <p class="section-note">${_('tickets.open_by_priority_note')}</p>
                    <dl class="facts tickets-priority-facts" id="tickets-open-priority"></dl>
                </section>

                <section class="section" aria-labelledby="tickets-overdue-title">
                    <div class="section-head"><h2 id="tickets-overdue-title">${_('tickets.overdue_title')}</h2></div>
                    <p class="section-note">${_('tickets.overdue_note')}</p>
                    <ul class="list tickets-overdue" id="tickets-overdue-list">
                        <li class="list-row is-empty">${_('tickets.loading')}</li>
                    </ul>
                </section>
            </aside>
            </div>
        </div>
    `
}) %>
