<%
    const can = (p) => typeof hasPermission !== 'function' || hasPermission(p);
    const roleList = ['viewer', 'operator', 'global_admin', 'server_admin', 'super_admin', 'pro'];
%><%- include('layouts/main', {
    title: _('nav.users'),
    uiReworked: true,
    pageStyles: ['ui/users'],
    pageScripts: ['users'],
    currentPage: 'users',
    breadcrumb: [{ label: _('nav.users') }],
    body: `
        <div class="page users-page">
            <div class="page-head">
                <h1>${_('nav.users')}</h1>
                ${can('user.create') ? `
                <div class="page-actions">
                    <button type="button" class="btn btn-primary" id="add-user-btn"><span class="material-icons" aria-hidden="true">add</span>${_('users.add_user')}</button>
                </div>` : ''}
                <p class="page-description">${_('users.page_description')}</p>
            </div>

            <div class="page-cols">
            <div class="page-main">
            <section class="section" aria-labelledby="users-list-title">
                <h2 id="users-list-title" class="sr-only">${_('nav.users')}</h2>
                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" class="form-input" id="users-search" autocomplete="off" spellcheck="false"
                               aria-label="${_('users.search_label')}" placeholder="${_('users.search_label')}">
                    </div>
                </div>
                <p class="count-line" id="users-count-line" aria-live="polite"></p>
                <div class="table-scroll">
                    <table class="data-table users-table" id="users-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('users.username')}</th>
                                <th scope="col">${_('users.email')}</th>
                                <th scope="col">${_('users.role')}</th>
                                <th scope="col">${_('users.column_devices')}</th>
                                <th scope="col">${_('users.column_organizations')}</th>
                                <th scope="col">${_('users.last_login')}</th>
                                <th scope="col">${_('users.created')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('users.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="users-tbody">
                            <tr><td colspan="8" class="state-cell">${_('users.loading_list')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
            </div>

            <aside class="page-side" aria-label="${_('users.side_label')}">
            <section class="section" id="user-groups" aria-labelledby="user-groups-title">
                <div class="section-head">
                    <h2 id="user-groups-title">${_('users.user_groups')}</h2>
                    ${can('user.edit') ? `<button type="button" class="btn btn-sm" id="add-user-group-btn"><span class="material-icons" aria-hidden="true">add</span>${_('users.create_user_group')}</button>` : ''}
                </div>
                <p class="section-note">${_('users.user_groups_note')}</p>
                <ul class="list user-groups-list" id="user-groups-manager-list">
                    <li class="list-row is-empty">${_('users.loading_user_groups')}</li>
                </ul>
            </section>

            <section class="section users-roles" aria-labelledby="users-roles-title">
                <div class="section-head"><h2 id="users-roles-title">${_('users.roles_title')}</h2></div>
                <dl class="users-roles-list">
                    ${roleList.map((r) => `<div><dt>${_('users.role_' + r)}</dt><dd>${_('users.role_desc_' + r)}</dd></div>`).join('')}
                </dl>
                <p class="section-note">${_('users.role_note')}${can('server.config') ? ` <a href="/permissions">${_('users.roles_change_link')}</a>` : ''}</p>
            </section>

            <details class="disclosure section users-tips">
                <summary><h2>${_('users.security_tips_title')}</h2></summary>
                <ul class="users-tips-list">
                    <li>${_('users.tip_unique_accounts')}</li>
                    <li>${_('users.tip_strong_passwords')}</li>
                    <li>${_('users.tip_least_role')}</li>
                    <li>${_('users.tip_audit_logs')}</li>
                </ul>
            </details>
            </aside>
            </div>
        </div>
    `
}) %>
