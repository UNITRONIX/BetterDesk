<%
    const canEdit = typeof hasPermission === 'function' && hasPermission('server.config');
%>
<%- include('layouts/main', {
    title: _('nav.automation'),
    uiReworked: true,
    pageStyles: ['ui/automation'],
    pageScripts: ['automation'],
    currentPage: 'automation',
    breadcrumb: [{ label: _('nav.automation') }],
    body: `
        <div class="page automation-page" data-can-edit="${canEdit}">
            <div class="page-head">
                <h1>${_('nav.automation')}</h1>
                <p class="page-description">${_('automation.page_description')}</p>
            </div>

            <div class="tabs" role="tablist" aria-label="${_('nav.automation')}">
                <button type="button" class="tab-btn active" role="tab" id="tab-btn-rules" data-tab="rules" aria-selected="true" aria-controls="tab-rules">${_('automation.rules')}</button>
                <button type="button" class="tab-btn" role="tab" id="tab-btn-alerts" data-tab="alerts" aria-selected="false" aria-controls="tab-alerts" tabindex="-1">${_('automation.alerts')}</button>
                <button type="button" class="tab-btn" role="tab" id="tab-btn-commands" data-tab="commands" aria-selected="false" aria-controls="tab-commands" tabindex="-1">${_('automation.commands')}</button>
            </div>

            <!-- Alert rules -->
            <section class="tab-panel section active" id="tab-rules" role="tabpanel" aria-labelledby="tab-btn-rules">
                <div class="section-head">
                    <p class="section-note automation-note">${_('automation.rules_note')}</p>
                    ${canEdit ? `<button type="button" class="btn btn-primary" id="create-rule-btn">${_('automation.create_rule')}</button>` : ''}
                </div>
                <p class="count-line" id="rules-count" aria-live="polite"></p>
                <div class="table-scroll">
                    <table class="data-table automation-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('automation.rule_name')}</th>
                                <th scope="col">${_('automation.condition_type')}</th>
                                <th scope="col">${_('automation.condition_value')}</th>
                                <th scope="col">${_('automation.severity')}</th>
                                <th scope="col">${_('automation.scope_device')}</th>
                                <th scope="col">${_('automation.status')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="rules-body">
                            <tr><td colspan="7" class="state-cell">${_('automation.loading_rules')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Alert history -->
            <section class="tab-panel section" id="tab-alerts" role="tabpanel" aria-labelledby="tab-btn-alerts" hidden>
                <p class="section-note automation-note">${_('automation.alerts_note')}</p>
                <div class="toolbar">
                    <div class="toolbar-filters" id="alert-severity-filter" role="group" aria-label="${_('automation.severity')}">
                        <button type="button" class="filter-btn active" data-severity="" aria-pressed="true">${_('common.all')}</button>
                        <button type="button" class="filter-btn" data-severity="info" aria-pressed="false">${_('automation.severity_info')}</button>
                        <button type="button" class="filter-btn" data-severity="warning" aria-pressed="false">${_('automation.severity_warning')}</button>
                        <button type="button" class="filter-btn" data-severity="critical" aria-pressed="false">${_('automation.severity_critical')}</button>
                    </div>
                </div>
                <p class="count-line" id="alerts-count" aria-live="polite"></p>
                <div class="table-scroll">
                    <table class="data-table automation-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('automation.triggered_at')}</th>
                                <th scope="col">${_('automation.rule_name')}</th>
                                <th scope="col">${_('automation.device')}</th>
                                <th scope="col">${_('automation.details')}</th>
                                <th scope="col">${_('automation.severity')}</th>
                                <th scope="col">${_('automation.status')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="alerts-body">
                            <tr><td colspan="7" class="state-cell">${_('automation.loading_alerts')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Remote commands -->
            <section class="tab-panel section" id="tab-commands" role="tabpanel" aria-labelledby="tab-btn-commands" hidden>
                <div class="section-head">
                    <p class="section-note automation-note">${_('automation.commands_note')}</p>
                    ${canEdit ? `<button type="button" class="btn btn-primary" id="send-command-btn">${_('automation.send_command')}</button>` : ''}
                </div>
                <p class="count-line" id="commands-count" aria-live="polite"></p>
                <div class="table-scroll">
                    <table class="data-table automation-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('automation.sent_at')}</th>
                                <th scope="col">${_('automation.device')}</th>
                                <th scope="col">${_('automation.command_type')}</th>
                                <th scope="col">${_('automation.command_payload')}</th>
                                <th scope="col">${_('automation.command_status')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="commands-body">
                            <tr><td colspan="6" class="state-cell">${_('automation.loading_commands')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    `
}) %>
