<%- include('layouts/main', {
    title: _('nav.permissions'),
    uiReworked: true,
    pageStyles: ['ui/permissions'],
    pageScripts: ['permissions'],
    currentPage: 'permissions',
    breadcrumb: [{ label: _('nav.permissions') }],
    body: `
        <div class="page page-wide permissions-page">
            <div class="page-head">
                <h1>${_('nav.permissions')}</h1>
                <p class="page-description">${_('permissions.page_description')}</p>
            </div>

            <div class="page-cols">
            <div class="page-main">
            <p class="state" id="permissions-loading">${_('permissions.loading')}</p>
            <p class="state is-error" id="permissions-error" hidden>
                <span>${_('permissions.load_failed')}</span>
                <button type="button" class="btn btn-sm" id="permissions-retry">${_('actions.retry')}</button>
            </p>
            <p class="state" id="permissions-empty" hidden>${_('permissions.empty_desc')}</p>
            <p class="notice" id="permissions-locked" hidden>${_('permissions.locked_desc')}</p>

            <!-- Permission groups, rendered by permissions.js -->
            <div class="permissions-matrix" id="permissions-matrix" hidden></div>
            </div>

            <!-- The role being edited stays in view while scrolling through its permissions -->
            <aside class="page-side is-sticky" aria-labelledby="perm-role-title">
            <section class="section" aria-labelledby="perm-role-title">
                <h2 id="perm-role-title" class="sr-only">${_('permissions.select_role')}</h2>
                <div class="form-group perm-role-field">
                    <label class="form-label" for="role-select">${_('permissions.select_role')}</label>
                    <select id="role-select" class="form-select" aria-describedby="role-info-banner">
                        <option value="" disabled selected>${_('permissions.select_role_placeholder')}</option>
                    </select>
                </div>
                <div class="role-info" id="role-info-banner" aria-live="polite" hidden>
                    <p class="role-info-desc" id="role-info-name"></p>
                    <p class="count-line" id="role-info-level"><span id="role-perm-count" hidden>0</span><span id="role-override-count" hidden>0</span></p>
                </div>
            </section>

            <section class="danger-zone" id="permissions-danger" aria-labelledby="perm-danger-title" hidden>
                <h2 id="perm-danger-title">${_('permissions.danger_title')}</h2>
                <ul class="list">
                    <li class="list-row">
                        <span class="row-main">
                            <span class="row-title">${_('permissions.reset_overrides')}</span>
                            <span class="row-sub" id="reset-overrides-desc">${_('permissions.reset_overrides_desc')}</span>
                        </span>
                        <span class="row-end"><button type="button" class="btn btn-danger-quiet" id="btn-reset-overrides" aria-describedby="reset-overrides-desc" disabled>${_('permissions.reset_overrides_button')}</button></span>
                    </li>
                </ul>
            </section>
            </aside>
            </div>
        </div>
    `
}) %>
