<%
    const fleetTabs = ['resources', 'tasks', 'builder', 'compliance'];
    const tab = fleetTabs.includes(activeTab) ? activeTab : 'resources';
    const tabLabels = {
        resources: _('fleet.tab_resources'),
        tasks: _('fleet.tab_tasks'),
        builder: _('fleet.tab_builder'),
        compliance: _('fleet.tab_compliance')
    };
    const paletteGroups = [
        ['trigger', _('fleet.node_triggers'), [['trigger_manual', 'fleet.node_manual'], ['trigger_schedule', 'fleet.node_schedule'], ['trigger_event', 'fleet.node_event']]],
        ['condition', _('fleet.node_conditions'), [['cond_os', 'fleet.node_os_check'], ['cond_threshold', 'fleet.node_threshold'], ['cond_time_window', 'fleet.node_time_window']]],
        ['action', _('fleet.node_actions'), [['action_script', 'fleet.node_run_script'], ['action_install', 'fleet.node_install'], ['action_restart', 'fleet.node_restart'], ['action_file_deploy', 'fleet.node_file_deploy'], ['action_message', 'fleet.node_send_message']]],
        ['result', _('fleet.node_results'), [['result_log', 'fleet.node_log_output'], ['result_alert', 'fleet.node_send_alert'], ['result_chain', 'fleet.node_chain']]],
        ['transform', _('fleet.node_transforms'), [['transform_parse', 'fleet.node_parse_json'], ['transform_filter', 'fleet.node_filter'], ['transform_delay', 'fleet.node_delay']]]
    ];
%>
<%- include('layouts/main', {
    title: _('nav.fleet'),
    uiReworked: true,
    pageStyles: ['ui/fleet'],
    pageScripts: pageScripts,
    currentPage: currentPage,
    breadcrumb: [{ label: _('nav.fleet') }],
    body: `
<div class="page page-wide fleet-page">
    <div class="page-head">
        <h1>${_('nav.fleet')}</h1>
        <p class="page-description">${_('fleet.page_description')}</p>
    </div>

    <div class="fleet-body">
    <div class="tabs" role="tablist" aria-label="${_('nav.fleet')}">
        ${fleetTabs.map(id => `<button type="button" class="tab fleet-tab ${tab === id ? 'active' : ''}" role="tab" id="tab-${id}" aria-controls="panel-${id}" aria-selected="${tab === id}" tabindex="${tab === id ? '0' : '-1'}" data-tab="${id}" data-bd-call="Fleet.switchTab" data-bd-args='["${id}"]'>${tabLabels[id]}</button>`).join('')}
    </div>

    <!-- Resources: printers, drives and network settings pushed to an organization -->
    <section class="fleet-panel section" id="panel-resources" role="tabpanel" aria-labelledby="tab-resources" ${tab === 'resources' ? '' : 'hidden'}>
        <p class="section-note fleet-note">${_('fleet.resources_note')}</p>
        <div class="toolbar">
            <label class="fleet-filter">
                <span class="fleet-filter-label">${_('fleet.scope_org')}</span>
                <select id="res-org-select" class="form-select" data-bd-call="Fleet.onResOrgChange" data-bd-on="change">
                    <option value="">${_('fleet.select_org_placeholder')}</option>
                </select>
            </label>
            <label class="fleet-filter">
                <span class="fleet-filter-label">${_('fleet.col_type')}</span>
                <select id="res-type-filter" class="form-select" data-bd-call="Fleet.loadResources" data-bd-on="change">
                    <option value="">${_('fleet.all_types')}</option>
                    <option value="printer">${_('fleet.type_printer')}</option>
                    <option value="network_drive">${_('fleet.type_network_drive')}</option>
                    <option value="dns">${_('fleet.type_dns')}</option>
                    <option value="vpn">${_('fleet.type_vpn')}</option>
                    <option value="proxy">${_('fleet.type_proxy')}</option>
                </select>
            </label>
            <div class="toolbar-end">
                <button type="button" class="btn btn-primary" id="res-add-btn" data-bd-call="Fleet.showResourceModal"><span class="material-icons" aria-hidden="true">add</span>${_('fleet.add_resource')}</button>
            </div>
        </div>
        <p class="count-line" id="res-count" aria-live="polite"></p>
        <div class="table-scroll">
            <table class="data-table fleet-table">
                <thead>
                    <tr>
                        <th scope="col">${_('fleet.col_name')}</th>
                        <th scope="col">${_('fleet.col_type')}</th>
                        <th scope="col">${_('fleet.address')}</th>
                        <th scope="col">${_('fleet.col_scope')}</th>
                        <th scope="col">${_('fleet.col_status')}</th>
                        <th scope="col" class="actions"><span class="sr-only">${_('fleet.col_actions')}</span></th>
                    </tr>
                </thead>
                <tbody id="res-tbody"><tr><td colspan="6" class="state-cell">${_('fleet.loading_resources')}</td></tr></tbody>
            </table>
        </div>
    </section>

    <!-- Tasks: one job on many devices, now or on a schedule -->
    <section class="fleet-panel section" id="panel-tasks" role="tabpanel" aria-labelledby="tab-tasks" ${tab === 'tasks' ? '' : 'hidden'}>
        <p class="section-note fleet-note">${_('fleet.tasks_note')}</p>
        <div class="toolbar">
            <div class="toolbar-search search-wrapper">
                <span class="material-icons" aria-hidden="true">search</span>
                <input type="search" class="form-input" id="task-search" aria-label="${_('fleet.search_tasks')}" placeholder="${_('fleet.search_tasks')}">
            </div>
            <label class="fleet-filter">
                <span class="fleet-filter-label">${_('fleet.col_status')}</span>
                <select id="task-status-filter" class="form-select" data-bd-call="Fleet.loadTasks" data-bd-on="change">
                    <option value="">${_('fleet.all_statuses')}</option>
                    <option value="pending">${_('fleet.status_pending')}</option>
                    <option value="running">${_('fleet.status_running')}</option>
                    <option value="success">${_('fleet.status_success')}</option>
                    <option value="failed">${_('fleet.status_failed')}</option>
                </select>
            </label>
            <div class="toolbar-end">
                <button type="button" class="btn btn-primary" data-bd-call="Fleet.showTaskModal"><span class="material-icons" aria-hidden="true">add</span>${_('fleet.create_task')}</button>
            </div>
        </div>
        <p class="count-line" id="task-count" aria-live="polite"></p>
        <div class="table-scroll">
            <table class="data-table fleet-table">
                <thead>
                    <tr>
                        <th scope="col">${_('fleet.col_task_name')}</th>
                        <th scope="col">${_('fleet.col_task_type')}</th>
                        <th scope="col">${_('fleet.target_devices')}</th>
                        <th scope="col">${_('fleet.col_schedule')}</th>
                        <th scope="col">${_('fleet.col_status')}</th>
                        <th scope="col">${_('fleet.col_last_run')}</th>
                        <th scope="col" class="actions"><span class="sr-only">${_('fleet.col_actions')}</span></th>
                    </tr>
                </thead>
                <tbody id="task-tbody"><tr><td colspan="7" class="state-cell">${_('fleet.loading_tasks')}</td></tr></tbody>
            </table>
        </div>

        <!-- Output of one task -->
        <section class="section fleet-output" id="task-output-panel" aria-labelledby="task-output-title" hidden>
            <div class="section-head">
                <h2 id="task-output-title">${_('fleet.task_output')}</h2>
                <button type="button" class="btn btn-sm" data-bd-call="Fleet.closeOutput">${_('fleet.close')}</button>
            </div>
            <pre class="code-block" id="task-output-pre"></pre>
        </section>
    </section>

    <!-- Workflows: the visual builder -->
    <section class="fleet-panel section" id="panel-builder" role="tabpanel" aria-labelledby="tab-builder" ${tab === 'builder' ? '' : 'hidden'}>
        <p class="section-note fleet-note">${_('fleet.builder_note')}</p>
        <div class="toolbar">
            <label class="fleet-filter">
                <span class="fleet-filter-label">${_('fleet.workflow_label')}</span>
                <select id="workflow-select" class="form-select" data-bd-call="Fleet.loadWorkflow" data-bd-on="change">
                    <option value="">${_('fleet.select_workflow')}</option>
                </select>
            </label>
            <button type="button" class="btn" data-bd-call="Fleet.newWorkflow"><span class="material-icons" aria-hidden="true">add</span>${_('fleet.new_workflow')}</button>
            <div class="toolbar-end">
                <button type="button" class="btn" data-bd-call="Fleet.exportWorkflow"><span class="material-icons" aria-hidden="true">download</span>${_('fleet.export')}</button>
                <button type="button" class="btn" data-bd-call="Fleet.executeWorkflow" data-bd-args='[true]'><span class="material-icons" aria-hidden="true">play_arrow</span>${_('fleet.dry_run')}</button>
                <button type="button" class="btn" data-bd-call="Fleet.executeWorkflow" data-bd-args='[false]'><span class="material-icons" aria-hidden="true">play_arrow</span>${_('fleet.execute')}</button>
                <button type="button" class="btn btn-primary" data-bd-call="Fleet.saveWorkflow">${_('fleet.save')}</button>
            </div>
        </div>
        <p class="form-status" id="workflow-status" aria-live="polite"></p>

        <div class="builder-layout">
            <nav class="builder-palette" aria-label="${_('fleet.palette_label')}">
                <p class="builder-palette-hint">${_('fleet.palette_hint')}</p>
                ${paletteGroups.map(([cat, heading, nodes]) => `
                <div class="palette-section" data-category="${cat}">
                    <h3><span class="node-dot ${cat}" aria-hidden="true"></span>${heading}</h3>
                    ${nodes.map(([type, key]) => `<button type="button" class="palette-node" draggable="true" data-type="${type}" data-bd-call="FleetBuilder.addFromPalette" data-bd-args='["${type}"]'>${_(key)}</button>`).join('')}
                </div>`).join('')}
            </nav>

            <div class="builder-canvas-wrap">
                <svg id="builder-canvas" class="builder-canvas" role="img" aria-label="${_('fleet.canvas_label')}"></svg>
                <div class="builder-zoom" role="group" aria-label="${_('fleet.zoom_label')}">
                    <button type="button" class="btn btn-sm" data-bd-call="FleetBuilder.zoomOut">${_('fleet.zoom_out')}</button>
                    <span id="builder-zoom-level" class="builder-zoom-level">100%</span>
                    <button type="button" class="btn btn-sm" data-bd-call="FleetBuilder.zoomIn">${_('fleet.zoom_in')}</button>
                    <button type="button" class="btn btn-sm" data-bd-call="FleetBuilder.zoomReset">${_('fleet.zoom_reset')}</button>
                </div>
            </div>

            <aside class="builder-properties" id="builder-props" aria-labelledby="props-title" style="display:none;">
                <div class="props-header">
                    <h3 id="props-title">${_('fleet.node_properties')}</h3>
                    <button type="button" class="modal-close" data-bd-call="FleetBuilder.closeProps" aria-label="${_('fleet.close')}"><span class="material-icons" aria-hidden="true">close</span></button>
                </div>
                <div id="props-body"></div>
            </aside>
        </div>
    </section>

    <!-- Compliance: how well each device meets the software rules -->
    <section class="fleet-panel section" id="panel-compliance" role="tabpanel" aria-labelledby="tab-compliance" ${tab === 'compliance' ? '' : 'hidden'}>
        <p class="section-note fleet-note">${_('fleet.compliance_note')}</p>
        <div class="toolbar">
            <label class="fleet-filter">
                <span class="fleet-filter-label">${_('fleet.scope_org')}</span>
                <select id="comp-org-select" class="form-select" data-bd-call="Fleet.loadCompliance" data-bd-on="change">
                    <option value="">${_('fleet.all_organizations')}</option>
                </select>
            </label>
            <div class="toolbar-end">
                <span class="form-status" id="comp-scan-status" aria-live="polite"></span>
                <button type="button" class="btn btn-primary" id="comp-scan-all" data-bd-call="Fleet.scanAll">${_('fleet.scan_all')}</button>
            </div>
        </div>
        <p class="count-line" id="compliance-stats" aria-live="polite"></p>
        <div class="table-scroll">
            <table class="data-table fleet-table">
                <thead>
                    <tr>
                        <th scope="col">${_('fleet.col_device')}</th>
                        <th scope="col">${_('fleet.col_os')}</th>
                        <th scope="col">${_('fleet.col_score')}</th>
                        <th scope="col">${_('fleet.col_issues')}</th>
                        <th scope="col">${_('fleet.col_last_scan')}</th>
                        <th scope="col" class="actions"><span class="sr-only">${_('fleet.col_actions')}</span></th>
                    </tr>
                </thead>
                <tbody id="comp-tbody"><tr><td colspan="6" class="state-cell">${_('fleet.loading_compliance')}</td></tr></tbody>
            </table>
        </div>
    </section>
    </div>
</div>
`
}) %>
