<%
    const can = (perm) => typeof hasPermission === 'function' && hasPermission(perm);
    const canEdit = can('org.edit');
    const canUsers = can('org.manage_users');
    const canDevices = can('org.manage_devices');
    // /policies/<id> is open to the administrator roles (requireAdmin in routes/policies.routes.js)
    const role = typeof user !== 'undefined' && user ? user.role : '';
    const canPolicies = ['super_admin', 'admin', 'global_admin', 'server_admin'].includes(role);
    const safeOrgId = encodeURIComponent(orgId);
%>
<%- include('layouts/main', {
    title: _('organizations.detail'),
    uiReworked: true,
    pageStyles: ['ui/organizations'],
    pageScripts: ['organizationDetail'],
    currentPage: 'organizations',
    breadcrumb: [
        { label: _('nav.organizations'), href: '/organizations' },
        { label: _('organizations.detail') }
    ],
    body: `
        <div class="page org-detail-page" data-org-id="${escapeHtml(orgId)}" data-can-edit="${canEdit}" data-can-users="${canUsers}" data-can-devices="${canDevices}">
            <div class="page-head" id="org-detail-header">
                <h1 id="org-detail-name">${_('organizations.detail')}</h1>
                <div class="page-actions">
                    <button type="button" class="btn" id="org-edit-btn"${canEdit ? '' : ' hidden'}><span class="material-icons" aria-hidden="true">edit</span>${_('common.edit')}</button>
                </div>
                <p class="page-description">${_('organizations.detail_description')}</p>
            </div>

            <p class="state is-error" id="org-load-error" hidden>
                <span>${_('organizations.org_load_failed')}</span>
                <button type="button" class="btn btn-sm" id="org-load-retry">${_('actions.retry')}</button>
            </p>

            <div class="page-cols org-detail-body">
            <div class="page-main">
                <div class="tabs" role="tablist" aria-label="${_('organizations.detail')}">
                    <button type="button" class="tab org-tab active" role="tab" id="org-tab-users" data-tab="users" aria-selected="true" aria-controls="tab-users">${_('organizations.users')}</button>
                    <button type="button" class="tab org-tab" role="tab" id="org-tab-devices" data-tab="devices" aria-selected="false" aria-controls="tab-devices" tabindex="-1">${_('organizations.devices')}</button>
                    <button type="button" class="tab org-tab" role="tab" id="org-tab-address-book" data-tab="address-book" aria-selected="false" aria-controls="tab-address-book" tabindex="-1">${_('organizations.address_book')}</button>
                    <button type="button" class="tab org-tab" role="tab" id="org-tab-settings" data-tab="settings" aria-selected="false" aria-controls="tab-settings" tabindex="-1">${_('organizations.settings')}</button>
                </div>

                <!-- Users and invitations -->
                <div class="tab-panel org-tab-content" id="tab-users" role="tabpanel" aria-labelledby="org-tab-users">
                    <section class="section" aria-labelledby="org-tab-users">
                        <div class="section-head">
                            <p class="count-line" id="users-count-line" aria-live="polite"><span id="users-count" hidden>0</span></p>
                            <button type="button" class="btn btn-primary" id="add-user-btn"${canUsers ? '' : ' hidden'}><span class="material-icons" aria-hidden="true">add</span>${_('organizations.add_user')}</button>
                        </div>
                        <div id="users-table"><p class="state">${_('common.loading')}</p></div>
                    </section>

                    <section class="section" id="tab-invitations" aria-labelledby="org-invitations-title">
                        <div class="section-head">
                            <h2 id="org-invitations-title">${_('organizations.invitations')}</h2>
                            <button type="button" class="btn" id="create-invite-btn"${canUsers ? '' : ' hidden'}><span class="material-icons" aria-hidden="true">add</span>${_('organizations.create_invitation')}</button>
                        </div>
                        <span id="invitations-count" hidden>0</span>
                        <div id="invitations-table"><p class="state">${_('common.loading')}</p></div>
                    </section>
                </div>

                <!-- Devices and device groups -->
                <div class="tab-panel org-tab-content" id="tab-devices" role="tabpanel" aria-labelledby="org-tab-devices" hidden>
                    <section class="section" aria-labelledby="org-tab-devices">
                        <div class="section-head">
                            <p class="count-line" id="devices-count-line" aria-live="polite"><span id="devices-count" hidden>0</span></p>
                            <button type="button" class="btn btn-primary" id="assign-device-btn"${canDevices ? '' : ' hidden'}><span class="material-icons" aria-hidden="true">add</span>${_('organizations.assign_device')}</button>
                        </div>
                        <div id="devices-table"><p class="state">${_('common.loading')}</p></div>
                    </section>

                    <section class="section" id="tab-device-groups" aria-labelledby="org-groups-title">
                        <div class="section-head">
                            <h2 id="org-groups-title">${_('organizations.device_groups_tab')}</h2>
                            <a href="/devices" class="btn btn-link" id="org-open-devices-groups-btn">${_('organizations.manage_in_devices')}</a>
                        </div>
                        <p class="section-note">${_('organizations.device_groups_intro')}</p>
                        <div id="device-groups-container"><p class="state">${_('common.loading')}</p></div>
                    </section>
                </div>

                <!-- Shared address book -->
                <div class="tab-panel org-tab-content" id="tab-address-book" role="tabpanel" aria-labelledby="org-tab-address-book" hidden>
                    <form class="section" id="org-address-book-form" data-save-form novalidate>
                        <div id="address-book-container"><p class="state">${_('common.loading')}</p></div>
                        <div class="save-bar"${canEdit ? '' : ' hidden'}>
                            <span class="save-status" data-save-status aria-live="polite"></span>
                            <button type="submit" class="btn btn-primary" id="save-address-book-btn" data-save-button>${_('organizations.address_book_save')}</button>
                        </div>
                    </form>
                </div>

                <!-- Details, stored settings, delete -->
                <div class="tab-panel org-tab-content" id="tab-settings" role="tabpanel" aria-labelledby="org-tab-settings" hidden>
                    <form class="form-column" id="org-settings-form" data-save-form novalidate>
                        <section class="section" aria-labelledby="org-conn-title">
                            <h2 id="org-conn-title">${_('organizations.session_settings')}</h2>
                            <p class="section-note">${_('organizations.session_settings_note')} <a href="${canPolicies ? `/policies/${safeOrgId}` : '/policies'}">${_('organizations.policies_link')}</a></p>
                            <div id="settings-container">
                                <div class="form-group">
                                    <label class="form-label" for="setting-connection-policy">${_('organizations.connection_policy')}</label>
                                    <select id="setting-connection-policy" class="form-select is-medium">
                                        <option value="unattended">${_('organizations.policy_unattended')}</option>
                                        <option value="attended">${_('organizations.policy_attended')}</option>
                                        <option value="ask_always">${_('organizations.policy_ask')}</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="check-field"><input type="checkbox" id="setting-allow-file-transfer"><span class="check-label">${_('organizations.allow_file_transfer')}</span></label>
                                    <label class="check-field"><input type="checkbox" id="setting-allow-clipboard"><span class="check-label">${_('organizations.allow_clipboard')}</span></label>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="setting-max-session">${_('organizations.max_session_duration')}</label>
                                    <input type="number" id="setting-max-session" class="form-input is-short" value="120" min="0">
                                </div>
                            </div>
                        </section>
                        <div class="save-bar"${canEdit ? '' : ' hidden'}>
                            <span class="save-status" data-save-status aria-live="polite"></span>
                            <button type="submit" class="btn btn-primary" id="save-settings-btn" data-save-button>${_('organizations.save')}</button>
                        </div>
                    </form>

                    <details class="disclosure section" id="org-raw-settings">
                        <summary><h2>${_('organizations.raw_settings')}</h2></summary>
                        <p class="section-note">${_('organizations.raw_settings_note')}</p>
                        <div id="settings-raw"></div>
                    </details>

                    ${can('org.delete') ? `<section class="danger-zone" aria-labelledby="org-danger-title">
                        <h2 id="org-danger-title">${_('common.delete')}</h2>
                        <ul class="list">
                            <li class="list-row">
                                <span class="row-main">
                                    <span class="row-title">${_('organizations.delete_org')}</span>
                                    <span class="row-sub">${_('organizations.delete_org_desc')}</span>
                                </span>
                                <span class="row-end"><button type="button" class="btn btn-danger-quiet" id="org-delete-btn">${_('organizations.delete_org_button')}</button></span>
                            </li>
                        </ul>
                    </section>` : ''}
                </div>
            </div>

            <aside class="page-side" aria-labelledby="org-details-title">
                <section class="section" aria-labelledby="org-details-title">
                    <h2 id="org-details-title">${_('organizations.details_title')}</h2>
                    <p class="org-side-counts" id="org-side-counts" aria-live="polite">${_('common.loading')}</p>
                    <dl class="facts" id="org-details-facts">
                        <dt>${_('organizations.slug')}</dt><dd id="org-detail-slug">—</dd>
                        <dt>${_('organizations.created')}</dt><dd id="org-detail-created">—</dd>
                        <dt>${_('organizations.logo_url')}</dt><dd id="org-detail-logo">—</dd>
                        <dt>${_('organizations.org_id')}</dt><dd><span class="value-field"><code id="org-detail-id">${escapeHtml(orgId)}</code><button type="button" data-copy-target="org-detail-id">${_('actions.copy')}</button></span></dd>
                    </dl>
                </section>

                <section class="section" aria-labelledby="org-related-title" id="org-related"${canPolicies ? '' : ' hidden'}>
                    <h2 id="org-related-title">${_('organizations.related_title')}</h2>
                    <ul class="list" id="org-related-list">
                        ${canPolicies ? `<li><a class="list-row" href="/policies/${safeOrgId}">
                            <span class="row-main"><span class="row-title">${_('nav.policies')}</span><span class="row-sub">${_('organizations.related_policies_sub')}</span></span>
                            <span class="material-icons row-chevron" aria-hidden="true">chevron_right</span></a></li>` : ''}
                    </ul>
                </section>
            </aside>
            </div>
        </div>
    `
}) %>
