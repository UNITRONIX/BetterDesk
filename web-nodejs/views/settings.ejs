<%
    // Each settings tab is its own sub-page (?tab=), listed in the sidebar.
    // All tabs the user may see are rendered so the settings search can find
    // a field on another tab; only the requested one is shown.
    const tab = typeof currentTab !== 'undefined' && currentTab ? currentTab : 'general';
    const canAudit = typeof hasPermission === 'function' && hasPermission('audit.view');
    const adminTabs = ['backup', 'updates', 'email', 'time', 'advanced'];
    const tabTitles = {
        general: _('settings.tab_general'),
        branding: _('settings.tab_branding'),
        auth: _('settings.tab_auth'),
        backup: _('settings.tab_backup'),
        updates: _('updates.tab_title'),
        email: _('settings.tab_email'),
        time: _('settings.tab_time'),
        advanced: _('settings.tab_advanced')
    };
    const tabDescs = {
        general: canServerConfig ? _('settings.page.general_desc') : _('settings.page.general_desc_viewer'),
        branding: _('settings.page.branding_desc'),
        auth: canServerConfig ? _('settings.page.auth_desc') : _('settings.page.auth_desc_viewer'),
        backup: _('settings.page.backup_desc'),
        updates: _('settings.page.updates_desc'),
        email: _('settings.page.email_desc'),
        time: _('settings.page.time_desc'),
        advanced: _('settings.page.advanced_desc')
    };
    const allowed = (name) => canServerConfig || !adminTabs.includes(name);
    const shown = (name) => (name === tab ? '' : 'hidden');
    const panelAttrs = (name) => `id="tab-${name}" data-tab="${name}" data-tab-title="${tabTitles[name]}" ${shown(name)}`;
    const saveBar = (label, extra = '', id = '') => `
                <div class="save-bar">
                    <span class="save-status" data-save-status aria-live="polite"></span>
                    ${extra}
                    <button type="submit" class="btn btn-primary" data-save-button${id ? ` id="${id}"` : ''}>${label}</button>
                </div>`;
    const userName = (typeof user !== 'undefined' && user && user.username) ? user.username : '';

    // Appearance helpers: background type radios, colour fields, image uploads
    const bgTypeLabels = {
        none: _('branding.bg_type_none'),
        inherit: _('branding.login_bg_inherit'),
        color: _('branding.bg_type_color'),
        gradient: _('branding.bg_type_gradient'),
        image: _('branding.bg_type_image')
    };
    const bgTypeRadios = (name, types) => `
                <fieldset class="form-group">
                    <legend class="form-label">${_('settings.appearance.background_type')}</legend>
                    <div class="settings-radio-row">
                        ${types.map((t) => `<label class="checkbox-row"><input type="radio" name="${name}" value="${t}"> ${bgTypeLabels[t]}</label>`).join('')}
                    </div>
                </fieldset>`;
    const colorInput = (textId, pickerId, value, label, hint = '', maxlength = 32) => `
                <div class="form-group">
                    <label class="form-label" for="${textId}">${label}</label>
                    <div class="color-field">
                        <input type="color" id="${pickerId}" value="${value}" aria-label="${label}">
                        <input type="text" class="form-input" id="${textId}" placeholder="${value}" maxlength="${maxlength}" spellcheck="false">
                    </div>
                    ${hint ? `<p class="form-hint">${hint}</p>` : ''}
                </div>`;
    const uploadField = (fileId, targetId, statusId, label, nameId = '') => `
                <div class="form-group">
                    <label class="form-label" for="${fileId}">${label}</label>
                    <input type="file" id="${fileId}" data-target="${targetId}" accept="image/png,image/jpeg,image/webp,image/gif" class="branding-bg-file" data-save-ignore>
                    <p class="form-hint">${_('branding.bg_image_hint')}</p>
                    ${nameId ? `<p class="form-hint" id="${nameId}"></p>` : ''}
                    <div class="branding-upload-status" id="${statusId}" hidden>
                        <p class="form-status branding-upload-message" aria-live="polite"></p>
                        <div class="meter"><span class="meter-bar"><span class="meter-fill branding-upload-progress-fill"></span></span></div>
                    </div>
                    <p class="field-effect">${_('settings.appearance.bg_upload_effect')}</p>
                </div>`;
%>
<%- include('layouts/main', {
    title: tabTitles[tab] + ' - ' + _('nav.settings'),
    uiReworked: true,
    pageStyles: ['ui/settings'],
    pageScripts: ['settings'],
    currentPage: 'settings',
    currentTab: tab,
    breadcrumb: [{ label: _('nav.settings'), href: '/settings' }, { label: tabTitles[tab] }],
    body: `
<div class="page settings-page" data-current-tab="${tab}" data-can-server-config="${canServerConfig ? '1' : '0'}">
    <div class="page-head">
        <h1>${tabTitles[tab]}</h1>
        <div class="page-actions settings-search" role="search">
            <div class="search-wrapper">
                <span class="material-icons" aria-hidden="true">search</span>
                <input type="search" id="settings-search-input" class="form-input" autocomplete="off"
                       aria-label="${_('settings.page.search_label')}"
                       aria-controls="settings-search-status"
                       placeholder="${_('settings.ui.search_placeholder')}">
            </div>
        </div>
        <p class="page-description">${tabDescs[tab]}</p>
    </div>

    <div id="settings-search-status" class="settings-search-results" aria-live="polite" hidden>
        <p class="count-line" id="settings-search-count"></p>
        <ul class="list" id="settings-search-results"></ul>
    </div>

    ${!allowed(tab) ? `<p class="state">${_('settings.page.admin_only')}</p>` : ''}

    <!-- ===================== General ===================== -->
    <div class="settings-tab-content" ${panelAttrs('general')}>
        ${canServerConfig ? `
        <nav aria-label="${_('settings.page.on_this_page')}">
            <ul class="toc">
                <li><a href="#public-endpoints">${_('settings.public_endpoints_title')}</a></li>
                <li><a href="#connection-mode-section">${_('settings.connection_mode_title')}</a></li>
                <li><a href="#device-scope-settings-panel">${_('settings.device_scope_title')}</a></li>
                <li><a href="#availability-history-settings-panel">${_('settings.availability_history_title')}</a></li>
                <li><a href="#mesh-settings-panel">${_('mesh.settings_title')}</a></li>
                <li><a href="#server-info">${_('settings.server_info')}</a></li>
            </ul>
        </nav>

        <section class="section" id="public-endpoints" aria-labelledby="public-endpoints-title">
            <h2 id="public-endpoints-title">${_('settings.public_endpoints_title')}</h2>
            <p class="section-note">${_('settings.public_endpoints_desc')}</p>
            <form class="form-column" id="public-endpoints-form" data-save-form novalidate>
                <div class="form-group">
                    <label class="form-label" for="public-server-id">${_('settings.public_endpoints_server_id')}</label>
                    <input type="text" id="public-server-id" class="form-input mono-input" autocomplete="off" spellcheck="false"
                           placeholder="${_('settings.public_endpoints_server_id_placeholder')}">
                    <p class="form-hint">${_('settings.general.endpoint_id_hint')}</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="public-relay-server">${_('settings.public_endpoints_relay')}</label>
                    <input type="text" id="public-relay-server" class="form-input mono-input" autocomplete="off" spellcheck="false"
                           placeholder="${_('settings.public_endpoints_relay_placeholder')}">
                    <p class="form-hint">${_('settings.general.endpoint_relay_hint')}</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="public-api-url">${_('settings.public_endpoints_api_url')}</label>
                    <input type="text" id="public-api-url" class="form-input mono-input" autocomplete="off" spellcheck="false"
                           placeholder="${_('settings.public_endpoints_api_url_placeholder')}">
                    <p class="form-hint">${_('settings.public_endpoints_api_url_hint')}</p>
                </div>
                <p class="form-hint">${_('settings.public_endpoints_hint')}</p>
                <p class="field-effect">${_('settings.general.endpoints_effect')}</p>
                ${saveBar(_('settings.public_endpoints_save'), '', 'public-endpoints-save')}
            </form>
        </section>

        <section class="section" id="connection-mode-section" aria-labelledby="connection-mode-title">
            <h2 id="connection-mode-title">${_('settings.connection_mode_title')}</h2>
            <p class="section-note">${_('settings.connection_mode_desc')}</p>
            <form class="form-column" id="connection-mode-form" data-save-form novalidate>
                <div role="radiogroup" aria-label="${_('settings.connection_mode_label')}"><ul class="choice-list">
                    <li><label class="choice">
                        <input type="radio" name="connection-mode" value="p2p_first" id="conn-mode-p2p">
                        <span class="choice-title">${_('settings.general.conn_p2p')}</span>
                        <span class="choice-desc">${_('settings.ui.connection_p2p_hint')}</span>
                    </label></li>
                    <li><label class="choice">
                        <input type="radio" name="connection-mode" value="relay_only" id="conn-mode-relay">
                        <span class="choice-title">${_('settings.general.conn_relay')}</span>
                        <span class="choice-desc">${_('settings.ui.connection_relay_hint')}</span>
                    </label></li>
                </ul></div>
                <p class="form-hint" id="connection-mode-info">${_('settings.connection_mode_network_hint')}</p>
                <details class="disclosure connection-mode-advanced">
                    <summary>${_('settings.connection_mode_advanced')}</summary>
                    <div class="disclosure-body">
                        <div class="form-group">
                            <label class="form-label" for="conn-p2p-fallback-ms">${_('settings.connection_mode_fallback_ms')}</label>
                            <input type="number" id="conn-p2p-fallback-ms" class="form-input is-short" min="0" max="30000" step="100" value="2000">
                            <p class="form-hint">${_('settings.general.conn_fallback_hint')}</p>
                        </div>
                        <label class="check-field">
                            <input type="checkbox" id="conn-same-nat-relay" checked>
                            <span class="check-label">${_('settings.connection_mode_same_nat_relay')}</span>
                        </label>
                        <label class="check-field">
                            <input type="checkbox" id="conn-allow-shared-nat-initiator">
                            <span class="check-label">${_('settings.connection_mode_allow_shared_nat_initiator')}</span>
                            <span class="form-hint">${_('settings.connection_mode_allow_shared_nat_initiator_hint')}</span>
                        </label>
                        <label class="check-field">
                            <input type="checkbox" id="conn-logged-in-only-initiator">
                            <span class="check-label">${_('settings.connection_mode_logged_in_only_initiator')}</span>
                            <span class="form-hint">${_('settings.connection_mode_logged_in_only_initiator_hint')}</span>
                        </label>
                        <label class="check-field">
                            <input type="checkbox" id="conn-operator-only-outbound">
                            <span class="check-label">${_('settings.connection_mode_operator_only_outbound')}</span>
                            <span class="form-hint">${_('settings.connection_mode_operator_only_outbound_hint')}</span>
                        </label>
                    </div>
                </details>
                <p class="form-hint" id="connection-mode-runtime" hidden></p>
                <p class="form-hint" id="connection-mode-source"></p>
                <p class="field-effect is-restart">${_('settings.general.conn_effect')}</p>
                ${saveBar(_('settings.general.conn_save'), '', 'connection-mode-save')}
            </form>
        </section>

        <section class="section" id="device-scope-settings-panel" aria-labelledby="device-scope-title">
            <h2 id="device-scope-title">${_('settings.device_scope_title')}</h2>
            <p class="section-note">${_('settings.device_scope_desc')}</p>
            <form class="form-column" id="device-scope-form" data-save-form novalidate>
                <div role="radiogroup" aria-label="${_('settings.device_scope_title')}"><ul class="choice-list">
                    <li><label class="choice">
                        <input type="radio" name="device_scope_mode" value="open" id="device-scope-open">
                        <span class="choice-title">${_('settings.general.scope_open')}</span>
                        <span class="choice-desc">${_('settings.general.scope_open_desc')}</span>
                    </label></li>
                    <li><label class="choice">
                        <input type="radio" name="device_scope_mode" value="restricted" id="device-scope-restricted">
                        <span class="choice-title">${_('settings.general.scope_restricted')}</span>
                        <span class="choice-desc">${_('settings.general.scope_restricted_desc')}</span>
                    </label></li>
                </ul></div>
                <p class="notice warning" id="device-scope-warning" hidden>${_('settings.device_scope_restricted_warning')}</p>
                <p class="field-effect">${_('settings.general.scope_effect')}</p>
                ${saveBar(_('settings.device_scope_save'))}
            </form>
        </section>

        <section class="section" id="availability-history-settings-panel" aria-labelledby="availability-title">
            <h2 id="availability-title">${_('settings.availability_history_title')}</h2>
            <p class="section-note">${_('settings.availability_history_desc')}</p>
            <form class="form-column" id="availability-history-form" data-save-form novalidate>
                <label class="check-field">
                    <input type="checkbox" id="availability-history-enabled">
                    <span class="check-label">${_('settings.availability_history_enable')}</span>
                    <span class="form-hint">${_('settings.availability_history_enable_hint')}</span>
                </label>
                <div class="form-group">
                    <label class="form-label" for="availability-history-retention">${_('settings.availability_history_retention')}</label>
                    <input type="number" id="availability-history-retention" class="form-input is-short" min="1" max="3650" value="30">
                    <p class="form-hint">${_('settings.availability_history_retention_hint')}</p>
                </div>
                <p class="field-effect">${_('settings.general.availability_effect')}</p>
                ${saveBar(_('settings.availability_history_save'))}
            </form>
        </section>

        <section class="section" id="mesh-settings-panel" aria-labelledby="mesh-title">
            <h2 id="mesh-title">${_('mesh.settings_title')}</h2>
            <p class="section-note">${_('settings.general.mesh_note')}</p>
            <dl class="facts">
                <dt>${_('settings.general.mesh_status')}</dt><dd id="mesh-status-enabled">-</dd>
                <dt>${_('mesh.agents_online')}</dt><dd id="mesh-agents-online">-</dd>
                <dt>${_('mesh.server_id')}</dt>
                <dd><span class="value-field"><code id="mesh-server-id">-</code><button type="button" id="mesh-copy-server-id">${_('actions.copy')}</button></span></dd>
            </dl>
            <p class="notice warning hidden" id="mesh-cert-banner"></p>
            <div class="form-column">
                <div class="form-group">
                    <label class="form-label" for="mesh-msh-name">${_('mesh.mesh_name')}</label>
                    <input type="text" id="mesh-msh-name" class="form-input" value="BetterDesk Mesh">
                    <p class="form-hint">${_('mesh.onboarding_body')}</p>
                </div>
                <p><a class="btn" id="mesh-download-msh" href="/api/mesh/download.msh" download="meshagents.msh">${_('mesh.download_msh')}</a></p>
            </div>
            <ol class="steps">
                <li>${_('mesh.onboarding_step_msh')}</li>
                <li>${_('mesh.onboarding_step_install')}</li>
                <li>${_('mesh.onboarding_step_verify')}</li>
            </ol>

            <form class="form-column" id="mesh-groups-form" data-save-form novalidate>
                <h3>${_('mesh.groups_title')}</h3>
                <div id="mesh-groups-list" class="mesh-groups-list"></div>
                <div class="form-group">
                    <label class="form-label" for="mesh-group-id">${_('mesh.group_id_placeholder')}</label>
                    <input type="text" id="mesh-group-id" class="form-input is-medium">
                </div>
                <div class="form-group">
                    <label class="form-label" for="mesh-group-name">${_('mesh.group_name_placeholder')}</label>
                    <input type="text" id="mesh-group-name" class="form-input">
                </div>
                <p><button type="button" class="btn" id="mesh-group-add">${_('mesh.group_add')}</button></p>
                <p class="field-effect">${_('settings.general.mesh_groups_effect')}</p>
                ${saveBar(_('mesh.groups_save'), '', 'mesh-groups-save')}
            </form>

            <h3>${_('mesh.recordings_title')}</h3>
            <p class="section-note">${_('mesh.recordings_desc')}</p>
            <div id="mesh-recordings-table" class="mesh-recordings-table"><p class="state">${_('common.loading')}</p></div>
        </section>
        ` : ''}

        <section class="section" id="server-info" aria-labelledby="server-info-title">
            <h2 id="server-info-title">${_('settings.server_info')}</h2>
            <dl class="facts">
                <dt>${_('settings.version')}</dt><dd>v${appVersion}</dd>
                <dt>${_('settings.go_server_version')}</dt><dd id="go-server-version">-</dd>
                <dt>${_('settings.database')}</dt><dd id="db-path" class="mono-value">-</dd>
                <dt>${_('settings.uptime')}</dt><dd id="uptime">-</dd>
            </dl>
        </section>

        ${canAudit ? `<p class="settings-audit-link">${_('settings.general.audit_moved')} <a href="/security-audit">${_('settings.general.audit_link')}</a></p>` : ''}
    </div>

    <!-- ===================== Appearance ===================== -->
    <div class="settings-tab-content" ${panelAttrs('branding')} data-can-branding-edit="${canBrandingEdit ? '1' : '0'}">
        ${!canBrandingEdit ? `<p class="notice">${_('settings.appearance.read_only')}</p>` : ''}
        <nav aria-label="${_('settings.page.on_this_page')}">
            <ul class="toc" id="branding-toc">
                <li><a href="#branding-theme">${_('theme.title')}</a></li>
                <li data-toc-custom hidden><a href="#branding-custom-colors">${_('settings.appearance.custom_colors')}</a></li>
                <li><a href="#branding-identity">${_('settings.appearance.identity')}</a></li>
                <li><a href="#branding-fonts">${_('branding.typography_title')}</a></li>
                <li><a href="#branding-background">${_('settings.appearance.console_background')}</a></li>
                <li><a href="#branding-login">${_('branding.login_title')}</a></li>
                <li><a href="#branding-agent">${_('branding.agent_title')}</a></li>
                <li><a href="#branding-rdclient">${_('settings.appearance.rdclient')}</a></li>
                <li><a href="#branding-footer">${_('branding.footer_title')}</a></li>
                <li><a href="#branding-css">${_('branding.custom_css_title')}</a></li>
                ${canBrandingEdit ? `
                <li><a href="#branding-profiles">${_('settings.appearance.profiles')}</a></li>
                <li><a href="#branding-import-export">${_('branding.import_export_title')}</a></li>` : ''}
            </ul>
        </nav>

        <p class="notice warning" id="branding-readability-alert" hidden>
            <strong>${_('branding.readability_check')}:</strong> <span id="branding-readability-text"></span>
        </p>

        <form class="branding-form-root" id="branding-form" ${canBrandingEdit ? 'data-save-form' : ''} novalidate>
        <fieldset class="settings-fieldset" ${canBrandingEdit ? '' : 'disabled'}>
            <legend class="sr-only">${_('settings.tab_branding')}</legend>

            <section class="section form-column" id="branding-theme" aria-labelledby="branding-theme-title">
                <h2 id="branding-theme-title">${_('theme.title')}</h2>
                <p class="section-note">${_('settings.appearance.theme_note')}</p>
                <div role="radiogroup" aria-labelledby="branding-theme-title"><ul class="choice-list" id="theme-mode-selector">
                    <li><label class="choice"><input type="radio" name="theme-mode" value="system" checked>
                        <span class="choice-title">${_('theme.auto')}</span>
                        <span class="choice-desc">${_('settings.appearance.mode_system')}</span></label></li>
                    <li><label class="choice"><input type="radio" name="theme-mode" value="light">
                        <span class="choice-title">${_('theme.light')}</span>
                        <span class="choice-desc">${_('settings.appearance.mode_light')}</span></label></li>
                    <li><label class="choice"><input type="radio" name="theme-mode" value="dark">
                        <span class="choice-title">${_('theme.dark')}</span>
                        <span class="choice-desc">${_('settings.appearance.mode_dark')}</span></label></li>
                    <li><label class="choice"><input type="radio" name="theme-mode" value="custom">
                        <span class="choice-title">${_('theme.custom')}</span>
                        <span class="choice-desc">${_('settings.appearance.mode_custom')}</span></label></li>
                </ul></div>
                <p class="field-effect">${_('settings.appearance.save_effect')}</p>

                <div class="form-group" id="branding-builtin-themes">
                    <label class="form-label" for="branding-theme-select">${_('branding.builtin_themes')}</label>
                    <div class="settings-inline-controls">
                        <select id="branding-theme-select" class="form-select" data-save-ignore>
                            <option value="">${_('settings.appearance.pick_theme')}</option>
                        </select>
                        <button type="button" class="btn" id="branding-theme-apply">${_('settings.appearance.apply_theme')}</button>
                    </div>
                    <p class="form-hint">${_('settings.appearance.builtin_hint')}</p>
                    <p class="field-effect">${_('settings.appearance.builtin_effect')}</p>
                    <div id="branding-theme-gallery" hidden></div>
                </div>
            </section>

            <section class="section form-column" id="branding-custom-colors" aria-labelledby="branding-colors-title" hidden>
                <h2 id="branding-colors-title">${_('settings.appearance.custom_colors')}</h2>
                <p class="section-note">${_('settings.appearance.custom_colors_note')}</p>
                <div class="settings-inline-controls">
                    <button type="button" class="btn btn-sm" data-palette-start="light">${_('settings.appearance.start_light')}</button>
                    <button type="button" class="btn btn-sm" data-palette-start="dark">${_('settings.appearance.start_dark')}</button>
                </div>
                ${[
                    ['branding.colors_backgrounds', [
                        ['bgPrimary', 'color_bg', '#ffffff'], ['bgSecondary', 'color_bg_subtle', '#f3f4f4'],
                        ['bgTertiary', 'color_hover', '#e8ebeb'], ['bgElevated', 'color_float', '#ffffff']]],
                    ['branding.colors_text', [
                        ['textPrimary', 'color_text', '#1b1e1f'], ['textSecondary', 'color_text_muted', '#566064']]],
                    ['settings.appearance.colors_accents', [
                        ['accentBlue', 'color_accent', '#00677a'], ['accentGreen', 'color_success', '#1c7a3b'],
                        ['accentRed', 'color_danger', '#b3261e'], ['accentYellow', 'color_warning', '#875b00'],
                        ['accentPurple', 'color_info', '#4a5a62']]],
                    ['settings.appearance.colors_lines', [
                        ['borderPrimary', 'color_border', '#8c9699'], ['borderSecondary', 'color_rule', '#dde1e2']]]
                ].map(([groupKey, colors]) => `
                <fieldset class="settings-color-group">
                    <legend>${_(groupKey)}</legend>
                    ${colors.map(([key, labelKey, value]) => `
                    <div class="form-group">
                        <label class="form-label" for="color-${key}">${_('settings.appearance.' + labelKey)}</label>
                        <div class="color-field">
                            <input type="color" class="color-picker" data-color="${key}" value="${value}" aria-label="${_('settings.appearance.' + labelKey)}">
                            <input type="text" id="color-${key}" class="form-input color-hex" data-color="${key}" maxlength="7" spellcheck="false">
                        </div>
                    </div>`).join('')}
                </fieldset>`).join('')}
            </section>

            <section class="section form-column" id="branding-identity" aria-labelledby="branding-identity-title">
                <h2 id="branding-identity-title">${_('settings.appearance.identity')}</h2>
                <p class="section-note">${_('branding.identity_desc')}</p>
                <div class="form-group">
                    <label class="form-label" for="brand-name">${_('branding.app_name')}</label>
                    <input type="text" id="brand-name" class="form-input" maxlength="50" placeholder="BetterDesk">
