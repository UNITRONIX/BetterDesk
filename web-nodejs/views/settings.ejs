<%- include('layouts/main', {
    title: _('nav.settings'),
    pageStyles: ['pages'],
    pageScripts: ['branding-preview', 'settings'],
    currentPage: 'settings',
    breadcrumb: [{ label: _('nav.settings') }],
    body: `
        <div class="page-header">
            <h1 class="page-title">${_('settings.title')}</h1>
            <p class="page-subtitle">${_('settings.subtitle')}</p>
        </div>

        <div class="settings-shell">
            <nav class="settings-shell-nav" role="tablist" aria-label="${_('settings.title')}">
                <div class="settings-shell-nav-track mobile-tabs-scroll">
                <button type="button" class="settings-shell-tab settings-tab active" role="tab" aria-selected="true" id="settings-tab-general" data-tab="general" aria-controls="tab-general">
                    <span class="material-icons" aria-hidden="true">tune</span>
                    ${_('settings.tab_general')}
                </button>
                <button type="button" class="settings-shell-tab settings-tab" role="tab" aria-selected="false" id="settings-tab-branding" data-tab="branding" aria-controls="tab-branding">
                    <span class="material-icons" aria-hidden="true">palette</span>
                    ${_('settings.tab_branding')}
                </button>
                ${canServerConfig ? `<button type="button" class="settings-shell-tab settings-tab" role="tab" aria-selected="false" id="settings-tab-auth" data-tab="auth" aria-controls="tab-auth">
                    <span class="material-icons" aria-hidden="true">admin_panel_settings</span>
                    ${_('settings.tab_auth')}
                </button>
                <button type="button" class="settings-shell-tab settings-tab" role="tab" aria-selected="false" id="settings-tab-backup" data-tab="backup" aria-controls="tab-backup">
                    <span class="material-icons" aria-hidden="true">backup</span>
                    ${_('settings.tab_backup')}
                </button>
                <button type="button" class="settings-shell-tab settings-tab" role="tab" aria-selected="false" id="settings-tab-updates" data-tab="updates" aria-controls="tab-updates">
                    <span class="material-icons" aria-hidden="true">system_update</span>
                    ${_('updates.tab_title')}
                </button>
                <button type="button" class="settings-shell-tab settings-tab" role="tab" aria-selected="false" id="settings-tab-email" data-tab="email" aria-controls="tab-email">
                    <span class="material-icons" aria-hidden="true">email</span>
                    ${_('settings.tab_email')}
                </button>
                <button type="button" class="settings-shell-tab settings-tab" role="tab" aria-selected="false" id="settings-tab-advanced" data-tab="advanced" aria-controls="tab-advanced">
                    <span class="material-icons" aria-hidden="true">code</span>
                    ${_('settings.tab_advanced')}
                </button>` : ''}
                </div>
            </nav>

            <div class="settings-shell-main">
                <div class="settings-search" role="search">
                    <span class="material-icons" aria-hidden="true">search</span>
                    <input type="search" id="settings-search-input" class="form-input"
                           placeholder="${_('settings.ui.search_placeholder')}"
                           aria-controls="settings-search-status">
                    <button type="button" class="btn btn-ghost btn-sm" id="settings-search-clear" hidden>
                        <span class="material-icons" aria-hidden="true">close</span>
                        ${_('actions.clear')}
                    </button>
                </div>
                <div id="settings-search-status" class="settings-search-status" aria-live="polite" hidden></div>
        
        <!-- General Tab -->
        <div class="settings-tab-content active" id="tab-general" role="tabpanel" aria-labelledby="settings-tab-general">
        <div class="settings-stack">
            <!-- Password Change Section -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">lock</span>
                        ${_('settings.change_password')}
                    </h2>
                    <p class="settings-panel-desc">${_('settings.password_desc')}</p>
                </div>
                <div class="settings-panel-body">
                    <form class="settings-form" id="password-form">
                        <div class="form-group">
                            <label class="form-label" for="current-password">${_('settings.current_password')}</label>
                            <input type="password" id="current-password" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="new-password">${_('settings.new_password')}</label>
                            <input type="password" id="new-password" class="form-input" required minlength="8">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="confirm-password">${_('settings.confirm_password')}</label>
                            <input type="password" id="confirm-password" class="form-input" required>
                        </div>
                        
                        <div class="password-requirements">
                            <strong>${_('settings.password_requirements')}:</strong>
                            <ul role="list">
                                <li id="req-length">${_('settings.req_length')}</li>
                                <li id="req-uppercase">${_('settings.req_uppercase')}</li>
                                <li id="req-lowercase">${_('settings.req_lowercase')}</li>
                                <li id="req-number">${_('settings.req_number')}</li>
                            </ul>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            <span class="material-icons" aria-hidden="true">save</span>
                            ${_('settings.save_password')}
                        </button>
                    </form>
                </div>
            </div>
            
            <!-- Server Information Section -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">info</span>
                        ${_('settings.server_info')}
                    </h2>
                </div>
                <div class="settings-panel-body">
                    <div class="server-info-grid">
                        <div class="server-info-item">
                            <span class="server-info-label">
                                <span class="material-icons" aria-hidden="true">tag</span>
                                ${_('settings.version')}
                            </span>
                            <span class="server-info-value">v${appVersion}</span>
                        </div>
                        <div class="server-info-item">
                            <span class="server-info-label">
                                <span class="material-icons" aria-hidden="true">dns</span>
                                ${_('settings.go_server_version')}
                            </span>
                            <span class="server-info-value" id="go-server-version">-</span>
                        </div>
                        <div class="server-info-item">
                            <span class="server-info-label">
                                <span class="material-icons" aria-hidden="true">storage</span>
                                ${_('settings.database')}
                            </span>
                            <span class="server-info-value" id="db-path">-</span>
                        </div>
                        <div class="server-info-item">
                            <span class="server-info-label">
                                <span class="material-icons" aria-hidden="true">schedule</span>
                                ${_('settings.uptime')}
                            </span>
                            <span class="server-info-value" id="uptime">-</span>
                        </div>
                    </div>
                </div>
            </div>

            ${canServerConfig ? `
            <div class="settings-panel" id="device-scope-settings-panel">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">devices</span>
                        ${_('settings.device_scope_title')}
                    </h2>
                    <p class="settings-panel-desc">${_('settings.device_scope_desc')}</p>
                </div>
                <div class="settings-panel-body">
                    <form class="settings-form" id="device-scope-form">
                        <div class="form-group">
                            <label class="form-label">
                                <input type="radio" name="device_scope_mode" value="open" id="device-scope-open">
                                ${_('settings.device_scope_open')}
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="form-label">
                                <input type="radio" name="device_scope_mode" value="restricted" id="device-scope-restricted">
                                ${_('settings.device_scope_restricted')}
                            </label>
                        </div>
                        <p class="form-hint" id="device-scope-warning" hidden>${_('settings.device_scope_restricted_warning')}</p>
                        <button type="submit" class="btn btn-primary">
                            <span class="material-icons" aria-hidden="true">save</span>
                            ${_('settings.device_scope_save')}
                        </button>
                    </form>
                </div>
            </div>
            ` : ''}

            ${canServerConfig ? `
            <div class="settings-panel" id="mesh-settings-panel">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">hub</span>
                        ${_('mesh.settings_title')}
                    </h2>
                    <p class="settings-panel-desc">${_('mesh.settings_desc')}</p>
                </div>
                <div class="settings-panel-body">
                    <div class="server-info-grid">
                        <div class="server-info-item">
                            <span class="server-info-label">${_('mesh.enabled')}</span>
                            <span class="server-info-value" id="mesh-status-enabled">-</span>
                        </div>
                        <div class="server-info-item">
                            <span class="server-info-label">${_('mesh.agents_online')}</span>
                            <span class="server-info-value" id="mesh-agents-online">-</span>
                        </div>
                        <div class="server-info-item">
                            <span class="server-info-label">${_('mesh.server_id')}</span>
                            <span class="server-info-value"><code id="mesh-server-id">-</code></span>
                        </div>
                    </div>
                    <div class="form-group" style="margin-top:1rem;">
                        <label class="form-label" for="mesh-msh-name">${_('mesh.mesh_name')}</label>
                        <input type="text" id="mesh-msh-name" class="form-input" value="BetterDesk Mesh">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" id="mesh-copy-server-id">
                            <span class="material-icons" aria-hidden="true">content_copy</span>
                            ${_('mesh.copy_server_id')}
                        </button>
                        <a class="btn btn-primary" id="mesh-download-msh" href="/api/mesh/download.msh" download="meshagents.msh">
                            <span class="material-icons" aria-hidden="true">download</span>
                            ${_('mesh.download_msh')}
                        </a>
                    </div>
                    <p class="text-muted" style="margin-top:1rem;">${_('mesh.onboarding_body')}</p>
                    <div class="alert alert-warning mesh-cert-banner hidden" id="mesh-cert-banner"></div>
                    <ol class="mesh-onboarding-steps text-muted">
                        <li>${_('mesh.onboarding_step_msh')}</li>
                        <li>${_('mesh.onboarding_step_install')}</li>
                        <li>${_('mesh.onboarding_step_verify')}</li>
                    </ol>
                    <div class="settings-subsection" style="margin-top:1.5rem;">
                        <h3 class="settings-subsection-title">${_('mesh.groups_title')}</h3>
                        <div id="mesh-groups-list" class="mesh-groups-list"></div>
                        <div class="form-row" style="margin-top:8px;">
                            <input type="text" id="mesh-group-id" class="form-input" placeholder="${_('mesh.group_id_placeholder')}">
                            <input type="text" id="mesh-group-name" class="form-input" placeholder="${_('mesh.group_name_placeholder')}">
                            <button type="button" class="btn btn-secondary" id="mesh-group-add">${_('mesh.group_add')}</button>
                        </div>
                        <button type="button" class="btn btn-primary" id="mesh-groups-save" style="margin-top:8px;">${_('mesh.groups_save')}</button>
                    </div>
                    <div class="settings-subsection" style="margin-top:1.5rem;">
                        <h3 class="settings-subsection-title">${_('mesh.recordings_title')}</h3>
                        <p class="text-muted">${_('mesh.recordings_desc')}</p>
                        <div id="mesh-recordings-table" class="mesh-recordings-table"></div>
                    </div>
                </div>
            </div>
            <!-- Connection Strategy (P2P / Relay) -->
            <div class="settings-panel" id="connection-mode-section">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">swap_horiz</span>
                        ${_('settings.connection_mode_title')}
                    </h2>
                    <p class="settings-panel-desc">${_('settings.connection_mode_desc')}</p>
                </div>
                <div class="settings-panel-body">
                    <div class="alert alert-info" id="connection-mode-info">
                        <span class="material-icons" aria-hidden="true">info</span>
                        <span>${_('settings.connection_mode_network_hint')}</span>
                    </div>
                    <div class="settings-choice-grid" role="radiogroup" aria-label="${_('settings.connection_mode_label')}">
                        <label class="settings-choice-card">
                            <input type="radio" name="connection-mode" value="p2p_first" id="conn-mode-p2p">
                            <span class="settings-choice-card-inner">
                                <span class="material-icons settings-choice-card-icon" aria-hidden="true">swap_horiz</span>
                                <span class="settings-choice-card-title">${_('settings.connection_mode_p2p_first')}</span>
                                <span class="settings-choice-card-desc">${_('settings.ui.connection_p2p_hint')}</span>
                            </span>
                        </label>
                        <label class="settings-choice-card">
                            <input type="radio" name="connection-mode" value="relay_only" id="conn-mode-relay">
                            <span class="settings-choice-card-inner">
                                <span class="material-icons settings-choice-card-icon" aria-hidden="true">hub</span>
                                <span class="settings-choice-card-title">${_('settings.connection_mode_relay_only')}</span>
                                <span class="settings-choice-card-desc">${_('settings.ui.connection_relay_hint')}</span>
                            </span>
                        </label>
                    </div>
                    <details class="connection-mode-advanced">
                        <summary>${_('settings.connection_mode_advanced')}</summary>
                        <div class="form-row" style="margin-top:1rem;">
                            <div class="form-group">
                                <label class="form-label" for="conn-p2p-fallback-ms">${_('settings.connection_mode_fallback_ms')}</label>
                                <input type="number" id="conn-p2p-fallback-ms" class="form-input" min="0" max="30000" step="100" value="2000">
                            </div>
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="conn-same-nat-relay" checked>
                                    <span>${_('settings.connection_mode_same_nat_relay')}</span>
                                </label>
                            </div>
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="conn-allow-shared-nat-initiator">
                                    <span>${_('settings.connection_mode_allow_shared_nat_initiator')}</span>
                                </label>
                                <p class="form-hint">${_('settings.connection_mode_allow_shared_nat_initiator_hint')}</p>
                            </div>
                        </div>
                    </details>
                    <p class="text-muted" id="connection-mode-runtime" hidden></p>
                    <p class="text-muted" id="connection-mode-source"></p>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" id="connection-mode-save">
                            <span class="material-icons" aria-hidden="true">save</span>
                            ${_('settings.connection_mode_save')}
                        </button>
                        <button type="button" class="btn btn-warning" id="connection-mode-save-restart">
                            <span class="material-icons" aria-hidden="true">restart_alt</span>
                            ${_('settings.connection_mode_save_restart')}
                        </button>
                    </div>
                </div>
            </div>
            <div class="settings-panel" id="public-endpoints-section">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">public</span>
                        ${_('settings.public_endpoints_title')}
                    </h2>
                    <p class="settings-panel-desc">${_('settings.public_endpoints_desc')}</p>
                </div>
                <div class="settings-panel-body">
                    <div class="alert alert-info">
                        <span class="material-icons" aria-hidden="true">info</span>
                        <span>${_('settings.public_endpoints_hint')}</span>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="public-server-id">${_('settings.public_endpoints_server_id')}</label>
                            <input type="text" id="public-server-id" class="form-input"
                                   placeholder="${_('settings.public_endpoints_server_id_placeholder')}" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="public-relay-server">${_('settings.public_endpoints_relay')}</label>
                            <input type="text" id="public-relay-server" class="form-input"
                                   placeholder="${_('settings.public_endpoints_relay_placeholder')}" autocomplete="off">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="public-api-url">${_('settings.public_endpoints_api_url')}</label>
                        <input type="text" id="public-api-url" class="form-input"
                               placeholder="${_('settings.public_endpoints_api_url_placeholder')}" autocomplete="off">
                        <p class="text-muted form-hint">${_('settings.public_endpoints_api_url_hint')}</p>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" id="public-endpoints-save">
                            <span class="material-icons" aria-hidden="true">save</span>
                            ${_('settings.public_endpoints_save')}
                        </button>
                    </div>
                </div>
            </div>
            ` : ''}
            
            <!-- Two-Factor Authentication Section -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">security</span>
                        ${_('settings.totp_title')}
                    </h2>
                    <p class="settings-panel-desc">${_('settings.totp_desc')}</p>
                </div>
                <div class="settings-panel-body">
                    <div id="totp-status-container">
                        <div class="totp-status-loading">
                            <span class="material-icons spin" aria-hidden="true">sync</span>
                            ${_('common.loading')}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Audit Log Section -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <h2 class="settings-panel-title">
                        <span class="material-icons" aria-hidden="true">history</span>
                        ${_('settings.audit_log')}
                    </h2>
                    <p class="settings-panel-desc">${_('settings.audit_desc')}</p>
                </div>
                <div class="settings-panel-body">
                    <div class="audit-log-container">
                        <table class="audit-log-table">
                            <thead>
                                <tr>
                                    <th>${_('audit.time')}</th>
                                    <th>${_('audit.user')}</th>
                                    <th>${_('audit.action')}</th>
                                    <th>${_('audit.details')}</th>
                                </tr>
                            </thead>
                            <tbody id="audit-log-body">
                                <tr>
                                    <td colspan="4" class="text-center text-muted">
                                        ${_('common.loading')}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
        </div>
        </div>
        
        <!-- Branding Tab -->
        <div class="settings-tab-content" id="tab-branding" role="tabpanel" aria-labelledby="settings-tab-branding" data-can-branding-edit="${canBrandingEdit ? '1' : '0'}">
        <div class="branding-studio">
            <section class="branding-panel-hero branding-hero">
                <div class="branding-hero-copy">
                    <span class="branding-panel-hero-kicker branding-hero-kicker">${_('settings.tab_branding')}</span>
                    <h2>${_('branding.live_preview')}</h2>
                    <p>${_('branding.background_desc')}</p>
                    <div class="branding-panel-hero-steps branding-hero-steps">
                        <span><span class="material-icons" aria-hidden="true">palette</span>${_('branding.module_colors')}</span>
                        <span><span class="material-icons" aria-hidden="true">wallpaper</span>${_('branding.module_backgrounds')}</span>
                        <span><span class="material-icons" aria-hidden="true">connected_tv</span>${_('settings.ui.branding_rdclient')}</span>
                    </div>
                </div>
            </section>
            <div class="branding-studio-toolbar">
                <div class="branding-save-status" id="branding-save-status" aria-live="polite">
                    <span class="material-icons branding-status-icon" aria-hidden="true">check_circle</span>
                    <span id="branding-status-text">${_('branding.status_saved')}</span>
                </div>
                <div class="branding-toolbar-actions">
                    <button type="button" class="btn btn-ghost btn-sm" id="branding-revert-btn" title="${_('branding.revert_changes')}">
                        <span class="material-icons" aria-hidden="true">undo</span>
                        ${_('branding.revert_changes')}
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="branding-save-btn">
                        <span class="material-icons" aria-hidden="true">save</span>
                        ${_('branding.save_now')}
                    </button>
                </div>
            </div>

            <div class="branding-readability-alert" id="branding-readability-alert" hidden>
                <span class="material-icons" aria-hidden="true">visibility</span>
                <div>
                    <strong>Readability check</strong>
                    <p id="branding-readability-text"></p>
                </div>
            </div>

            <div class="branding-profiles-bar">
                <div class="branding-profiles-main">
                    <label class="form-label" for="branding-profile-select">${_('branding.profiles_label')}</label>
                    <select id="branding-profile-select" class="form-input form-select branding-profile-select"></select>
                    <button type="button" class="btn btn-secondary btn-sm" id="branding-profile-apply-btn">
                        <span class="material-icons" aria-hidden="true">play_arrow</span>
                        ${_('branding.profile_apply')}
                    </button>
                </div>
                <div class="branding-profiles-actions">
                    <button type="button" class="btn btn-ghost btn-sm" id="branding-profile-new-btn">
                        <span class="material-icons" aria-hidden="true">add</span>
                        ${_('branding.profile_new')}
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm" id="branding-profile-save-btn">
                        <span class="material-icons" aria-hidden="true">save_as</span>
                        ${_('branding.profile_save')}
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm" id="branding-profile-duplicate-btn">
                        <span class="material-icons" aria-hidden="true">content_copy</span>
                        ${_('branding.profile_duplicate')}
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm btn-danger-text" id="branding-profile-delete-btn">
                        <span class="material-icons" aria-hidden="true">delete</span>
                        ${_('branding.profile_delete')}
                    </button>
                </div>
            </div>

            <div class="branding-builtin-themes" id="branding-builtin-themes">
                <h3 class="branding-builtin-title">${_('branding.builtin_themes')}</h3>
                <p class="settings-row-hint">${_('branding.builtin_themes_hint') || 'Presets apply a full color pack (e.g. BetterDesk, insolv Core Server). They are separate from the quick light/dark toggle.'}</p>
                <div class="branding-theme-gallery" id="branding-theme-gallery"></div>
            </div>

            <div class="branding-studio-body">
                <nav class="branding-module-nav" id="branding-module-nav" aria-label="${_('branding.modules_nav')}">
                    <button type="button" class="branding-module-btn active" data-branding-module="identity">
                        <span class="material-icons" aria-hidden="true">badge</span>
                        ${_('branding.module_identity')}
                    </button>
                    <button type="button" class="branding-module-btn" data-branding-module="colors">
                        <span class="material-icons" aria-hidden="true">palette</span>
                        ${_('branding.module_colors')}
                    </button>
                    <button type="button" class="branding-module-btn" data-branding-module="typography">
                        <span class="material-icons" aria-hidden="true">text_format</span>
                        ${_('branding.module_typography')}
                    </button>
                    <button type="button" class="branding-module-btn" data-branding-module="backgrounds">
                        <span class="material-icons" aria-hidden="true">wallpaper</span>
                        ${_('branding.module_backgrounds')}
                    </button>
