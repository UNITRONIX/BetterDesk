<%- include('layouts/main', {
    title: _('nav.dataguard'),
    uiReworked: true,
    pageStyles: ['ui/dataguard'],
    pageScripts: ['dataguard'],
    currentPage: 'dataguard',
    breadcrumb: [{ label: _('nav.dataguard') }],
    body: `
    <div class="page dg-page">
        <div class="page-head">
            <h1>${_('nav.dataguard')}</h1>
            <div class="page-actions">
                <button type="button" class="btn btn-primary" id="create-policy-btn">${_('dataguard.create_policy')}</button>
            </div>
            <p class="page-description">${_('dataguard.page_description')}</p>
        </div>

        <div class="dg-views">
            <div class="tabs" role="tablist" aria-label="${_('dataguard.views_label')}">
                <button type="button" class="tab tab-btn active" role="tab" id="dg-tab-policies" data-tab="policies" aria-selected="true" aria-controls="tab-policies">${_('dataguard.tab_policies')}</button>
                <button type="button" class="tab tab-btn" role="tab" id="dg-tab-events" data-tab="events" aria-selected="false" aria-controls="tab-events" tabindex="-1">${_('dataguard.tab_events')}</button>
            </div>

            <section class="tab-panel section active" id="tab-policies" role="tabpanel" aria-labelledby="dg-tab-policies">
                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" id="policy-search" class="form-input" aria-label="${_('dataguard.search_policies')}" placeholder="${_('dataguard.search_policies')}">
                    </div>
                </div>
                <p class="count-line" id="dg-policy-count" aria-live="polite"></p>
                <div class="table-scroll" tabindex="0" role="region" aria-label="${_('dataguard.tab_policies')}">
                    <table class="data-table dg-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('dataguard.policy_name')}</th>
                                <th scope="col">${_('dataguard.transfer_type')}</th>
                                <th scope="col">${_('dataguard.action')}</th>
                                <th scope="col">${_('dataguard.scope')}</th>
                                <th scope="col">${_('dataguard.status')}</th>
                                <th scope="col" class="num-col">${_('dataguard.events_count')}</th>
                                <th scope="col" class="actions"><span class="sr-only">${_('common.actions')}</span></th>
                            </tr>
                        </thead>
                        <tbody id="policies-body">
                            <tr><td colspan="7" class="state-cell">${_('dataguard.loading_policies')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="tab-panel section" id="tab-events" role="tabpanel" aria-labelledby="dg-tab-events" hidden>
                <div class="toolbar">
                    <div class="toolbar-search search-wrapper">
                        <span class="material-icons" aria-hidden="true">search</span>
                        <input type="search" id="event-search" class="form-input" aria-label="${_('dataguard.search_events')}" placeholder="${_('dataguard.search_events')}">
                    </div>
                    <div class="toolbar-filters" id="event-action-filter" role="group" aria-label="${_('dataguard.action')}">
                        <button type="button" class="filter-btn active" data-action="" aria-pressed="true">${_('common.all')}</button>
                        <button type="button" class="filter-btn" data-action="block" aria-pressed="false">${_('dataguard.action_block')}</button>
                        <button type="button" class="filter-btn" data-action="log" aria-pressed="false">${_('dataguard.action_log')}</button>
                        <button type="button" class="filter-btn" data-action="allow" aria-pressed="false">${_('dataguard.action_allow')}</button>
                    </div>
                </div>
                <p class="count-line" id="dg-event-count" aria-live="polite"></p>
                <div class="table-scroll" tabindex="0" role="region" aria-label="${_('dataguard.tab_events')}">
                    <table class="data-table dg-table">
                        <thead>
                            <tr>
                                <th scope="col">${_('dataguard.event_time')}</th>
                                <th scope="col">${_('dataguard.device')}</th>
                                <th scope="col">${_('dataguard.policy')}</th>
                                <th scope="col">${_('dataguard.action')}</th>
                                <th scope="col">${_('dataguard.detail')}</th>
                            </tr>
                        </thead>
                        <tbody id="events-body">
                            <tr><td colspan="5" class="state-cell">${_('dataguard.loading_events')}</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <template id="policy-form-template">
            <form class="dg-form" id="policy-form" novalidate>
                <input type="hidden" id="policy-id">
                <div class="form-group">
                    <label class="form-label" for="policy-name">${_('dataguard.policy_name')}</label>
                    <input type="text" id="policy-name" class="form-input" required autocomplete="off">
                </div>
                <div class="form-group">
                    <label class="form-label" for="policy-desc">${_('dataguard.policy_desc')}</label>
                    <textarea id="policy-desc" class="form-input" rows="2"></textarea>
                    <p class="form-hint">${_('dataguard.desc_hint')}</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="policy-type">${_('dataguard.transfer_type')}</label>
                    <select id="policy-type" class="form-select">
                        <option value="usb">${_('dataguard.type_usb')}</option>
                        <option value="file_type">${_('dataguard.type_file_type')}</option>
                        <option value="clipboard">${_('dataguard.type_clipboard')}</option>
                        <option value="screen_share">${_('dataguard.type_screen_share')}</option>
                        <option value="file_transfer">${_('dataguard.type_file_transfer')}</option>
                    </select>
                    <p class="form-hint">${_('dataguard.type_hint')}</p>
                </div>
                <fieldset class="form-group dg-fieldset">
                    <legend class="form-label">${_('dataguard.action')}</legend>
                    <ul class="choice-list" id="policy-action">
                        <li><label class="choice"><input type="radio" name="policy-action" value="block"><span class="choice-title">${_('dataguard.action_block')}</span>
                            <span class="choice-desc">${_('dataguard.action_block_desc')}</span></label></li>
                        <li><label class="choice"><input type="radio" name="policy-action" value="log"><span class="choice-title">${_('dataguard.action_log')}</span>
                            <span class="choice-desc">${_('dataguard.action_log_desc')}</span></label></li>
                        <li><label class="choice"><input type="radio" name="policy-action" value="allow"><span class="choice-title">${_('dataguard.action_allow')}</span>
                            <span class="choice-desc">${_('dataguard.action_allow_desc')}</span></label></li>
                    </ul>
                </fieldset>
                <div class="form-group">
                    <label class="form-label" for="policy-scope">${_('dataguard.scope')}</label>
                    <input type="text" id="policy-scope" class="form-input" autocomplete="off" aria-describedby="policy-scope-hint">
                    <p class="form-hint" id="policy-scope-hint">${_('dataguard.scope_help')}</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="policy-rules">${_('dataguard.rules')}</label>
                    <textarea id="policy-rules" class="form-input dg-rules" rows="4" spellcheck="false" aria-describedby="policy-rules-hint"></textarea>
                    <p class="form-hint" id="policy-rules-hint">${_('dataguard.rules_hint')}</p>
                </div>
                <label class="check-field">
                    <input type="checkbox" id="policy-enabled" checked>
                    <span class="check-label">${_('dataguard.enabled')}</span>
                    <span class="field-effect">${_('dataguard.enabled_effect')}</span>
                </label>
                <p class="form-status is-error" id="policy-form-status" role="alert"></p>
            </form>
        </template>
    </div>
    `
}) %>
